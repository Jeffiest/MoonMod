{
  "schema_version": 1,
  "id": "moonmod.ascension",
  "name": "Ascension",
  "version": "1.6.0",
  "author": "Jeffiest",
  "description": "Character progression, skill trees, weapon mastery, enemy scaling, champions, and level-up rewards.",
  "framework_api": 1,
  "games": [
    "chronicle"
  ],
  "entry": "main.lua",
  "optional_dependencies": [
    "moonmod.dungeon-plus"
  ],
  "permissions": [
    "game.read",
    "game.write",
    "content.register",
    "storage.read",
    "storage.write"
  ],
  "settings": [
