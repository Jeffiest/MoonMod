      "type": "integer",
      "default": 40,
      "min": 1,
      "max": 100,
      "step": 1
    },
    {
      "id": "skill_points_per_level",
      "name": "Skill points per level",
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 5,
      "step": 1
    },
    {
      "id": "skill_bonus_points_every_5",
      "name": "Bonus skill points every 5 levels",
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 5,
      "step": 1
    },
    {
      "id": "focus_regen_per_second",
