{
  "schema_version": 1,
  "id": "moonmod.ascension",
  "name": "Ascension",
  "version": "1.3.0",
  "author": "Jeffiest",
  "description": "Character progression, skill trees, weapon mastery, combat passives, and level-up rewards.",
  "framework_api": 1,
  "games": [
    "chronicle"
  ],
  "entry": "main.lua",
  "permissions": [
    "game.read",
    "game.write",
    "content.register",
    "storage.read",
    "storage.write"
  ],
  "settings": [
    {
      "id": "rooms_per_level",
      "name": "Room count bonus per level (%)",
      "type": "integer",
      "default": 10,
      "min": 0,
      "max": 50,
      "step": 5
    },
    {
      "id": "monsters_per_level",
      "name": "Monster count bonus per level (%)",
      "type": "integer",
      "default": 10,
      "min": 0,
      "max": 50,
      "step": 5
    },
    {
      "id": "chests_per_level",
      "name": "Chest count bonus per level (%)",
      "type": "integer",
      "default": 10,
      "min": 0,
      "max": 50,
      "step": 5
    },
    {
      "id": "chest_value_per_level",
      "name": "Chest value bonus per level (%)",
      "type": "integer",
      "default": 10,
      "min": 0,
      "max": 50,
      "step": 5
    },
    {
      "id": "floor_bonus_cap",
      "name": "Maximum floor bonus (%)",
      "type": "integer",
      "default": 100,
      "min": 0,
      "max": 300,
      "step": 10
    },
    {
      "id": "mastery_damage_per_rank",
      "name": "Weapon mastery damage per rank (%)",
      "type": "integer",
      "default": 2,
      "min": 0,
      "max": 10,
      "step": 1
    }
  ]
}

