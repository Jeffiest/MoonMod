{
  "schema_version": 1,
  "id": "moonmod.dungeon-plus",
  "name": "Dungeon+",
  "version": "2.1.0",
  "author": "Jeffiest",
  "description": "Champions with themed loot. Replay floors at Tiers 1-5 (Square/Triangle on the floor list), floor mutators, a bounty on every floor, kill streaks, a bestiary and trophies (Journal), enemies that get back up, and the DarkCloud-Expanded weapon, price and shop data.",
  "framework_api": 1,
  "games": [
    "chronicle"
  ],
  "entry": "main.lua",
  "permissions": [
    "game.read",
    "game.write",
    "content.register",
    "storage.read",
    "storage.write"
  ],
  "settings": [
    {
      "id": "difficulty_preset",
      "name": "Difficulty preset",
      "type": "choice",
      "default": "normal",
      "choices": [
        "relaxed",
        "normal",
        "hardcore"
      ]
    },
    {
      "id": "champion_chance",
      "name": "Champion chance per enemy (%)",
      "type": "integer",
      "default": 8,
      "min": 0,
      "max": 50,
      "step": 1
    },
    {
      "id": "mutator_chance",
      "name": "Floor mutator chance (%)",
      "type": "integer",
      "default": 35,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "id": "tier_hp_percent",
      "name": "Enemy HP per tier (%)",
      "type": "integer",
      "default": 35,
      "min": 0,
      "max": 200,
      "step": 5
    },
    {
      "id": "tier_defense",
      "name": "Enemy defense per tier",
      "type": "integer",
      "default": 2,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "tier_gilda_percent",
      "name": "Enemy Gilda per tier (%)",
      "type": "integer",
      "default": 40,
      "min": 0,
      "max": 300,
      "step": 10
    },
    {
      "id": "bounty_kills",
      "name": "Kills needed for a floor bounty",
      "type": "integer",
      "default": 6,
      "min": 1,
      "max": 20,
      "step": 1
    },
    {
      "id": "bounty_reward_percent",
      "name": "Floor bounty reward (%)",
      "type": "integer",
      "default": 100,
      "min": 0,
      "max": 300,
      "step": 10
    },
    {
      "id": "feats_reward_scale",
      "name": "Dungeon Feats reward scale (%)",
      "type": "integer",
      "default": 100,
      "min": 0,
      "max": 300,
      "step": 25
    },
    {
      "id": "enemy_base_speed_percent",
      "name": "Enemy base speed (%)",
      "type": "integer",
      "default": 100,
      "min": 60,
      "max": 200,
      "step": 5
    },
    {
      "id": "enemy_speed_variance",
      "name": "Enemy speed variance (%)",
      "type": "integer",
      "default": 25,
      "min": 0,
      "max": 50,
      "step": 5
    },
    {
      "id": "monsters_per_room_min",
      "name": "Min monsters / room (%)",
      "type": "integer",
      "default": 150,
      "min": 0,
      "max": 300,
      "step": 25
    },
    {
      "id": "monsters_per_room_max",
      "name": "Max monsters / room (%)",
      "type": "integer",
      "default": 300,
      "min": 0,
      "max": 300,
      "step": 25
    },
    {
      "id": "chests_per_room_min",
      "name": "Min chests / room (%)",
      "type": "integer",
      "default": 75,
      "min": 0,
      "max": 150,
      "step": 25
    },
    {
      "id": "chests_per_room_max",
      "name": "Max chests / room (%)",
      "type": "integer",
      "default": 150,
      "min": 0,
      "max": 150,
      "step": 25
    },
    {
      "id": "enemy_revive_chance",
      "name": "Enemy get-back-up chance (%)",
      "type": "integer",
      "default": 25,
      "min": 0,
      "max": 100,
      "step": 5
    }
  ]
}