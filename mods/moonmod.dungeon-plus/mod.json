{
  "schema_version": 1,
  "id": "moonmod.dungeon-plus",
  "name": "Dungeon+",
  "version": "1.2.0",
  "author": "Jeffiest",
  "description": "Per-floor difficulty, mutators, enemy speed variety, bestiary, bounties, feats, rewards, and legacy shop rebalance.",
  "framework_api": 1,
  "games": [
    "chronicle"
  ],
  "entry": "main.lua",
  "permissions": [
    "game.read",
    "game.write",
    "content.register",
    "storage.read",
    "storage.write"
  ],
  "settings": [
    {
      "id": "mutator_chance",
      "name": "Floor mutator chance (%)",
      "type": "integer",
      "default": 35,
      "min": 0,
      "max": 100,
      "step": 5
    },
    {
      "id": "bounty_kills",
      "name": "Kills needed for a floor bounty",
      "type": "integer",
      "default": 6,
      "min": 1,
      "max": 20,
      "step": 1
    },
    {
      "id": "bounty_reward_percent",
      "name": "Floor bounty reward (%)",
      "type": "integer",
      "default": 100,
      "min": 0,
      "max": 300,
      "step": 10
    },
    {
      "id": "enemy_speed_variance",
      "name": "Enemy speed variance (%)",
      "type": "integer",
      "default": 25,
      "min": 0,
      "max": 50,
      "step": 5
    }
  ]
}

