+// The headset's Touch controllers as pad 0, laid out so one hand plays it all: the stick walks,
+// the trigger attacks and talks (Cross), A or X cancels (Circle), B or Y opens the menu (Triangle),
+// the grip guards and locks on (R1), the stick pressed in is Square, and A with B together, or the
+// left menu button, is Start.
+void HeadsetPad() {
+    const gfx::xr::Controls controls = gfx::xr::ReadControls();
+    if (!controls.active) {
+        InputSetHeadsetPad(nullptr);
+        return;
+    }
+    InputPadState pad;
+    pad.connected = true;
+    const bool start = controls.menu || (controls.lower && controls.upper);
+    if (controls.trigger) pad.buttons |= kInputCross;
+    if (controls.lower && !start) pad.buttons |= kInputCircle;
+    if (controls.upper && !start) pad.buttons |= kInputTriangle;
+    if (controls.grip) pad.buttons |= kInputR1;
+    if (controls.stick) pad.buttons |= kInputSquare;
+    if (start) pad.buttons |= kInputStart;
+    // A flick straight sideways turns the body 45 degrees, once per flick; the stick then walks
+    // nowhere until it comes back to the middle.
+    static bool flicked = false;
+    float       x = controls.stick_x;
+    float       y = controls.stick_y;
+    if (!flicked && std::fabs(x) > 0.9f && std::fabs(y) < 0.35f) {
+        dc::game::VrSnapTurn(x > 0.0f ? -0.785398f : 0.785398f);
+        flicked = true;
+    }
+    if (flicked) {
+        if (std::fabs(x) < 0.3f && std::fabs(y) < 0.3f) {
+            flicked = false;
+        }
+        x = y = 0.0f;
+    }
+    // The game turns the stick to walk where the head looks (VrWalkAngle).
+    pad.left_x = InputStickByte(x);
+    pad.left_y = InputStickByte(-y);
+    InputSetHeadsetPad(&pad);
+}
+
