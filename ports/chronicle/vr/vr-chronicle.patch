+#pragma once
+
+#include <libvu0.h>
+
+#include "camera.hpp"
+
+namespace dc::game {
+
+/**
+ * @file
+ * The view a VR headset stands in: the player's own eyes.
+ *
+ * For comfort the view never turns unless the player turns: the body keeps its facing while the
+ * game's camera swings about, and changes it only by a snap turn, or by a snap to face whoever a
+ * scene is about. The stick walks where the head looks (VrStickTurn).
+ */
+
+/** Whether the game is playing on a headset. */
+bool VrPlaying();
+
+/** How the view is facing. */
+enum class VrFacing {
+    Body,    /**< The body's own facing: playing and menus. */
+    Subject, /**< Turned once to face what the scene's camera looks at: talks and scenes. */
+    Camera,  /**< The game camera's own place and facing, level: a scene the player is not in. */
+};
+
+/**
+ * Makes the camera matrix and eye of the headset's view, standing at head (the camera's place for
+ * VrFacing::Camera), level. The headset adds the head's own turn on top. Leaves matrix and eye
+ * alone when the camera gives no way to face.
+ */
+void VrEyeView(const CCamera &camera, const float *head, VrFacing facing, sceVu0FMATRIX matrix, float *eye);
+
+/** Marks this frame's view as a film (the opening, a movie, the title): on a headset it plays on the
+ * still cinema screen. Call it each frame the film's view is set. */
+void VrCinema();
+
+/** Turns the body by radians at the next view (positive turns left). */
+void VrSnapTurn(float radians);
+
+/**
+ * The angle to turn the stick by, in radians, so it walks where the head looks: the head's facing
+ * less the facing of the game camera the game walks by.
+ */
+float VrStickTurn();
+
+/**
+ * The angle the game turns the walking stick by: the game camera's (camera_angle, from
+ * CCamera::GetAngleH), or in first person on a headset that made the head's facing, so the stick
+ * walks where the player looks whatever pad it comes from.
+ */
+float VrWalkAngle(float camera_angle);
+
+/**
+ * Snap-turns the body on a flick of the right stick (rx, -1 to 1) straight sideways, once per flick.
+ * Call once a frame where the game reads it for walking; does nothing off a headset.
+ */
+void VrTurnStick(float rx, float ry);
+
+} // namespace dc::game
