+#include "vr_view.hpp"
+
+#include <atomic>
+#include <algorithm>
+#include <cmath>
+
+#include "gfx/xr.hpp"
+
+namespace dc::game {
+
+namespace {
+
+constexpr float kPi = 3.14159265f;
+// A scene's subject further round than this from where the body faces turns the body again.
+constexpr float kSubjectSnap = 1.0f;
+// One snap turn: 45 degrees.
+constexpr float kSnapTurn = 0.785398f;
+
+// Facings are yaws about the up axis, atan2(x, z) of a world direction; positive turns left.
+bool               g_body_set = false;
+float              g_body_yaw = 0.0f;
+VrFacing           g_last_facing = VrFacing::Body;
+std::atomic<float> g_pending_turn = 0.0f;
+// What the stick turn is made from, kept at each view for the input thread.
+std::atomic<float> g_view_yaw = 0.0f;
+std::atomic<float> g_camera_yaw = 0.0f;
+
+float Wrap(float angle) {
+    while (angle > kPi) angle -= 2.0f * kPi;
+    while (angle < -kPi) angle += 2.0f * kPi;
+    return angle;
+}
+
+// Comfort: the view moving or turning while the head keeps still darkens the edges of sight, the
+// more the faster, up to walking pace (units a frame) or a slow pan (radians a frame). Bigger
+// jumps are cuts and snap turns, which do not unsettle.
+constexpr float kWalkPace = 1.45f;
+constexpr float kPanPace = 0.04f;
+constexpr float kCutDistance = 20.0f;
+constexpr float kCutTurn = 0.5f;
+bool            g_comfort_set = false;
+float           g_last_stand[3] = {};
+float           g_last_yaw = 0.0f;
+
+void Comfort(const float *stand, float yaw) {
+    float strength = 0.0f;
+    if (g_comfort_set) {
+        const float dx = stand[0] - g_last_stand[0];
+        const float dy = stand[1] - g_last_stand[1];
+        const float dz = stand[2] - g_last_stand[2];
+        const float moved = std::sqrt(dx * dx + dy * dy + dz * dz);
+        const float turned = std::fabs(Wrap(yaw - g_last_yaw));
+        if (moved < kCutDistance) {
+            strength = std::max(strength, moved / kWalkPace);
+        }
+        if (turned < kCutTurn) {
+            strength = std::max(strength, turned / kPanPace);
+        }
+    }
+    g_comfort_set = true;
+    std::copy(stand, stand + 3, g_last_stand);
+    g_last_yaw = yaw;
+    gfx::xr::SetVignette(std::min(strength, 1.0f) * 0.8f);
+}
+
+} // namespace
+
+bool VrPlaying() { return gfx::xr::Running(); }
+
+void VrEyeView(const CCamera &camera, const float *head, VrFacing facing, sceVu0FMATRIX matrix, float *eye) {
+    const float look_x = camera.ref[0] - camera.pos[0];
+    const float look_z = camera.ref[2] - camera.pos[2];
+    if (std::sqrt(look_x * look_x + look_z * look_z) < 1e-3f) {
+        return;
+    }
+    const float camera_yaw = std::atan2(look_x, look_z);
+    // Coming back from a scene seen through its camera, the body faces the way that camera did.
+    if (!g_body_set || (g_last_facing == VrFacing::Camera && facing != VrFacing::Camera)) {
+        g_body_yaw = camera_yaw;
+        g_body_set = true;
+    }
+    if (facing == VrFacing::Subject) {
+        // The subject, unless it stands at the player's own feet: then the camera's way.
+        const float to_x = camera.ref[0] - head[0];
+        const float to_z = camera.ref[2] - head[2];
+        const float subject = std::sqrt(to_x * to_x + to_z * to_z) > 8.0f ? std::atan2(to_x, to_z) : camera_yaw;
+        if (g_last_facing != VrFacing::Subject || std::fabs(Wrap(subject - g_body_yaw)) > kSubjectSnap) {
+            g_body_yaw = subject;
+        }
+    }
+    g_body_yaw = Wrap(g_body_yaw + g_pending_turn.exchange(0.0f));
+    g_last_facing = facing;
+
+    const float yaw = facing == VrFacing::Camera ? camera_yaw : g_body_yaw;
+    g_view_yaw = yaw;
+    g_camera_yaw = camera_yaw;
+    // A scene through the game's moving camera plays on a still screen, as the game draws it: a
+    // camera flying about the player's head is what sickens most.
+    gfx::xr::SetCinema(facing == VrFacing::Camera);
+    if (facing == VrFacing::Camera) {
+        gfx::xr::SetVignette(0.0f);
+        g_comfort_set = false;
+        return;
+    }
+    const float *stand = facing == VrFacing::Camera ? camera.pos : head;
+    CCamera      view = camera;
+    view.SetPos(const_cast<float *>(stand));
+    view.SetRef(stand[0] + std::sin(yaw) * 10.0f, stand[1], stand[2] + std::cos(yaw) * 10.0f);
+    view.SetRoll(0.0f);
+    view.GetCameraMatrix(matrix);
+    sceVu0CopyVector(eye, const_cast<float *>(stand));
+    Comfort(stand, yaw);
+}
+
+void VrCinema() {
+    if (VrPlaying()) {
+        gfx::xr::SetCinema(true);
+        gfx::xr::SetVignette(0.0f);
+    }
+}
+
+void VrSnapTurn(float radians) { g_pending_turn = g_pending_turn + radians; }
+
+float VrStickTurn() { return Wrap(g_view_yaw + gfx::xr::HeadYaw() - g_camera_yaw); }
+
+float VrWalkAngle(float camera_angle) {
+    if (!VrPlaying() || g_last_facing == VrFacing::Camera) {
+        return camera_angle;
+    }
+    return camera_angle + VrStickTurn();
+}
+
+void VrTurnStick(float rx, float ry) {
+    static bool flicked = false;
+    if (!VrPlaying()) {
+        flicked = false;
+        return;
+    }
+    if (!flicked && std::fabs(rx) > 0.9f && std::fabs(ry) < 0.35f) {
+        VrSnapTurn(rx > 0.0f ? -kSnapTurn : kSnapTurn);
+        flicked = true;
+    } else if (flicked && std::fabs(rx) < 0.3f && std::fabs(ry) < 0.3f) {
+        flicked = false;
+    }
+}
+
+} // namespace dc::game
