+// DC_VR_DEBUG_EYE="x[,y[,z]]": every presented frame shows the world from that far over in the
+// camera's own space (a VR eye's offset), so the per-eye replay can be seen without a headset.
+// It is read once; with it set, frames are display renders even with interpolation off.
+const gfx::EyeView *DebugEye() {
+    static const std::optional<gfx::EyeView> eye = []() -> std::optional<gfx::EyeView> {
+        const char *value = std::getenv("DC_VR_DEBUG_EYE");
+        float       offset[3] = {};
+        if (value == nullptr || std::sscanf(value, "%f,%f,%f", &offset[0], &offset[1], &offset[2]) < 1) {
+            return std::nullopt;
+        }
+        gfx::EyeView view = {};
+        view.view[0] = view.view[5] = view.view[10] = view.view[15] = 1.0f;
+        // The eye stands at +offset, so the world moves the other way.
+        for (int k = 0; k < 3; k++) {
+            view.view[12 + k] = -offset[k];
+        }
+        return view;
+    }();
+    return eye ? &*eye : nullptr;
+}
+
+// One headset frame: the tick replayed for each eye, at the pace xr::BeginFrame waits for. False
+// when the headset is not running, so the window's own presenting goes on as usual.
+bool HeadsetFrame(const gfx::DisplayList &list, const gfx::DisplayList *previous, float alpha) {
+    gfx::xr::Frame frame;
+    if (!gfx::xr::BeginFrame(frame)) {
+        return false;
+    }
+    if (frame.render && frame.cinema) {
+        // A scene through the game's camera: the flat frame, for the still screen.
+        if (gfx::RenderList(list, alpha, {.previous = previous})) {
+            gfx::xr::SubmitCinema(frame);
+        }
+    } else if (frame.render) {
+        for (int eye = 0; eye < 2; eye++) {
+            if (gfx::RenderList(list, alpha, {.previous = previous, .eye = &frame.eyes[eye]})) {
+                gfx::xr::SubmitEye(frame, eye);
+            }
+        }
+    }
+    gfx::xr::EndFrame(frame);
+    return true;
+}
