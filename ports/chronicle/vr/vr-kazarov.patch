+void Recenter() { g_xr.recenter = true; }
+
+bool BeginFrame(Frame &frame) {
+    frame = {};
+    if (!g_xr.enabled || g_xr.session == XR_NULL_HANDLE) {
+        return false;
+    }
+    PollEvents();
+    if (!g_xr.running) {
+        return false;
+    }
+    XrFrameState state = {XR_TYPE_FRAME_STATE};
+    Trace("wait");
+    if (!Ok(xrWaitFrame(g_xr.session, nullptr, &state), "xrWaitFrame")) {
+        return false;
+    }
+    SyncControls();
+    Trace(state.shouldRender ? "begin (should render)" : "begin (no render)");
+    bool begun = false;
+    RunOnRenderThread([&] { begun = Ok(xrBeginFrame(g_xr.session, nullptr), "xrBeginFrame"); });
+    if (!begun) {
+        return false;
+    }
+    frame.begun = true;
+    g_xr.display_time = state.predictedDisplayTime;
+    if (!state.shouldRender) {
+        return true;
+    }
+
+    XrSpaceLocation head = {XR_TYPE_SPACE_LOCATION};
+    const bool head_valid = XR_SUCCEEDED(xrLocateSpace(g_xr.head, g_xr.space, state.predictedDisplayTime, &head)) &&
+                            (head.locationFlags & XR_SPACE_LOCATION_ORIENTATION_VALID_BIT) != 0 &&
+                            (head.locationFlags & XR_SPACE_LOCATION_POSITION_VALID_BIT) != 0;
+    if (g_xr.recenter && head_valid) {
+        g_xr.home = YawOnly(head.pose);
+        g_xr.recenter = false;
+        g_xr.screen_placed = false;
+        g_xr.cinema_placed = false;
+    }
+    // A scene through the game's camera: its screen stands ahead of where the head faced as it began.
+    frame.cinema = g_xr.cinema.handle != XR_NULL_HANDLE && Fresh(g_cinema_set_ms);
+    if (!frame.cinema) {
+        g_xr.cinema_placed = false;
+    } else if (!g_xr.cinema_placed && head_valid) {
+        const XrPosef level = YawOnly(head.pose);
+        const float   yaw = Yaw(level.orientation);
+        g_xr.cinema_pose = level;
+        g_xr.cinema_pose.position.x -= std::sin(yaw) * kCinemaDistance;
+        g_xr.cinema_pose.position.z -= std::cos(yaw) * kCinemaDistance;
+        g_xr.cinema_placed = true;
+    }
+
+    XrViewLocateInfo locate = {XR_TYPE_VIEW_LOCATE_INFO};
+    locate.viewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
+    locate.displayTime = state.predictedDisplayTime;
+    locate.space = g_xr.space;
+    XrViewState view_state = {XR_TYPE_VIEW_STATE};
+    uint32_t    count = 0;
+    g_xr.views = {{{XR_TYPE_VIEW}, {XR_TYPE_VIEW}}};
+    if (!Ok(xrLocateViews(g_xr.session, &locate, &view_state, 2, &count, g_xr.views.data()), "xrLocateViews") ||
+        count != 2 || (view_state.viewStateFlags & XR_VIEW_STATE_ORIENTATION_VALID_BIT) == 0) {
+        return true;
+    }
+    const float   fake = FakeYaw();
+    const XrPosef from_home =
+        Multiply({{0, std::sin(fake / 2), 0, std::cos(fake / 2)}, {0, 0, 0}}, Inverse(g_xr.home));
+    const XrPosef head_home = head_valid ? Multiply(from_home, head.pose) : XrPosef{{0, 0, 0, 1}, {0, 0, 0}};
+    TurnScreen(head_home);
+    g_head_yaw = Yaw(head_home.orientation);
+    for (int i = 0; i < 2; i++) {
+        const XrView &view = g_xr.views[i];
+        const XrPosef pose = Multiply(from_home, view.pose);
+        EyeView      &eye = frame.eyes[i];
+        eye.headset = true;
+        eye.orientation[0] = pose.orientation.x;
+        eye.orientation[1] = pose.orientation.y;
+        eye.orientation[2] = pose.orientation.z;
+        eye.orientation[3] = pose.orientation.w;
+        eye.position[0] = pose.position.x;
+        eye.position[1] = pose.position.y;
+        eye.position[2] = pose.position.z;
+        eye.tangents[0] = std::tan(view.fov.angleLeft);
+        eye.tangents[1] = std::tan(view.fov.angleRight);
+        eye.tangents[2] = std::tan(view.fov.angleUp);
+        eye.tangents[3] = std::tan(view.fov.angleDown);
+        eye.units_per_metre = g_xr.units_per_metre;
+        eye.has_ui = true;
+        ScreenToEye(head_home, pose, view.fov, eye.ui);
+    }
+    frame.render = true;
+    {
+        std::scoped_lock lock(g_capture_mutex);
+        g_capturing = std::move(g_capture_stem);
+        g_capture_stem.clear();
+    }
+    return true;
+}
+
+// Copies the display image into the chain's next image; a capture writes it to <stem><suffix>.
+bool CopyToChain(EyeChain &eye, const char *capture_suffix) {
+    bool done = false;
+    RunOnRenderThread([&] {
+        uint32_t                    slot = 0;
+        XrSwapchainImageAcquireInfo acquire = {XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+        if (!Ok(xrAcquireSwapchainImage(eye.handle, &acquire, &slot), "xrAcquireSwapchainImage")) {
+            return;
+        }
+        XrSwapchainImageWaitInfo wait = {XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+        wait.timeout = XR_INFINITE_DURATION;
+        if (Ok(xrWaitSwapchainImage(eye.handle, &wait), "xrWaitSwapchainImage")) {
+            // The runtime's image, wrapped for Transition; its layout between frames is the runtime's.
+            Trace("eye acquired");
+            if (!g_capturing.empty()) {
+                std::vector<uint8_t> rgba;
+                Image &shown = g.display_color;
+                if (ReadImage(shown, 4, rgba)) {
+                    WritePng(g_capturing + capture_suffix, rgba.data(), shown.width, shown.height);
+                }
+            }
+            Image target;
+            target.image = eye.images[slot].image;
+            target.format = eye.format;
+            target.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+            target.width = eye.width;
+            target.height = eye.height;
+            RunOneShot([&](VkCommandBuffer cmd) {
+                Image &source = g.display_color;
+                Image &scaled = eye.raw_copy ? eye.scratch : target;
+                Transition(cmd, source, TransferSrc());
+                Transition(cmd, scaled, TransferDst());
+                VkImageBlit blit = {};
+                blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+                blit.srcOffsets[1] = {static_cast<int32_t>(source.width), static_cast<int32_t>(source.height), 1};
+                blit.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+                blit.dstOffsets[1] = {static_cast<int32_t>(eye.width), static_cast<int32_t>(eye.height), 1};
+                vkCmdBlitImage(cmd, source.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, scaled.image,
+                               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_LINEAR);
+                if (eye.raw_copy) {
+                    Transition(cmd, eye.scratch, TransferSrc());
+                    Transition(cmd, target, TransferDst());
+                    VkImageCopy copy = {};
+                    copy.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+                    copy.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+                    copy.extent = {eye.width, eye.height, 1};
+                    vkCmdCopyImage(cmd, eye.scratch.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, target.image,
+                                   VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+                    ToRest(cmd, eye.scratch);
+                }
+                // OpenXR takes a colour swapchain image back as a colour attachment.
+                Transition(cmd, target,
+                           {VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT,
+                            VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT});
+                ToRest(cmd, source);
+            });
+            done = true;
+        }
+        XrSwapchainImageReleaseInfo release = {XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+        Ok(xrReleaseSwapchainImage(eye.handle, &release), "xrReleaseSwapchainImage");
+    });
+    return done;
+}
+
+bool SubmitEye(Frame &frame, int index) {
+    if (!frame.begun || !frame.render || index < 0 || index > 1) {
+        return false;
+    }
+    frame.submitted[index] =
+        CopyToChain(g_xr.eyes[static_cast<size_t>(index)], index == 0 ? "_left.png" : "_right.png");
+    return frame.submitted[index];
+}
+
+bool SubmitCinema(Frame &frame) {
+    if (!frame.begun || !frame.render || !frame.cinema) {
+        return false;
+    }
+    frame.cinema_submitted = CopyToChain(g_xr.cinema, "_cinema.png");
+    return frame.cinema_submitted;
+}
+
+void EndFrame(Frame &frame) {
+    if (!frame.begun) {
+        return;
+    }
+    std::array<XrCompositionLayerProjectionView, 2> views = {};
+    XrCompositionLayerProjection                    layer = {XR_TYPE_COMPOSITION_LAYER_PROJECTION};
+    XrCompositionLayerQuad                          ring = {XR_TYPE_COMPOSITION_LAYER_QUAD};
+    XrCompositionLayerQuad                          screen = {XR_TYPE_COMPOSITION_LAYER_QUAD};
+    const XrCompositionLayerBaseHeader             *layers[] = {
+        reinterpret_cast<const XrCompositionLayerBaseHeader *>(&layer),
+        reinterpret_cast<const XrCompositionLayerBaseHeader *>(&ring)};
+    const XrCompositionLayerBaseHeader *cinema_layers[] = {
+        reinterpret_cast<const XrCompositionLayerBaseHeader *>(&screen)};
+    const float target = Fresh(g_vignette_set_ms) ? g_vignette_target.load() : 0.0f;
+    g_xr.vignette_now += (target - g_xr.vignette_now) * 0.15f;
+    XrFrameEndInfo end = {XR_TYPE_FRAME_END_INFO};
+    end.displayTime = g_xr.display_time;
+    end.environmentBlendMode = XR_ENVIRONMENT_BLEND_MODE_OPAQUE;
+    if (frame.render && frame.cinema && frame.cinema_submitted) {
+        // Only the screen: the room around it is dark.
+        screen.space = g_xr.space;
+        screen.eyeVisibility = XR_EYE_VISIBILITY_BOTH;
+        screen.subImage.swapchain = g_xr.cinema.handle;
+        screen.subImage.imageRect = {{0, 0}, {static_cast<int32_t>(kCinemaWidth), static_cast<int32_t>(kCinemaHeight)}};
+        screen.pose = g_xr.cinema_pose;
+        screen.size = {kCinemaMetresWide, kCinemaMetresWide * kCinemaHeight / kCinemaWidth};
+        end.layerCount = 1;
+        end.layers = cinema_layers;
+    } else if (frame.render && frame.submitted[0] && frame.submitted[1]) {
+        for (size_t i = 0; i < 2; i++) {
+            views[i] = {XR_TYPE_COMPOSITION_LAYER_PROJECTION_VIEW};
+            views[i].pose = g_xr.views[i].pose;
+            views[i].fov = g_xr.views[i].fov;
+            views[i].subImage.swapchain = g_xr.eyes[i].handle;
+            views[i].subImage.imageRect = {{0, 0},
+                                           {static_cast<int32_t>(g_xr.eyes[i].width),
+                                            static_cast<int32_t>(g_xr.eyes[i].height)}};
+        }
+        layer.space = g_xr.space;
+        layer.viewCount = 2;
+        layer.views = views.data();
+        end.layerCount = 1;
+        end.layers = layers;
+        // A metre ahead of the head: at full strength the dark starts about 30 degrees out and is
+        // whole by 45; at none it stands past the edges of the view.
+        if (g_xr.vignette != XR_NULL_HANDLE && g_xr.vignette_now > 0.02f) {
+            const float half = 3.2f - 2.15f * std::min(g_xr.vignette_now, 1.0f);
+            ring.layerFlags = XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT |
+                              XR_COMPOSITION_LAYER_UNPREMULTIPLIED_ALPHA_BIT;
+            ring.space = g_xr.head;
+            ring.eyeVisibility = XR_EYE_VISIBILITY_BOTH;
+            ring.subImage.swapchain = g_xr.vignette;
+            ring.subImage.imageRect = {{0, 0}, {static_cast<int32_t>(kVignetteSize), static_cast<int32_t>(kVignetteSize)}};
+            ring.pose = {{0, 0, 0, 1}, {0, 0, -1}};
+            ring.size = {2.0f * half, 2.0f * half};
+            end.layerCount = 2;
+        }
+    }
+    Trace(end.layerCount != 0 ? "end (with layer)" : "end (no layer)");
+    RunOnRenderThread([&] { Ok(xrEndFrame(g_xr.session, &end), "xrEndFrame"); });
+    frame.begun = false;
+    g_capturing.clear();
+    const auto now = TraceClock::now();
+    if (g_trace_frames != 0) {
+        g_trace_worst_ms =
+            std::max(g_trace_worst_ms, std::chrono::duration<double, std::milli>(now - g_trace_last).count());
+    } else {
+        g_trace_report = now;
+    }
+    g_trace_last = now;
+    g_trace_frames++;
+    g_trace_layers += end.layerCount != 0 ? 1 : 0;
+    g_trace_ring = std::max(g_trace_ring, end.layerCount > 1 ? g_xr.vignette_now : 0.0f);
+    g_trace_cinema += frame.cinema_submitted ? 1 : 0;
+    if (now - g_trace_report >= std::chrono::seconds(5)) {
+        kz::Logf(kz::LogLevel::Info, "xr",
+                 "{} frames, {} with a layer, {} on the cinema screen, worst gap {:.1f} ms, ring {:.2f}, at {} ms",
+                 g_trace_frames, g_trace_layers, g_trace_cinema, g_trace_worst_ms, g_trace_ring, TraceMs());
+        g_trace_worst_ms = 0;
+        g_trace_ring = 0;
+        g_trace_report = now;
+    }
+}
