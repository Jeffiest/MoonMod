+bool Init(const char *app_name) {
+    if (g_xr.enabled) {
+        return true;
+    }
+    const char *extensions[] = {XR_KHR_VULKAN_ENABLE2_EXTENSION_NAME};
+    XrInstanceCreateInfo info = {XR_TYPE_INSTANCE_CREATE_INFO};
+    std::snprintf(info.applicationInfo.applicationName, sizeof info.applicationInfo.applicationName, "%s",
+                  app_name != nullptr ? app_name : "Kazarov");
+    std::snprintf(info.applicationInfo.engineName, sizeof info.applicationInfo.engineName, "Kazarov");
+    info.applicationInfo.apiVersion = XR_API_VERSION_1_0;
+    info.enabledExtensionCount = 1;
+    info.enabledExtensionNames = extensions;
+    if (!Ok(xrCreateInstance(&info, &g_xr.instance), "xrCreateInstance")) {
+        kz::Logf(kz::LogLevel::Warning, "xr", "no OpenXR runtime with Vulkan; playing on the window");
+        g_xr = {};
+        return false;
+    }
+    XrSystemGetInfo system = {XR_TYPE_SYSTEM_GET_INFO};
+    system.formFactor = XR_FORM_FACTOR_HEAD_MOUNTED_DISPLAY;
+    // A headset that is asleep, or not yet in the runtime's link mode, is unavailable for a while:
+    // waited for up to 15 seconds, the way OpenXR means it to be.
+    XrResult found = xrGetSystem(g_xr.instance, &system, &g_xr.system);
+    for (int tries = 0; found == XR_ERROR_FORM_FACTOR_UNAVAILABLE && tries < 30; tries++) {
+        if (tries == 0) {
+            kz::Logf(kz::LogLevel::Info, "xr", "waiting for the headset (put it on, or turn on its link)");
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(500));
+        found = xrGetSystem(g_xr.instance, &system, &g_xr.system);
+    }
+    if (!Ok(found, "xrGetSystem") ||
+        !Load("xrGetVulkanGraphicsRequirements2KHR", g_xr.requirements) ||
+        !Load("xrCreateVulkanInstanceKHR", g_xr.create_instance) ||
+        !Load("xrGetVulkanGraphicsDevice2KHR", g_xr.graphics_device) ||
+        !Load("xrCreateVulkanDeviceKHR", g_xr.create_device)) {
+        kz::Logf(kz::LogLevel::Warning, "xr", "no headset found; playing on the window");
+        Disable();
+        return false;
+    }
+    // The runtime must be asked for its Vulkan needs before the instance is made.
+    XrGraphicsRequirementsVulkan2KHR requirements = {XR_TYPE_GRAPHICS_REQUIREMENTS_VULKAN2_KHR};
+    if (!Ok(g_xr.requirements(g_xr.instance, g_xr.system, &requirements), "xrGetVulkanGraphicsRequirements2KHR")) {
+        Disable();
+        return false;
+    }
+    XrInstanceProperties properties = {XR_TYPE_INSTANCE_PROPERTIES};
+    xrGetInstanceProperties(g_xr.instance, &properties);
+    XrSystemProperties system_properties = {XR_TYPE_SYSTEM_PROPERTIES};
+    xrGetSystemProperties(g_xr.instance, g_xr.system, &system_properties);
+    kz::Logf(kz::LogLevel::Info, "xr", "{} on {}", static_cast<const char *>(system_properties.systemName),
+             static_cast<const char *>(properties.runtimeName));
+    g_xr.enabled = true;
+    return true;
+}
