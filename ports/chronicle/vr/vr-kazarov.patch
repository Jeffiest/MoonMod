+XrAction MakeAction(const char *name, const char *label, XrActionType type) {
+    XrActionCreateInfo info = {XR_TYPE_ACTION_CREATE_INFO};
+    std::snprintf(info.actionName, sizeof info.actionName, "%s", name);
+    std::snprintf(info.localizedActionName, sizeof info.localizedActionName, "%s", label);
+    info.actionType = type;
+    XrAction action = XR_NULL_HANDLE;
+    Ok(xrCreateAction(g_xr.actions, &info, &action), "xrCreateAction");
+    return action;
+}
