+XrPath ToPath(const char *text) {
+    XrPath path = XR_NULL_PATH;
+    xrStringToPath(g_xr.instance, text, &path);
+    return path;
+}
+
+// One action set for play, bound the same on both Touch controllers.
+bool CreateActions() {
+    XrActionSetCreateInfo set = {XR_TYPE_ACTION_SET_CREATE_INFO};
+    std::snprintf(set.actionSetName, sizeof set.actionSetName, "play");
+    std::snprintf(set.localizedActionSetName, sizeof set.localizedActionSetName, "Play");
+    if (!Ok(xrCreateActionSet(g_xr.instance, &set, &g_xr.actions), "xrCreateActionSet")) {
+        return false;
+    }
+    g_xr.stick = MakeAction("stick", "Move", XR_ACTION_TYPE_VECTOR2F_INPUT);
+    g_xr.trigger = MakeAction("trigger", "Attack and talk", XR_ACTION_TYPE_BOOLEAN_INPUT);
+    g_xr.grip = MakeAction("grip", "Guard", XR_ACTION_TYPE_BOOLEAN_INPUT);
+    g_xr.lower = MakeAction("lower", "Cancel", XR_ACTION_TYPE_BOOLEAN_INPUT);
+    g_xr.upper = MakeAction("upper", "Menu", XR_ACTION_TYPE_BOOLEAN_INPUT);
+    g_xr.stick_click = MakeAction("stick_click", "Item", XR_ACTION_TYPE_BOOLEAN_INPUT);
+    g_xr.menu = MakeAction("menu", "Pause", XR_ACTION_TYPE_BOOLEAN_INPUT);
+    const std::pair<XrAction, const char *> bindings[] = {
+        {g_xr.stick, "/user/hand/left/input/thumbstick"},
+        {g_xr.stick, "/user/hand/right/input/thumbstick"},
+        {g_xr.trigger, "/user/hand/left/input/trigger/value"},
+        {g_xr.trigger, "/user/hand/right/input/trigger/value"},
+        {g_xr.grip, "/user/hand/left/input/squeeze/value"},
+        {g_xr.grip, "/user/hand/right/input/squeeze/value"},
+        {g_xr.lower, "/user/hand/left/input/x/click"},
+        {g_xr.lower, "/user/hand/right/input/a/click"},
+        {g_xr.upper, "/user/hand/left/input/y/click"},
+        {g_xr.upper, "/user/hand/right/input/b/click"},
+        {g_xr.stick_click, "/user/hand/left/input/thumbstick/click"},
+        {g_xr.stick_click, "/user/hand/right/input/thumbstick/click"},
+        {g_xr.menu, "/user/hand/left/input/menu/click"},
+    };
+    std::vector<XrActionSuggestedBinding> suggested;
+    for (const auto &[action, path] : bindings) {
+        suggested.push_back({action, ToPath(path)});
+    }
+    XrInteractionProfileSuggestedBinding profile = {XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING};
+    profile.interactionProfile = ToPath("/interaction_profiles/oculus/touch_controller");
+    profile.suggestedBindings = suggested.data();
+    profile.countSuggestedBindings = static_cast<uint32_t>(suggested.size());
+    if (!Ok(xrSuggestInteractionProfileBindings(g_xr.instance, &profile), "xrSuggestInteractionProfileBindings")) {
+        return false;
+    }
+    XrSessionActionSetsAttachInfo attach = {XR_TYPE_SESSION_ACTION_SETS_ATTACH_INFO};
+    attach.countActionSets = 1;
+    attach.actionSets = &g_xr.actions;
+    return Ok(xrAttachSessionActionSets(g_xr.session, &attach), "xrAttachSessionActionSets");
+}
+
+bool Held(XrAction action, bool &active) {
+    XrActionStateGetInfo get = {XR_TYPE_ACTION_STATE_GET_INFO};
+    get.action = action;
+    XrActionStateBoolean state = {XR_TYPE_ACTION_STATE_BOOLEAN};
+    if (action == XR_NULL_HANDLE || XR_FAILED(xrGetActionStateBoolean(g_xr.session, &get, &state))) {
+        return false;
+    }
+    active |= state.isActive != XR_FALSE;
+    return state.isActive != XR_FALSE && state.currentState != XR_FALSE;
+}
+
+void SyncControls() {
+    xr::Controls controls;
+    if (g_xr.actions != XR_NULL_HANDLE && g_xr.state == XR_SESSION_STATE_FOCUSED) {
+        XrActiveActionSet active_set = {g_xr.actions, XR_NULL_PATH};
+        XrActionsSyncInfo sync = {XR_TYPE_ACTIONS_SYNC_INFO};
+        sync.countActiveActionSets = 1;
+        sync.activeActionSets = &active_set;
+        if (XR_SUCCEEDED(xrSyncActions(g_xr.session, &sync))) {
+            XrActionStateGetInfo get = {XR_TYPE_ACTION_STATE_GET_INFO};
+            get.action = g_xr.stick;
+            XrActionStateVector2f stick = {XR_TYPE_ACTION_STATE_VECTOR2F};
+            if (XR_SUCCEEDED(xrGetActionStateVector2f(g_xr.session, &get, &stick)) && stick.isActive) {
+                controls.active = true;
+                controls.stick_x = stick.currentState.x;
+                controls.stick_y = stick.currentState.y;
+            }
+            controls.trigger = Held(g_xr.trigger, controls.active);
+            controls.grip = Held(g_xr.grip, controls.active);
+            controls.lower = Held(g_xr.lower, controls.active);
+            controls.upper = Held(g_xr.upper, controls.active);
+            controls.stick = Held(g_xr.stick_click, controls.active);
+            controls.menu = Held(g_xr.menu, controls.active);
+        }
+    }
+    std::scoped_lock lock(g_controls_mutex);
+    g_controls = controls;
+}
+
+void PollEvents() {
+    XrEventDataBuffer event = {XR_TYPE_EVENT_DATA_BUFFER};
+    while (xrPollEvent(g_xr.instance, &event) == XR_SUCCESS) {
+        switch (event.type) {
+        case XR_TYPE_EVENT_DATA_SESSION_STATE_CHANGED: {
+            const auto &changed = *reinterpret_cast<const XrEventDataSessionStateChanged *>(&event);
+            g_xr.state = changed.state;
+            kz::Logf(kz::LogLevel::Info, "xr", "session state {} at {} ms", static_cast<int>(changed.state), TraceMs());
+            if (g_xr.state == XR_SESSION_STATE_READY) {
+                XrSessionBeginInfo begin = {XR_TYPE_SESSION_BEGIN_INFO};
+                begin.primaryViewConfigurationType = XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO;
+                g_xr.running = Ok(xrBeginSession(g_xr.session, &begin), "xrBeginSession");
+                g_xr.recenter = true;
+                kz::Logf(kz::LogLevel::Info, "xr", "headset session running");
+            } else if (g_xr.state == XR_SESSION_STATE_STOPPING) {
+                g_xr.running = false;
+                Ok(xrEndSession(g_xr.session), "xrEndSession");
+                kz::Logf(kz::LogLevel::Info, "xr", "headset session stopped");
+            } else if (g_xr.state == XR_SESSION_STATE_EXITING || g_xr.state == XR_SESSION_STATE_LOSS_PENDING) {
+                g_xr.running = false;
+                g_xr.exit_requested = true;
+            }
+            break;
+        }
+        case XR_TYPE_EVENT_DATA_INSTANCE_LOSS_PENDING:
+            g_xr.running = false;
+            g_xr.exit_requested = true;
+            break;
+        case XR_TYPE_EVENT_DATA_REFERENCE_SPACE_CHANGE_PENDING:
+            g_xr.recenter = true;
+            break;
+        default:
+            break;
+        }
+        event = {XR_TYPE_EVENT_DATA_BUFFER};
+    }
+}
+
+// The swapchain format: an sRGB RGBA or BGRA one when offered, else a UNORM one, else the runtime's first.
+int64_t PickFormat(bool *raw_copy) {
+    uint32_t count = 0;
+    xrEnumerateSwapchainFormats(g_xr.session, 0, &count, nullptr);
+    std::vector<int64_t> formats(count);
+    xrEnumerateSwapchainFormats(g_xr.session, count, &count, formats.data());
+    for (VkFormat wanted : {VK_FORMAT_R8G8B8A8_SRGB, VK_FORMAT_B8G8R8A8_SRGB}) {
+        if (std::find(formats.begin(), formats.end(), wanted) != formats.end()) {
+            *raw_copy = true;
+            return wanted;
+        }
+    }
+    *raw_copy = false;
+    for (VkFormat wanted : {VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_B8G8R8A8_UNORM}) {
+        if (std::find(formats.begin(), formats.end(), wanted) != formats.end()) {
+            return wanted;
+        }
+    }
+    return formats.empty() ? 0 : formats.front();
+}
+
+VkFormat UnormOf(VkFormat format) {
+    return format == VK_FORMAT_B8G8R8A8_SRGB ? VK_FORMAT_B8G8R8A8_UNORM : VK_FORMAT_R8G8B8A8_UNORM;
+}
+
+bool CreateChain(EyeChain &chain, uint32_t width, uint32_t height, int64_t format, bool raw_copy) {
+    chain.width = width;
+    chain.height = height;
+    chain.format = static_cast<VkFormat>(format);
+    chain.raw_copy = raw_copy;
+    XrSwapchainCreateInfo info = {XR_TYPE_SWAPCHAIN_CREATE_INFO};
+    info.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_TRANSFER_DST_BIT;
+    info.format = format;
+    info.sampleCount = 1;
+    info.width = width;
+    info.height = height;
+    info.faceCount = 1;
+    info.arraySize = 1;
+    info.mipCount = 1;
+    if (!Ok(xrCreateSwapchain(g_xr.session, &info, &chain.handle), "xrCreateSwapchain")) {
+        return false;
+    }
+    uint32_t images = 0;
+    xrEnumerateSwapchainImages(chain.handle, 0, &images, nullptr);
+    chain.images.assign(images, {XR_TYPE_SWAPCHAIN_IMAGE_VULKAN2_KHR});
+    if (!Ok(xrEnumerateSwapchainImages(chain.handle, images, &images,
+                                       reinterpret_cast<XrSwapchainImageBaseHeader *>(chain.images.data())),
+            "xrEnumerateSwapchainImages")) {
+        return false;
+    }
+    if (raw_copy) {
+        chain.scratch = CreateImage(width, height, 1, UnormOf(chain.format),
+                                    VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT);
+    }
+    return true;
+}
+
+void DestroyChain(EyeChain &chain) {
+    if (chain.scratch.image != VK_NULL_HANDLE) {
+        DestroyImage(chain.scratch);
+    }
+    if (chain.handle != XR_NULL_HANDLE) {
+        xrDestroySwapchain(chain.handle);
+    }
+    chain = {};
+}
+
+bool CreateEyes() {
+    uint32_t count = 0;
+    xrEnumerateViewConfigurationViews(g_xr.instance, g_xr.system, XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO, 0, &count,
+                                      nullptr);
+    if (count != 2) {
+        kz::Logf(kz::LogLevel::Warning, "xr", "the headset has {} views, not 2", count);
+        return false;
+    }
+    std::array<XrViewConfigurationView, 2> views = {{{XR_TYPE_VIEW_CONFIGURATION_VIEW},
+                                                     {XR_TYPE_VIEW_CONFIGURATION_VIEW}}};
+    if (!Ok(xrEnumerateViewConfigurationViews(g_xr.instance, g_xr.system, XR_VIEW_CONFIGURATION_TYPE_PRIMARY_STEREO, 2,
+                                              &count, views.data()),
+            "xrEnumerateViewConfigurationViews")) {
+        return false;
+    }
+    bool          raw_copy = false;
+    const int64_t format = PickFormat(&raw_copy);
+    for (size_t i = 0; i < 2; i++) {
+        if (!CreateChain(g_xr.eyes[i], views[i].recommendedImageRectWidth, views[i].recommendedImageRectHeight, format,
+                         raw_copy)) {
+            return false;
+        }
+    }
+    if (!CreateChain(g_xr.cinema, kCinemaWidth, kCinemaHeight, format, raw_copy)) {
+        kz::Logf(kz::LogLevel::Warning, "xr", "no cinema screen; scenes play all around");
+        DestroyChain(g_xr.cinema);
+    }
+    kz::Logf(kz::LogLevel::Info, "xr", "eyes {}x{}, format {}{}", g_xr.eyes[0].width, g_xr.eyes[0].height,
+             static_cast<int>(format), raw_copy ? " (sRGB, copied as drawn)" : "");
+    return true;
+}
+
+void DestroyEyes() {
+    for (EyeChain &eye : g_xr.eyes) {
+        DestroyChain(eye);
+    }
+    DestroyChain(g_xr.cinema);
+}
