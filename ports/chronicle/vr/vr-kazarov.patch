+            vertices = it->second;
+        } else {
+            vertices.assign(draw->vertices.begin(), draw->vertices.end());
+        }
+        if (FadesFrame(*draw, vertices)) {
+            continue;
+        }
+        if (trace != nullptr) {
+            float x0 = INFINITY, y0 = INFINITY, x1 = -INFINITY, y1 = -INFINITY;
+            for (const Vertex2D &v : vertices) {
+                x0 = std::min(x0, v.x), y0 = std::min(y0, v.y), x1 = std::max(x1, v.x), y1 = std::max(y1, v.y);
+            }
