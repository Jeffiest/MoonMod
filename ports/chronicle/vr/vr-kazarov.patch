+    const float up = std::tan(fov.angleUp), dn = std::tan(fov.angleDown);
+    for (int col = 0; col < 4; col++) {
+        float p[3] = {screen[col][0], screen[col][1], screen[col][2]};
+        if (col == 3) {
+            p[0] -= eye.position.x;
+            p[1] -= eye.position.y;
+            p[2] -= eye.position.z;
+        }
+        float e[3];
+        for (int i = 0; i < 3; i++) {
+            e[i] = r[0][i] * p[0] + r[1][i] * p[1] + r[2][i] * p[2];
+        }
+        out[col * 4 + 0] = 2 / (rt - l) * e[0] + (rt + l) / (rt - l) * e[2];
+        out[col * 4 + 1] = -2 / (up - dn) * e[1] - (up + dn) / (up - dn) * e[2];
+        out[col * 4 + 2] = 0;
+        out[col * 4 + 3] = -e[2];
+    }
+}
