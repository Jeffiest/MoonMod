+XrPosef Multiply(const XrPosef &a, const XrPosef &b) {
+    // a * b: b's place, then a's.
+    const XrQuaternionf &p = a.orientation;
+    const XrQuaternionf &q = b.orientation;
+    XrPosef              out;
+    out.orientation = {p.w * q.x + p.x * q.w + p.y * q.z - p.z * q.y, p.w * q.y - p.x * q.z + p.y * q.w + p.z * q.x,
+                       p.w * q.z + p.x * q.y - p.y * q.x + p.z * q.w, p.w * q.w - p.x * q.x - p.y * q.y - p.z * q.z};
+    // a's rotation applied to b's position: v + 2w(u x v) + 2u x (u x v).
+    const XrVector3f &v = b.position;
+    const float       cx = p.y * v.z - p.z * v.y, cy = p.z * v.x - p.x * v.z, cz = p.x * v.y - p.y * v.x;
+    const float       dx = p.y * cz - p.z * cy, dy = p.z * cx - p.x * cz, dz = p.x * cy - p.y * cx;
+    out.position = {a.position.x + v.x + 2 * (p.w * cx + dx), a.position.y + v.y + 2 * (p.w * cy + dy),
+                    a.position.z + v.z + 2 * (p.w * cz + dz)};
+    return out;
+}
+
+XrPosef Inverse(const XrPosef &pose) {
+    XrPosef inverse;
+    inverse.orientation = {-pose.orientation.x, -pose.orientation.y, -pose.orientation.z, pose.orientation.w};
+    inverse.position = {0, 0, 0};
+    XrPosef turned = Multiply(inverse, {{0, 0, 0, 1}, pose.position});
+    inverse.position = {-turned.position.x, -turned.position.y, -turned.position.z};
+    return inverse;
+}
+
+// Home keeps the head's place and its turn about the vertical, not its tilt.
+XrPosef YawOnly(const XrPosef &pose) {
+    const XrQuaternionf &q = pose.orientation;
+    float                yaw = std::atan2(2 * (q.w * q.y + q.x * q.z), 1 - 2 * (q.y * q.y + q.x * q.x));
+    return {{0, std::sin(yaw / 2), 0, std::cos(yaw / 2)}, pose.position};
+}
