+    GfxFixture                       fixture(kWidth, kHeight);
+    const std::vector<gfx::Vertex3D> vertices = {
+        Vert({0.1f, -0.2f, 0.5f}, {0, 0, 1}, {255, 255, 255, 128}),
+        Vert({0.5f, -0.2f, 0.5f}, {0, 0, 1}, {255, 255, 255, 128}),
+        Vert({0.3f, 0.2f, 0.5f}, {0, 0, 1}, {255, 255, 255, 128})};
+    auto record = [&](float camera_x) {
+        auto transform = gfx::IdentityMeshTransform();
+        transform.view[12] = camera_x;
+        gfx::MeshConstants constants = {};
+        std::memcpy(constants.mvp, transform.view, sizeof constants.mvp);
+        for (int k = 0; k < 4; ++k) {
+            constants.diffuse[k] = constants.ambient[k] = 1;
+        }
+        gfx::BeginRecording();
+        gfx::Clear(true, kClear.data(), true, 0);
+        gfx::SetInterpKey(5);
+        gfx::DrawMeshImmediate(vertices, kTriangle, constants, {}, {}, &transform);
+        return gfx::EndRecording();
+    };
+    auto expected = record(-0.5f);
+    ASSERT_TRUE(gfx::RenderList(*expected, 1, {.canonical = true}));
+    auto over = ReadCoverage(fixture);
+    ASSERT_GT(over.count, 0);
+
+    auto newest = record(0);
+    ASSERT_TRUE(gfx::RenderList(*newest, 1, {.canonical = true}));
+    auto straight = ReadCoverage(fixture);
+    ASSERT_GT(straight.count, 0);
+    ASSERT_GT(std::fabs(straight.x - over.x), 4.0);
+
+    gfx::EyeView eye = {};
+    Identity(eye.view);
+    eye.view[12] = -0.5f;
+    ASSERT_TRUE(gfx::RenderList(*newest, 1, {.present = true, .eye = &eye}));
+    auto seen = ReadCoverage(fixture);
+    EXPECT_EQ(seen.count, over.count);
+    EXPECT_NEAR(seen.x, over.x, 0.01);
+
+    // The same shift as a projection of the eye's own.
+    Identity(eye.view);
+    Identity(eye.projection);
+    eye.projection[12] = -0.5f;
+    eye.has_projection = true;
+    ASSERT_TRUE(gfx::RenderList(*newest, 1, {.present = true, .eye = &eye}));
+    seen = ReadCoverage(fixture);
+    EXPECT_EQ(seen.count, over.count);
+    EXPECT_NEAR(seen.x, over.x, 0.01);
+
+    // No eye: the tick's own camera.
+    ASSERT_TRUE(gfx::RenderList(*newest, 1, {.present = true}));
+    seen = ReadCoverage(fixture);
+    EXPECT_NEAR(seen.x, straight.x, 0.01);
+}
+
+// Prog0 draws carry their projection inside clip_or_view; the eye swaps it there too.
+TEST(GfxGpuMeshDc2, EyeViewMovesProg0Draws) {
+    GfxFixture                       fixture(kWidth, kHeight, 1.0f, Prog0Options());
+    const std::vector<gfx::Vertex3D> vertices = {
+        Vert({0.1f, -0.2f, 0.5f}, {0, 0, 1}), Vert({0.5f, -0.2f, 0.5f}, {0, 0, 1}),
+        Vert({0.3f, 0.2f, 0.5f}, {0, 0, 1})};
+    auto record = [&](float camera_x) {
+        auto transform = gfx::IdentityMeshTransform();
+        transform.view[12] = camera_x;
+        gfx::MeshConstants constants = {};
+        std::memcpy(constants.mvp, transform.view, sizeof constants.mvp);
+        gfx::Prog0Constants block = {};
+        Identity(block.model_world);
+        std::memcpy(block.clip_or_view, transform.view, sizeof block.clip_or_view);
+        block.flags = gfx::kProg0Unlit | gfx::kProg0Scissor;
+        for (int k = 0; k < 4; ++k) {
+            block.object_color[k] = k == 3 ? 128.0f : 200.0f;
+            block.diffuse[k] = 1;
+        }
+        gfx::BeginRecording();
+        gfx::Clear(true, kClear.data(), true, 0);
+        gfx::SetInterpKey(6);
+        gfx::DrawMeshImmediateProg0(vertices, kTriangle, constants, block, {}, {}, &transform);
+        return gfx::EndRecording();
+    };
+    auto expected = record(-0.5f);
+    ASSERT_TRUE(gfx::RenderList(*expected, 1, {.canonical = true}));
+    auto over = ReadCoverage(fixture);
+    ASSERT_GT(over.count, 0);
+
+    auto newest = record(0);
+    ASSERT_TRUE(gfx::RenderList(*newest, 1, {.canonical = true}));
+    gfx::EyeView eye = {};
+    Identity(eye.view);
+    eye.view[12] = -0.5f;
+    ASSERT_TRUE(gfx::RenderList(*newest, 1, {.present = true, .eye = &eye}));
+    auto seen = ReadCoverage(fixture);
+    EXPECT_EQ(seen.count, over.count);
+    EXPECT_NEAR(seen.x, over.x, 0.01);
+
+    Identity(eye.view);
+    Identity(eye.projection);
+    eye.projection[12] = -0.5f;
+    eye.has_projection = true;
+    ASSERT_TRUE(gfx::RenderList(*newest, 1, {.present = true, .eye = &eye}));
+    seen = ReadCoverage(fixture);
+    EXPECT_EQ(seen.count, over.count);
+    EXPECT_NEAR(seen.x, over.x, 0.01);
+}
