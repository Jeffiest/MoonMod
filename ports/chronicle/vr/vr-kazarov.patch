+// KZ_XR_FAKE_YAW=degrees: the head reads as turned that far left of where it is, to test head-led
+// play without a headset.
+float FakeYaw() {
+    static const float yaw = [] {
+        const char *text = std::getenv("KZ_XR_FAKE_YAW");
+        return text != nullptr ? static_cast<float>(std::atof(text)) * 3.14159265f / 180.0f : 0.0f;
+    }();
+    return yaw;
+}
