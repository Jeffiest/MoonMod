diff --git a/cmake/KazarovOpenXR.cmake b/cmake/KazarovOpenXR.cmake
new file mode 100644
index 0000000..779bdc7
--- /dev/null
+++ b/cmake/KazarovOpenXR.cmake
@@ -0,0 +1,14 @@
+# The OpenXR loader, linked statically, for headset play (gfx/xr.hpp). A build without it keeps the
+# same API, and xr::Init then reports that there is no runtime.
+include_guard(GLOBAL)
+include(FetchContent)
+set(DYNAMIC_LOADER OFF CACHE BOOL "" FORCE)
+set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
+set(BUILD_API_LAYERS OFF CACHE BOOL "" FORCE)
+set(BUILD_WITH_SYSTEM_JSONCPP OFF CACHE BOOL "" FORCE)
+set(BUILD_WITH_WAYLAND_HEADERS OFF CACHE BOOL "" FORCE)
+FetchContent_Declare(openxr
+    URL https://codeload.github.com/KhronosGroup/OpenXR-SDK/tar.gz/refs/tags/release-1.1.63
+    URL_HASH SHA256=5b8dac0608f49498fe8e95f562fe6bcf0bc781e561f137348a8c251d06a88b6f
+    DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
+FetchContent_MakeAvailable(openxr)
