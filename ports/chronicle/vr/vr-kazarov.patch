+
+// Whether vertices reach every edge of the logical frame.
+bool CoversFrame(std::span<const Vertex2D> vertices) {
+    if (vertices.empty()) {
+        return false;
+    }
+    float x0 = INFINITY, y0 = INFINITY, x1 = -INFINITY, y1 = -INFINITY;
+    for (const Vertex2D &v : vertices) {
+        x0 = std::min(x0, v.x);
+        y0 = std::min(y0, v.y);
+        x1 = std::max(x1, v.x);
+        y1 = std::max(y1, v.y);
+    }
+    return CoversLogicalFrame({x0, y0, x1 - x0, y1 - y0});
+}
+
+// Whether a draw covers the whole logical frame untextured: a fade, which stays over the whole eye.
+bool FadesFrame(const Draw2DEntry &draw, std::span<const Vertex2D> vertices) {
