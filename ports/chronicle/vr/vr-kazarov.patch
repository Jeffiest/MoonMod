+
+// Stands the flat 2D drawn to kMainTarget (menus, text, the HUD) on the headset's screen: each
+// vertex goes from the target's clip through eye.ui and back to logical space. Fades and screen
+// effects keep the whole eye; a draw with a corner behind the eye is dropped.
+void PlaceFlatUi(const DisplayList &list, const EyeView &eye, Overrides &out) {
+    const LogicalMapping mapping = GetLogicalMapping(kMainTarget);
+    if (mapping.pixel_width == 0 || mapping.pixel_height == 0 || mapping.scale_x == 0.0f ||
+        mapping.scale_y == 0.0f) {
+        return;
+    }
+    const float sx = 2.0f * mapping.scale_x / static_cast<float>(mapping.pixel_width);
+    const float sy = 2.0f * mapping.scale_y / static_cast<float>(mapping.pixel_height);
+    const float ox = 2.0f * mapping.offset_x / static_cast<float>(mapping.pixel_width) - 1.0f;
+    const float oy = 2.0f * mapping.offset_y / static_cast<float>(mapping.pixel_height) - 1.0f;
+    const float *m = eye.ui;
+    // KZ_VR_UI_TRACE=path:N: the flat draws of every Nth placement, to path_<count>.txt, for finding what lands on the screen.
+    static int  placements = 0;
+    FILE       *trace = nullptr;
+    if (const char *setting = std::getenv("KZ_VR_UI_TRACE"); setting != nullptr) {
+        std::string text = setting;
+        const size_t colon = text.rfind(':');
+        const int every = colon != std::string::npos ? std::atoi(text.c_str() + colon + 1) : 0;
+        if (every > 0 && ++placements % every == 0) {
+            trace = std::fopen((text.substr(0, colon) + "_" + std::to_string(placements) + ".txt").c_str(), "w");
