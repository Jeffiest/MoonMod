+// The ring image: alpha rises from clear at 55% of the way to the edge to dark at 95%, and the
+// corners are dark.
+constexpr uint32_t kVignetteSize = 256;
+
+bool CreateVignette(VkFormat format) {
+    XrSwapchainCreateInfo info = {XR_TYPE_SWAPCHAIN_CREATE_INFO};
+    info.createFlags = XR_SWAPCHAIN_CREATE_STATIC_IMAGE_BIT;
+    info.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_TRANSFER_DST_BIT;
+    info.format = format;
+    info.sampleCount = 1;
+    info.width = kVignetteSize;
+    info.height = kVignetteSize;
+    info.faceCount = 1;
+    info.arraySize = 1;
+    info.mipCount = 1;
+    if (!Ok(xrCreateSwapchain(g_xr.session, &info, &g_xr.vignette), "xrCreateSwapchain (vignette)")) {
+        return false;
+    }
+    uint32_t count = 0;
+    xrEnumerateSwapchainImages(g_xr.vignette, 0, &count, nullptr);
+    std::vector<XrSwapchainImageVulkan2KHR> images(count, {XR_TYPE_SWAPCHAIN_IMAGE_VULKAN2_KHR});
+    xrEnumerateSwapchainImages(g_xr.vignette, count, &count, reinterpret_cast<XrSwapchainImageBaseHeader *>(images.data()));
+    uint32_t                    slot = 0;
+    XrSwapchainImageAcquireInfo acquire = {XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+    XrSwapchainImageWaitInfo    wait = {XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+    wait.timeout = XR_INFINITE_DURATION;
+    if (count == 0 || !Ok(xrAcquireSwapchainImage(g_xr.vignette, &acquire, &slot), "xrAcquireSwapchainImage") ||
+        !Ok(xrWaitSwapchainImage(g_xr.vignette, &wait), "xrWaitSwapchainImage")) {
+        return false;
+    }
+    const VkDeviceSize bytes = VkDeviceSize{kVignetteSize} * kVignetteSize * 4;
+    Buffer             staging = CreateBuffer(bytes, VK_BUFFER_USAGE_TRANSFER_SRC_BIT, true);
+    uint8_t           *texels = staging.memory.mapped;
+    for (uint32_t y = 0; y < kVignetteSize; y++) {
+        for (uint32_t x = 0; x < kVignetteSize; x++) {
+            const float u = (x + 0.5f) / kVignetteSize * 2.0f - 1.0f;
+            const float v = (y + 0.5f) / kVignetteSize * 2.0f - 1.0f;
+            const float t = std::clamp((std::sqrt(u * u + v * v) - 0.55f) / 0.4f, 0.0f, 1.0f);
+            uint8_t    *texel = texels + (static_cast<size_t>(y) * kVignetteSize + x) * 4;
+            texel[0] = texel[1] = texel[2] = 0;
+            texel[3] = static_cast<uint8_t>(std::lround(255.0f * t * t * (3.0f - 2.0f * t)));
+        }
+    }
+    Image target;
+    target.image = images[slot].image;
+    target.format = format;
+    target.aspect = VK_IMAGE_ASPECT_COLOR_BIT;
+    target.width = kVignetteSize;
+    target.height = kVignetteSize;
+    RunOneShot([&](VkCommandBuffer cmd) {
+        Transition(cmd, target, TransferDst());
+        VkBufferImageCopy region = {};
+        region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        region.imageExtent = {kVignetteSize, kVignetteSize, 1};
+        vkCmdCopyBufferToImage(cmd, staging.buffer, target.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+        Transition(cmd, target,
+                   {VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT,
+                    VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT});
+    });
+    DestroyBuffer(staging);
+    XrSwapchainImageReleaseInfo release = {XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+    return Ok(xrReleaseSwapchainImage(g_xr.vignette, &release), "xrReleaseSwapchainImage");
+}
