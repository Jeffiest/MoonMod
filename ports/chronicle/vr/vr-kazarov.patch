diff --git a/include/gfx/xr.hpp b/include/gfx/xr.hpp
new file mode 100644
index 0000000..05ec5c0
--- /dev/null
+++ b/include/gfx/xr.hpp
@@ -0,0 +1,85 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include "gfx/gfx.hpp"
+
+// Headset play through OpenXR. The game keeps drawing its ticks as usual; each headset frame
+// replays the newest tick once per eye (RenderOptions::eye) and hands the images to the runtime.
+// The window goes on showing the game as a mirror.
+//
+//   xr::Init before RendererInit; the renderer then makes its Vulkan instance and device through
+//   the runtime and starts the session itself. Per headset frame, outside a game frame:
+//   BeginFrame, then for each eye a display render with frame.eyes[i] and SubmitEye(frame, i),
+//   then EndFrame.
+namespace gfx::xr {
+
+// Finds an OpenXR runtime with a head-mounted display. False, with a log line saying why, when
+// there is none (no runtime installed, no headset, or a build without OpenXR); the game then
+// plays on the window alone.
+bool Init(const char *app_name);
+// Init succeeded and the renderer works through the runtime.
+bool Enabled();
+// The session is running: the headset wants frames.
+bool Running();
+// The runtime asked the application to close (the user quit from the headset's menu).
+bool ExitRequested();
+// World units in a metre of the player's space; the game's scale for the headset.
+void SetUnitsPerMetre(float units);
+// The head's current place and facing (yaw only) become home: where the tick's camera stands.
+void Recenter();
+
+struct Frame {
+    bool    begun = false;  // BeginFrame began a frame; EndFrame must close it
+    bool    render = false; // the runtime will show this frame: draw both eyes
+    EyeView eyes[2];
+    bool    submitted[2] = {};
+    // The game shows a scene through its own camera: draw the flat frame once (no eye) and hand it
+    // to SubmitCinema, for a still screen in a dark room, rather than both eyes.
+    bool    cinema = false;
+    bool    cinema_submitted = false;
+};
+
+// Waits for the runtime's next frame and places the eyes. False when no frame was begun (the
+// session is not running); a begun frame with render false is closed with EndFrame undrawn.
+bool BeginFrame(Frame &frame);
+// Copies the display image (the newest display render) into the eye's swapchain image.
+bool SubmitEye(Frame &frame, int eye);
+// Copies the display image into the cinema screen's swapchain image.
+bool SubmitCinema(Frame &frame);
+void EndFrame(Frame &frame);
+void Shutdown();
+
+// The hand controllers, either hand: a button is held when it is held on either, and the stick is
+// whichever is pushed further. Read at each headset frame; any thread may ask.
+struct Controls {
+    bool  active = false; // a controller is on and the game has the headset's focus
+    float stick_x = 0.0f; // -1 left to 1 right
+    float stick_y = 0.0f; // -1 down to 1 up
+    bool  trigger = false;
+    bool  grip = false;
+    bool  lower = false; // A on the right hand, X on the left
+    bool  upper = false; // B or Y
+    bool  stick = false; // the thumbstick pressed in
+    bool  menu = false;  // the left hand's menu button
+};
+Controls ReadControls();
+
+// The head's turn about the vertical from home, radians, positive to the left; any thread.
+float HeadYaw();
+
+// How strongly to close a dark ring in from the edges of the view, 0 to 1, for comfort while the
+// player moves without moving; it eases there over a few frames. Any thread.
+void SetVignette(float strength);
+
+// Whether the game is showing a scene through its own moving camera, which on a headset stands on
+// a still screen instead of all around the player. Set it every frame; it lapses when not set.
+// Any thread.
+void SetCinema(bool on);
+
+// The next headset frame also writes what each eye was given as <stem>_left.png and
+// <stem>_right.png (the display image the eye was drawn into, before scaling to the headset).
+void CaptureEyes(const std::string &stem);
+
+} // namespace gfx::xr
