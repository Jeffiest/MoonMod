+// The screen: 1.6 m by 1.2 m (the game's 4:3), 1.6 m ahead, about 53 degrees across, its centre
+// 0.3 m below the eyes so a talk's text sits under the one talking.
+constexpr float kScreenWidth = 1.6f;
+constexpr float kScreenHeight = 1.2f;
+constexpr float kScreenDistance = 1.6f;
+constexpr float kScreenDrop = 0.3f;
+constexpr float kScreenFollow = 0.6f; // radians the head turns away before the screen follows
+
+float Yaw(const XrQuaternionf &q) { return std::atan2(2 * (q.w * q.y + q.x * q.z), 1 - 2 * (q.y * q.y + q.x * q.x)); }
+
+float WrapAngle(float a) {
+    constexpr float kPi = 3.14159265f;
+    while (a > kPi) a -= 2 * kPi;
+    while (a < -kPi) a += 2 * kPi;
+    return a;
+}
+
+void TurnScreen(const XrPosef &head) {
+    const float yaw = Yaw(head.orientation);
+    if (!g_xr.screen_placed) {
+        g_xr.screen_yaw = g_xr.screen_target_yaw = yaw;
+        g_xr.screen_placed = true;
+    } else if (std::fabs(WrapAngle(yaw - g_xr.screen_yaw)) > kScreenFollow) {
+        g_xr.screen_target_yaw = yaw;
+    }
+    g_xr.screen_yaw += WrapAngle(g_xr.screen_target_yaw - g_xr.screen_yaw) * 0.12f;
+}
