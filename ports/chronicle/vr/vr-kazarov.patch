+
+bool XrStartSession() {
+    if (!g_xr.enabled) {
+        return false;
+    }
+    XrGraphicsBindingVulkan2KHR binding = {XR_TYPE_GRAPHICS_BINDING_VULKAN2_KHR};
+    binding.instance = g.instance;
+    binding.physicalDevice = g.physical_device;
+    binding.device = g.device;
+    binding.queueFamilyIndex = g.queue_family;
+    binding.queueIndex = 0;
+    XrSessionCreateInfo info = {XR_TYPE_SESSION_CREATE_INFO};
+    info.next = &binding;
+    info.systemId = g_xr.system;
+    XrReferenceSpaceCreateInfo local = {XR_TYPE_REFERENCE_SPACE_CREATE_INFO};
+    local.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_LOCAL;
+    local.poseInReferenceSpace = {{0, 0, 0, 1}, {0, 0, 0}};
+    XrReferenceSpaceCreateInfo view = local;
+    view.referenceSpaceType = XR_REFERENCE_SPACE_TYPE_VIEW;
+    if (!Ok(xrCreateSession(g_xr.instance, &info, &g_xr.session), "xrCreateSession") ||
+        !Ok(xrCreateReferenceSpace(g_xr.session, &local, &g_xr.space), "xrCreateReferenceSpace") ||
+        !Ok(xrCreateReferenceSpace(g_xr.session, &view, &g_xr.head), "xrCreateReferenceSpace") || !CreateEyes()) {
+        kz::Logf(kz::LogLevel::Warning, "xr", "no headset session; playing on the window");
+        Disable();
+        return false;
+    }
+    g.min_target_height = std::max(g_xr.eyes[0].height, g_xr.eyes[1].height);
+    if (!CreateVignette(g_xr.eyes[0].format)) {
+        kz::Logf(kz::LogLevel::Warning, "xr", "no comfort ring");
+        if (g_xr.vignette != XR_NULL_HANDLE) {
+            xrDestroySwapchain(g_xr.vignette);
+            g_xr.vignette = XR_NULL_HANDLE;
+        }
+    }
+    if (!CreateActions()) {
+        kz::Logf(kz::LogLevel::Warning, "xr", "no controller actions; the controllers will not play");
+    }
+    return true;
+}
+
+void XrStopSession() {
+    if (g_xr.session == XR_NULL_HANDLE) {
+        return;
+    }
+    if (g.device != VK_NULL_HANDLE) {
+        vkDeviceWaitIdle(g.device);
+    }
+    DestroyEyes();
+    if (g_xr.head != XR_NULL_HANDLE) {
+        xrDestroySpace(g_xr.head);
+    }
+    if (g_xr.space != XR_NULL_HANDLE) {
+        xrDestroySpace(g_xr.space);
+    }
+    if (g_xr.vignette != XR_NULL_HANDLE) {
+        xrDestroySwapchain(g_xr.vignette);
+        g_xr.vignette = XR_NULL_HANDLE;
+    }
+    if (g_xr.actions != XR_NULL_HANDLE) {
+        xrDestroyActionSet(g_xr.actions);
+        g_xr.actions = XR_NULL_HANDLE;
+    }
+    xrDestroySession(g_xr.session);
+    g_xr.session = XR_NULL_HANDLE;
+    g_xr.head = g_xr.space = XR_NULL_HANDLE;
+    g_xr.running = false;
+}
