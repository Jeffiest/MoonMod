+        ChronicleModVillager &mod = g_mod_villagers[index];
+        mod.slot = -1;
+        if (mod.name[0] == '\0' || mod.town_id != NowEditMap || MapNo > 10) {
+            continue;
+        }
+        int slot = 0;
+        while (slot < 10 && villagers[slot].name[0] != '\0') {
+            slot++;
