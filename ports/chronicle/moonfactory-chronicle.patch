+
+namespace {
+
+namespace fs = std::filesystem;
+
+struct TempRoot {
+    fs::path path = fs::temp_directory_path() /
+                    ("moonmod-input-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    ~TempRoot() {
+        std::error_code ignored;
+        fs::remove_all(path, ignored);
