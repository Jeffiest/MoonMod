+// Maze-mode ground probe: once per built floor, ask each cell's collision model
+// for floor polygons under the centre of the cell, the way the player's feet
+// gather them, and report cells a player could fall through.
+static void ProbeMazeGround(CDungeonMap *map) {
+    static int probed_seed = -1;
+    if (DngLayoutRooms <= 0 || map->map_seed == probed_seed) return;
+    probed_seed = map->map_seed;
+    static CCPoly polys[2000];
+    const float offsets[1][2] = {{0.0f, 0.0f}};
+    int holes = 0;
+    int kinds[96] = {};
+    for (int z = 0; z < DNG_GRID; z++) {
+        for (int x = 0; x < DNG_GRID; x++) {
+            const int parts_no = map->cells[x + z * DNG_GRID].parts_no;
+            if (parts_no < 0) continue;
+            CFrame *collision = map->parts[parts_no].collision;
+            int turn = map->cells[x + z * DNG_GRID].direction + map->parts[parts_no].collision_turn;
+            if (turn > 3) turn -= 3;
+            if (turn == 3) turn = -1;
+            int missing = 0;
+            for (const auto &offset : offsets) {
+                int ground = 0;
+                if (collision != nullptr) {
+                    collision->SetRotation(0.0f, PI * (-90.0f * turn) / 180.0f, 0.0f);
+                    collision->SetPosition(160.0f * x, 0.0f, 160.0f * z);
+                    CBoxVu0 bound;
+                    bound.max[0] = 160.0f * x + offset[0] + 2.0f;
+                    bound.max[1] = 20.0f;
+                    bound.max[2] = 160.0f * z + offset[1] + 2.0f;
+                    bound.min[0] = 160.0f * x + offset[0] - 2.0f;
+                    bound.min[1] = -40.0f;
+                    bound.min[2] = 160.0f * z + offset[1] - 2.0f;
+                    const int count = collision->PickUpNearPoly(polys, bound);
+                    for (int i = 0; i < count && i < 2000; i++) {
+                        if (std::fabs(polys[i].normal[1]) > 0.5f) ground++;
+                    }
+                }
+                if (ground == 0) missing++;
+            }
+            if (missing != 0) {
+                holes++;
+                if (parts_no < 96) kinds[parts_no]++;
+                if (holes <= 12) {
+                    std::printf("maze probe: cell %d,%d part %d dir %d has no ground at its centre%s\n", x, z,
+                                parts_no, map->cells[x + z * DNG_GRID].direction,
+                                collision == nullptr ? " (no collision model)" : "");
+                }
+            }
+        }
+    }
+    std::printf("maze probe: seed %d, %d cells with missing ground\n", map->map_seed, holes);
+    for (int k = 0; k < 96; k++) {
+        if (kinds[k] != 0) std::printf("maze probe: part %d -> %d cells\n", k, kinds[k]);
+    }
+    std::fflush(stdout);
+}
