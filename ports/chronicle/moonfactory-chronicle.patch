+namespace moonmod {
+namespace {
+
+constexpr std::size_t kManifestLimit = 256 * 1024;
+
+bool IsString(const Json &value, std::size_t limit) {
+    return value.is_string() && value.get_ref<const std::string &>().size() <= limit;
+}
+
+bool ReadString(const Json &object, const char *key, std::string &out, std::size_t limit, bool required,
+                std::string &error) {
+    const auto found = object.find(key);
+    if (found == object.end()) {
+        if (!required) {
+            return true;
+        }
+        error = std::string("missing required field '") + key + "'";
+        return false;
+    }
+    if (!IsString(*found, limit)) {
+        error = std::string("field '") + key + "' must be a string no longer than " + std::to_string(limit) + " bytes";
+        return false;
+    }
+    out = found->get<std::string>();
+    if (required && out.empty()) {
+        error = std::string("field '") + key + "' cannot be empty";
+        return false;
+    }
+    return true;
+}
+
+bool ReadStringList(const Json &object, const char *key, std::vector<std::string> &out, std::size_t max_count,
+                    bool required, std::string &error) {
+    const auto found = object.find(key);
+    if (found == object.end()) {
+        if (!required) {
+            return true;
+        }
+        error = std::string("missing required field '") + key + "'";
+        return false;
+    }
+    if (!found->is_array() || found->size() > max_count) {
+        error = std::string("field '") + key + "' must be an array with at most " + std::to_string(max_count) + " entries";
+        return false;
+    }
+    std::set<std::string> unique;
+    for (const Json &entry : *found) {
+        if (!IsString(entry, 96)) {
+            error = std::string("field '") + key + "' contains a non-string or oversized value";
+            return false;
+        }
+        const std::string value = entry.get<std::string>();
+        if (value.empty() || !unique.insert(value).second) {
+            error = std::string("field '") + key + "' contains an empty or duplicate value";
+            return false;
+        }
+        out.push_back(value);
+    }
+    return true;
+}
+
+bool RejectUnknownFields(const Json &object, std::initializer_list<std::string_view> allowed, std::string &error) {
+    for (auto item = object.begin(); item != object.end(); ++item) {
+        if (std::ranges::find(allowed, item.key()) == allowed.end()) {
+            error = "unknown field '" + item.key() + "'";
+            return false;
+        }
+    }
+    return true;
+}
+
+std::optional<SettingType> ParseSettingType(std::string_view value) {
+    if (value == "boolean") return SettingType::Boolean;
+    if (value == "integer") return SettingType::Integer;
+    if (value == "number") return SettingType::Number;
+    if (value == "string") return SettingType::String;
+    if (value == "choice") return SettingType::Choice;
+    return std::nullopt;
+}
+
+bool ValidSettingDefault(const SettingDefinition &setting) {
+    switch (setting.type) {
+        case SettingType::Boolean:
+            return setting.default_value.is_boolean();
+        case SettingType::Integer:
+            return setting.default_value.is_number_integer() && setting.minimum <= setting.maximum && setting.step > 0.0;
+        case SettingType::Number:
+            return setting.default_value.is_number() && std::isfinite(setting.default_value.get<double>()) &&
+                   setting.minimum <= setting.maximum && setting.step > 0.0;
+        case SettingType::String:
+            return setting.default_value.is_string() && setting.default_value.get_ref<const std::string &>().size() <= 256;
+        case SettingType::Choice:
+            return setting.default_value.is_string() &&
+                   std::ranges::find(setting.choices, setting.default_value.get<std::string>()) != setting.choices.end();
+    }
+    return false;
+}
+
+bool ReadSettings(const Json &object, std::vector<SettingDefinition> &settings, std::string &error) {
+    const auto found = object.find("settings");
+    if (found == object.end()) {
+        return true;
+    }
+    if (!found->is_array() || found->size() > 128) {
+        error = "field 'settings' must be an array with at most 128 entries";
+        return false;
+    }
+    std::set<std::string> ids;
+    for (const Json &value : *found) {
+        if (!value.is_object()) {
+            error = "each settings entry must be an object";
+            return false;
+        }
+        if (!RejectUnknownFields(value, {"id", "name", "description", "type", "default", "min", "max", "step", "choices"}, error)) {
+            return false;
+        }
+        SettingDefinition setting;
+        if (!ReadString(value, "id", setting.id, 64, true, error) ||
+            !ReadString(value, "name", setting.name, 96, true, error) ||
+            !ReadString(value, "description", setting.description, 512, false, error)) {
+            return false;
+        }
+        static const std::regex kSettingIdPattern("[a-z][a-z0-9._-]{0,63}");
+        if (!std::regex_match(setting.id, kSettingIdPattern) || !ids.insert(setting.id).second) {
+            error = "setting ids must be unique lowercase ids beginning with a letter";
+            return false;
+        }
+        std::string type;
+        if (!ReadString(value, "type", type, 16, true, error)) {
+            return false;
+        }
+        const auto parsed = ParseSettingType(type);
+        if (!parsed) {
+            error = "setting '" + setting.id + "' has an unknown type";
+            return false;
+        }
+        setting.type = *parsed;
+        const auto default_value = value.find("default");
+        if (default_value == value.end()) {
+            error = "setting '" + setting.id + "' is missing its default";
+            return false;
+        }
+        setting.default_value = *default_value;
+        const bool integer = setting.type == SettingType::Integer;
+        const double low_default = integer ? static_cast<double>(std::numeric_limits<std::int64_t>::min())
+                                           : std::numeric_limits<double>::lowest();
+        const double high_default = integer
+                                        ? std::nextafter(static_cast<double>(std::numeric_limits<std::int64_t>::max()), 0.0)
+                                        : std::numeric_limits<double>::max();
+        auto read_number = [&](const char *key, double &out, double fallback) {
+            const auto number = value.find(key);
+            out = fallback;
+            if (number == value.end()) return true;
+            if (!number->is_number() || !std::isfinite(number->get<double>())) return false;
+            out = number->get<double>();
+            return true;
+        };
+        if (!read_number("min", setting.minimum, low_default) || !read_number("max", setting.maximum, high_default) ||
+            !read_number("step", setting.step, 1.0)) {
+            error = "setting '" + setting.id + "' has a non-finite numeric bound";
+            return false;
+        }
+        if (integer && (std::trunc(setting.minimum) != setting.minimum ||
+                        std::trunc(setting.maximum) != setting.maximum ||
+                        static_cast<long double>(setting.minimum) <
+                            static_cast<long double>(std::numeric_limits<std::int64_t>::min()) ||
+                        static_cast<long double>(setting.maximum) >
+                            static_cast<long double>(std::numeric_limits<std::int64_t>::max()))) {
+            error = "integer setting '" + setting.id + "' bounds must be integral and fit a signed 64-bit value";
+            return false;
+        }
+        if (setting.type == SettingType::Choice) {
+            if (!ReadStringList(value, "choices", setting.choices, 32, true, error) || setting.choices.empty()) {
+                if (error.empty()) error = "choice setting '" + setting.id + "' must have at least one choice";
+                return false;
+            }
+        }
+        if (!ValidSettingDefault(setting)) {
+            error = "setting '" + setting.id + "' has a default that does not match its type or bounds";
+            return false;
+        }
+        if ((setting.type == SettingType::Integer || setting.type == SettingType::Number) &&
+            (setting.default_value.get<double>() < setting.minimum || setting.default_value.get<double>() > setting.maximum)) {
+            error = "setting '" + setting.id + "' default is outside its range";
+            return false;
+        }
+        settings.push_back(std::move(setting));
+    }
+    return true;
+}
+
+bool SafeRelativeEntry(std::string_view entry) {
+    if (entry.empty() || entry.size() > 128 || entry.find(':') != std::string_view::npos ||
+        entry.find('\\') != std::string_view::npos || entry.front() == '/' || entry.front() == '.') {
+        return false;
+    }
+    const std::filesystem::path path(entry);
+    if (path.is_absolute()) return false;
+    for (const auto &part : path) {
+        if (part == "." || part == "..") return false;
+    }
+    return path.extension() == ".lua";
+}
+
+bool SafeRelativeNativeLibrary(std::string_view entry) {
+    if (entry.empty() || entry.size() > 192 || entry.find(':') != std::string_view::npos ||
+        entry.find('\\') != std::string_view::npos || entry.front() == '/' || entry.front() == '.') {
+        return false;
+    }
+    const std::filesystem::path path(entry);
+    if (path.is_absolute()) return false;
+    for (const auto &part : path) {
+        if (part == "." || part == "..") return false;
+    }
+    const auto extension = path.extension().string();
+    return extension == ".dll" || extension == ".so" || extension == ".dylib";
+}
+
+bool IsWithin(const std::filesystem::path &root, const std::filesystem::path &path) {
+    const auto relative = path.lexically_relative(root);
+    if (relative.empty() || relative.is_absolute()) return false;
+    const auto first = relative.begin();
+    return first != relative.end() && *first != "..";
+}
+
+} // namespace
+
+bool IsValidModId(std::string_view id) {
+    if (id.size() < 3 || id.size() > 64) return false;
+    if (!(id.front() >= 'a' && id.front() <= 'z') && !(id.front() >= '0' && id.front() <= '9')) return false;
+    return std::ranges::all_of(id, [](char c) {
+        return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
+    });
+}
+
+std::optional<ModManifest> ReadManifest(const std::filesystem::path &package_root, std::string &error) {
+    error.clear();
+    std::error_code ec;
+    const auto canonical_root = std::filesystem::canonical(package_root, ec);
+    if (ec || !std::filesystem::is_directory(canonical_root, ec) || ec) {
+        error = "package directory is missing or unreadable";
+        return std::nullopt;
+    }
+    const auto manifest_file = std::filesystem::canonical(canonical_root / "mod.json", ec);
+    if (ec || !IsWithin(canonical_root, manifest_file) || !std::filesystem::is_regular_file(manifest_file, ec) || ec) {
+        error = "mod.json is missing";
+        return std::nullopt;
+    }
+    const auto size = std::filesystem::file_size(manifest_file, ec);
+    if (ec || size == 0 || size > kManifestLimit) {
+        error = "mod.json is empty, unreadable, or larger than 256 KiB";
+        return std::nullopt;
+    }
+    Json document;
+    try {
+        std::ifstream input(manifest_file, std::ios::binary);
+        if (!input) {
+            error = "mod.json could not be opened";
+            return std::nullopt;
+        }
+        input >> document;
+    } catch (const std::exception &exception) {
+        error = std::string("mod.json could not be parsed: ") + exception.what();
+        return std::nullopt;
+    }
+    if (!document.is_object()) {
+        error = "mod.json must contain one JSON object";
+        return std::nullopt;
+    }
+    if (!RejectUnknownFields(document, {"schema_version", "id", "name", "version", "author", "description",
+                                        "framework_api", "games", "entry", "dependencies", "optional_dependencies",
+                                        "load_after", "load_before", "permissions", "settings", "native_extension"}, error)) {
+        return std::nullopt;
+    }
+
+    ModManifest manifest;
+    manifest.package_root = canonical_root;
+    const auto schema = document.find("schema_version");
+    if (schema == document.end() || !schema->is_number_integer() || schema->get<int>() != 1) {
+        error = "schema_version must be 1";
+        return std::nullopt;
+    }
+    if (!ReadString(document, "id", manifest.id, 64, true, error) ||
+        !ReadString(document, "name", manifest.name, 96, true, error) ||
+        !ReadString(document, "version", manifest.version, 64, true, error) ||
+        !ReadString(document, "author", manifest.author, 96, false, error) ||
+        !ReadString(document, "description", manifest.description, 1024, false, error) ||
+        !ReadString(document, "entry", manifest.entry, 128, true, error)) {
+        return std::nullopt;
+    }
+    if (!IsValidModId(manifest.id)) {
+        error = "id must be 3-64 lowercase letters, digits, dots, underscores, or hyphens";
+        return std::nullopt;
+    }
+    static const std::regex kSemverPattern("[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?");
+    if (!std::regex_match(manifest.version, kSemverPattern)) {
+        error = "version must use semantic version form MAJOR.MINOR.PATCH";
+        return std::nullopt;
+    }
+    if (!SafeRelativeEntry(manifest.entry)) {
+        error = "entry must be a relative .lua file inside the package";
+        return std::nullopt;
+    }
+    const auto api = document.find("framework_api");
+    if (api == document.end() || !api->is_number_integer() || api->get<int>() < 1) {
+        error = "framework_api must be a positive integer";
+        return std::nullopt;
+    }
+    manifest.framework_api = api->get<int>();
+    if (!ReadStringList(document, "games", manifest.games, 2, true, error) ||
+        !ReadStringList(document, "dependencies", manifest.dependencies, 64, false, error) ||
+        !ReadStringList(document, "optional_dependencies", manifest.optional_dependencies, 64, false, error) ||
+        !ReadStringList(document, "load_after", manifest.load_after, 64, false, error) ||
+        !ReadStringList(document, "load_before", manifest.load_before, 64, false, error) ||
+        !ReadStringList(document, "permissions", manifest.permissions, 64, false, error) ||
+        !ReadSettings(document, manifest.settings, error)) {
+        return std::nullopt;
+    }
+    if (const auto native = document.find("native_extension"); native != document.end()) {
+        if (!native->is_object() || !RejectUnknownFields(*native, {"library"}, error)) {
+            if (error.empty()) error = "native_extension must be an object containing a library path";
+            return std::nullopt;
+        }
+        std::string library;
+        if (!ReadString(*native, "library", library, 192, true, error) || !SafeRelativeNativeLibrary(library)) {
+            if (error.empty()) error = "native_extension.library must be a safe relative .dll, .so, or .dylib path";
+            return std::nullopt;
+        }
+        if (std::ranges::find(manifest.permissions, "native.extension") == manifest.permissions.end()) {
+            error = "native_extension requires the native.extension manifest permission";
+            return std::nullopt;
+        }
+        std::error_code native_error;
+        manifest.native_library = std::filesystem::canonical(canonical_root / std::filesystem::path(library), native_error);
+        if (native_error || !IsWithin(canonical_root, manifest.native_library) ||
+            !std::filesystem::is_regular_file(manifest.native_library, native_error) || native_error) {
+            error = "native extension library is missing or escapes the package";
+            return std::nullopt;
+        }
+        const auto native_size = std::filesystem::file_size(manifest.native_library, native_error);
+        if (native_error || native_size == 0 || native_size > 256 * 1024 * 1024) {
+            error = "native extension library is empty, unreadable, or larger than 256 MiB";
+            return std::nullopt;
+        }
+    } else if (std::ranges::find(manifest.permissions, "native.extension") != manifest.permissions.end()) {
+        error = "native.extension permission requires a native_extension library declaration";
+        return std::nullopt;
+    }
+    for (const std::string &permission : manifest.permissions) {
+        if (!IsKnownPermission(permission)) {
+            error = "unsupported permission '" + permission + "' for framework API major 1";
+            return std::nullopt;
+        }
+    }
+    if (manifest.games.empty()) {
+        error = "games must contain at least one supported game id";
+        return std::nullopt;
+    }
+    for (const std::string &game : manifest.games) {
+        if (game != "chronicle" && game != "chronicle-two") {
+            error = "games may contain only 'chronicle' and 'chronicle-two'";
+            return std::nullopt;
+        }
+    }
+    for (const auto *ids : {&manifest.dependencies, &manifest.optional_dependencies,
+                            &manifest.load_after, &manifest.load_before}) {
+        for (const std::string &id : *ids) {
+            if (!IsValidModId(id)) {
+                error = "dependency and load-order references must use valid mod ids";
+                return std::nullopt;
+            }
+        }
+    }
+    manifest.entry_file = std::filesystem::canonical(canonical_root / std::filesystem::path(manifest.entry), ec);
+    if (ec || !IsWithin(canonical_root, manifest.entry_file) || !std::filesystem::is_regular_file(manifest.entry_file, ec) || ec) {
+        error = "entry script is missing";
+        return std::nullopt;
+    }
+    const auto entry_size = std::filesystem::file_size(manifest.entry_file, ec);
+    if (ec || entry_size == 0 || entry_size > 1024 * 1024) {
+        error = "entry script is empty, unreadable, or larger than 1 MiB";
+        return std::nullopt;
+    }
+    return manifest;
+}
+
+std::string SettingTypeName(SettingType type) {
+    switch (type) {
+        case SettingType::Boolean: return "boolean";
+        case SettingType::Integer: return "integer";
+        case SettingType::Number: return "number";
+        case SettingType::String: return "string";
+        case SettingType::Choice: return "choice";
+    }
+    return "unknown";
+}
+
+std::string SettingValueText(const SettingDefinition &setting, const Json &value) {
+    switch (setting.type) {
+        case SettingType::Boolean:
+            return value.is_boolean() && value.get<bool>() ? "On" : "Off";
+        case SettingType::Integer:
+            return value.is_number_integer() ? std::to_string(value.get<std::int64_t>()) : setting.default_value.dump();
+        case SettingType::Number:
+            return value.is_number() ? std::format("{:.6g}", value.get<double>()) : setting.default_value.dump();
+        case SettingType::String:
+            return value.is_string() ? value.get<std::string>() : setting.default_value.get<std::string>();
+        case SettingType::Choice:
+            return value.is_string() ? value.get<std::string>() : setting.default_value.get<std::string>();
+    }
+    return {};
+}
+
+} // namespace moonmod
diff --git a/port/src/moonmod/native_plugin_contract.cpp b/port/src/moonmod/native_plugin_contract.cpp
new file mode 100644
index 00000000..78a4d750
--- /dev/null
+++ b/port/src/moonmod/native_plugin_contract.cpp
@@ -0,0 +1,94 @@
+#include "moonmod/native_plugin_contract.hpp"
+
+#include <algorithm>
+#include <cstddef>
+#include <ranges>
+#include <string_view>
+
+#include "moonmod/api.hpp"
+
+namespace moonmod {
+namespace {
+
+constexpr std::size_t kMaximumNativePermissions = 32;
+
+bool ValidPluginId(std::string_view value) {
+    return !value.empty() && value.size() <= 64 &&
+           std::ranges::all_of(value, [](unsigned char character) {
+               return (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') ||
+                      (character >= '0' && character <= '9') || character == '.' || character == '_' ||
+                      character == '-';
+           });
+}
+
+constexpr std::size_t kRequiredPluginV1Size =
+    offsetof(MoonModNativePluginV1, unload) + sizeof(MoonModNativeUnloadV1);
+
+} // namespace
+
+NativePluginValidation ValidateNativePluginV1(const MoonModNativePluginV1 *plugin,
+                                               std::string_view expected_plugin_id,
+                                               std::uint32_t host_abi_major,
+                                               std::uint32_t host_abi_minor,
+                                               std::span<const std::string_view> manifest_permissions) {
+    if (plugin == nullptr) return NativePluginValidation::NullDescriptor;
+    if (plugin->struct_size < kRequiredPluginV1Size) return NativePluginValidation::IncompleteDescriptor;
+    if (plugin->abi_major != MOONMOD_NATIVE_ABI_MAJOR_V1) return NativePluginValidation::UnsupportedPluginAbi;
+    if (plugin->minimum_host_abi_major != host_abi_major ||
+        plugin->minimum_host_abi_minor > host_abi_minor) {
+        return NativePluginValidation::UnsupportedHostAbi;
+    }
+    if (plugin->plugin_id == nullptr || !ValidPluginId(plugin->plugin_id)) {
+        return NativePluginValidation::InvalidPluginId;
+    }
+    if (!ValidPluginId(expected_plugin_id) || std::string_view(plugin->plugin_id) != expected_plugin_id) {
+        return NativePluginValidation::PluginIdMismatch;
+    }
+    if (plugin->required_permission_count > kMaximumNativePermissions ||
+        (plugin->required_permission_count != 0 && plugin->required_permissions == nullptr)) {
+        return NativePluginValidation::InvalidPermissionList;
+    }
+    if (std::ranges::find(manifest_permissions, "native.extension") == manifest_permissions.end()) {
+        return NativePluginValidation::InvalidPermissionList;
+    }
+    for (std::uint32_t index = 0; index < plugin->required_permission_count; ++index) {
+        const char *permission = plugin->required_permissions[index];
+        if (permission == nullptr || !IsKnownPermission(permission)) {
+            return NativePluginValidation::UnknownPermission;
+        }
+        const std::string_view name(permission);
+        bool duplicate = false;
+        for (std::uint32_t previous = 0; previous < index; ++previous) {
+            if (plugin->required_permissions[previous] != nullptr &&
+                std::string_view(plugin->required_permissions[previous]) == name) {
+                duplicate = true;
+                break;
+            }
+        }
+        if (std::ranges::find(manifest_permissions, name) == manifest_permissions.end() || duplicate) {
+            return NativePluginValidation::InvalidPermissionList;
+        }
+    }
+    if (plugin->load == nullptr) return NativePluginValidation::MissingLoadCallback;
+    if (plugin->unload == nullptr) return NativePluginValidation::MissingUnloadCallback;
+    return NativePluginValidation::Valid;
+}
+
+std::string_view NativePluginValidationMessage(NativePluginValidation validation) {
+    switch (validation) {
+        case NativePluginValidation::Valid: return "native plugin descriptor is compatible";
+        case NativePluginValidation::NullDescriptor: return "native plugin entry returned a null descriptor";
+        case NativePluginValidation::IncompleteDescriptor: return "native plugin descriptor is smaller than ABI v1";
+        case NativePluginValidation::UnsupportedPluginAbi: return "native plugin ABI major is not supported";
+        case NativePluginValidation::UnsupportedHostAbi: return "native plugin requires a newer or different host ABI";
+        case NativePluginValidation::PluginIdMismatch: return "native plugin id does not match its package declaration";
+        case NativePluginValidation::InvalidPluginId: return "native plugin id is invalid";
+        case NativePluginValidation::InvalidPermissionList: return "native plugin permissions are invalid or undeclared";
+        case NativePluginValidation::UnknownPermission: return "native plugin requests an unknown permission";
+        case NativePluginValidation::MissingLoadCallback: return "native plugin does not export a load callback";
+        case NativePluginValidation::MissingUnloadCallback: return "native plugin does not export an unload callback";
+    }
+    return "native plugin descriptor validation failed";
+}
+
+} // namespace moonmod
diff --git a/port/src/moonmod/native_plugin_hash.cpp b/port/src/moonmod/native_plugin_hash.cpp
new file mode 100644
index 00000000..5f91b7ae
--- /dev/null
+++ b/port/src/moonmod/native_plugin_hash.cpp
@@ -0,0 +1,116 @@
+#include "moonmod/native_plugin_hash.hpp"
+
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <fstream>
+
+namespace moonmod {
+namespace {
+
+class Sha256 {
+public:
+    void Update(const char *data, std::size_t size) {
+        total_bits_ += static_cast<std::uint64_t>(size) * 8;
+        for (std::size_t index = 0; index < size; ++index) {
+            block_[block_size_++] = static_cast<unsigned char>(data[index]);
+            if (block_size_ == block_.size()) {
+                Transform();
+                block_size_ = 0;
+            }
+        }
+    }
+
+    std::string Finish() {
+        const std::uint64_t message_bits = total_bits_;
+        block_[block_size_++] = 0x80;
+        if (block_size_ > 56) {
+            while (block_size_ < block_.size()) block_[block_size_++] = 0;
+            Transform();
+            block_size_ = 0;
+        }
+        while (block_size_ < 56) block_[block_size_++] = 0;
+        for (int index = 7; index >= 0; --index) {
+            block_[56 + static_cast<std::size_t>(7 - index)] =
+                static_cast<unsigned char>((message_bits >> (index * 8)) & 0xff);
+        }
+        Transform();
+
+        constexpr char digits[] = "0123456789abcdef";
+        std::string result;
+        result.reserve(64);
+        for (const std::uint32_t value : state_) {
+            for (int shift = 28; shift >= 0; shift -= 4) result.push_back(digits[(value >> shift) & 0xf]);
+        }
+        return result;
+    }
+
+private:
+    static constexpr std::array<std::uint32_t, 64> kRound = {
+        0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
+        0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
+        0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu, 0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
+        0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
+        0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
+        0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
+        0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
+        0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u};
+
+    void Transform() {
+        std::array<std::uint32_t, 64> words{};
+        for (std::size_t index = 0; index < 16; ++index) {
+            words[index] = (static_cast<std::uint32_t>(block_[index * 4]) << 24) |
+                           (static_cast<std::uint32_t>(block_[index * 4 + 1]) << 16) |
+                           (static_cast<std::uint32_t>(block_[index * 4 + 2]) << 8) |
+                           static_cast<std::uint32_t>(block_[index * 4 + 3]);
+        }
+        for (std::size_t index = 16; index < words.size(); ++index) {
+            const std::uint32_t x = words[index - 15], y = words[index - 2];
+            const std::uint32_t s0 = std::rotr(x, 7) ^ std::rotr(x, 18) ^ (x >> 3);
+            const std::uint32_t s1 = std::rotr(y, 17) ^ std::rotr(y, 19) ^ (y >> 10);
+            words[index] = words[index - 16] + s0 + words[index - 7] + s1;
+        }
+        std::uint32_t a = state_[0], b = state_[1], c = state_[2], d = state_[3];
+        std::uint32_t e = state_[4], f = state_[5], g = state_[6], h = state_[7];
+        for (std::size_t index = 0; index < words.size(); ++index) {
+            const std::uint32_t sum1 = std::rotr(e, 6) ^ std::rotr(e, 11) ^ std::rotr(e, 25);
+            const std::uint32_t choice = (e & f) ^ (~e & g);
+            const std::uint32_t temporary1 = h + sum1 + choice + kRound[index] + words[index];
+            const std::uint32_t sum0 = std::rotr(a, 2) ^ std::rotr(a, 13) ^ std::rotr(a, 22);
+            const std::uint32_t majority = (a & b) ^ (a & c) ^ (b & c);
+            const std::uint32_t temporary2 = sum0 + majority;
+            h = g; g = f; f = e; e = d + temporary1;
+            d = c; c = b; b = a; a = temporary1 + temporary2;
+        }
+        state_[0] += a; state_[1] += b; state_[2] += c; state_[3] += d;
+        state_[4] += e; state_[5] += f; state_[6] += g; state_[7] += h;
+    }
+
+    std::array<std::uint32_t, 8> state_ = {0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au,
+                                           0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u};
+    std::array<unsigned char, 64> block_{};
+    std::size_t block_size_ = 0;
+    std::uint64_t total_bits_ = 0;
+};
+
+} // namespace
+
+std::string NativePluginFileSha256(const std::filesystem::path &path) {
+    constexpr std::uintmax_t kMaximumTrustedLibrarySize = 256 * 1024 * 1024;
+    std::error_code ec;
+    const auto size = std::filesystem::file_size(path, ec);
+    if (ec || size == 0 || size > kMaximumTrustedLibrarySize) return {};
+    std::ifstream input(path, std::ios::binary);
+    if (!input) return {};
+    Sha256 hash;
+    std::array<char, 64 * 1024> buffer{};
+    while (input) {
+        input.read(buffer.data(), static_cast<std::streamsize>(buffer.size()));
+        const auto count = input.gcount();
+        if (count > 0) hash.Update(buffer.data(), static_cast<std::size_t>(count));
+    }
+    if (!input.eof()) return {};
+    return hash.Finish();
+}
+
+} // namespace moonmod
diff --git a/port/src/moonmod/native_plugin_loader.cpp b/port/src/moonmod/native_plugin_loader.cpp
new file mode 100644
index 00000000..82cdf697
--- /dev/null
+++ b/port/src/moonmod/native_plugin_loader.cpp
@@ -0,0 +1,382 @@
+#include "moonmod/native_plugin_loader.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <map>
+#include <ranges>
+#include <string_view>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include "moonmod/native_plugin_contract.hpp"
+
+#if defined(_WIN32)
+#define NOMINMAX
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+namespace moonmod {
+namespace {
+
+constexpr std::size_t kNativeStringLimit = 4096;
+constexpr std::size_t kNativeJsonLimit = 64 * 1024;
+constexpr std::size_t kNativeEventLimit = 128;
+
+bool ReadCString(const char *value, std::size_t limit, std::string_view &out) {
+    if (value == nullptr) return false;
+    std::size_t size = 0;
+    while (size <= limit && value[size] != '\0') ++size;
+    if (size > limit) return false;
+    out = std::string_view(value, size);
+    return true;
+}
+
+MoonModNativeStatusV1 WriteBuffer(MoonModNativeBufferV1 *buffer, std::string_view value) {
+    if (buffer == nullptr || (buffer->capacity != 0 && buffer->data == nullptr)) {
+        return MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+    }
+    if (value.size() > UINT32_MAX) return MOONMOD_NATIVE_FAILED_V1;
+    buffer->length = static_cast<std::uint32_t>(value.size());
+    if (buffer->capacity <= value.size()) return MOONMOD_NATIVE_BUFFER_TOO_SMALL_V1;
+    if (!value.empty()) std::memcpy(buffer->data, value.data(), value.size());
+    buffer->data[value.size()] = '\0';
+    return MOONMOD_NATIVE_OK_V1;
+}
+
+MoonModNativeStatusV1 ToNativeStatus(ApiCallStatus status) {
+    switch (status) {
+        case ApiCallStatus::Ok: return MOONMOD_NATIVE_OK_V1;
+        case ApiCallStatus::Unsupported: return MOONMOD_NATIVE_UNSUPPORTED_V1;
+        case ApiCallStatus::InvalidArgument: return MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+        case ApiCallStatus::PermissionDenied: return MOONMOD_NATIVE_PERMISSION_DENIED_V1;
+        case ApiCallStatus::PhaseViolation:
+        case ApiCallStatus::Failed: return MOONMOD_NATIVE_FAILED_V1;
+    }
+    return MOONMOD_NATIVE_FAILED_V1;
+}
+
+std::string PlatformName() {
+#if defined(_WIN32) && defined(_M_X64)
+    return "windows-x64";
+#elif defined(_WIN32) && defined(_M_ARM64)
+    return "windows-arm64";
+#elif defined(_WIN32)
+    return "windows-x86";
+#elif defined(__APPLE__) && defined(__aarch64__)
+    return "macos-arm64";
+#elif defined(__APPLE__)
+    return "macos-x64";
+#elif defined(__aarch64__)
+    return "linux-arm64";
+#elif defined(__x86_64__)
+    return "linux-x64";
+#else
+    return "unknown";
+#endif
+}
+
+} // namespace
+
+struct NativePluginInstance::Impl {
+    struct Subscription {
+        std::string event_name;
+        MoonModNativeEventCallbackV1 callback = nullptr;
+        void *user_data = nullptr;
+    };
+
+    NativePluginLoadConfig config;
+    std::vector<std::string> granted_permissions;
+    std::map<std::uint64_t, Subscription> subscriptions;
+    std::uint64_t next_subscription = 1;
+    std::thread::id game_thread;
+    MoonModNativeHostV1 host{};
+    const MoonModNativePluginV1 *plugin = nullptr;
+    void *plugin_state = nullptr;
+    bool load_attempted = false;
+    bool loaded = false;
+#if defined(_WIN32)
+    HMODULE library = nullptr;
+#else
+    void *library = nullptr;
+#endif
+
+    bool HasPermission(std::string_view permission) const {
+        return std::ranges::find(granted_permissions, permission) != granted_permissions.end();
+    }
+
+    bool OnGameThread() const { return std::this_thread::get_id() == game_thread; }
+
+    static Impl *From(void *context) { return static_cast<Impl *>(context); }
+
+    static MoonModNativeStatusV1 HostLog(void *context, const char *level, const char *message) {
+        Impl *self = From(context);
+        if (self == nullptr || (!self->loaded && !self->load_attempted)) return MOONMOD_NATIVE_FAILED_V1;
+        if (!self->OnGameThread()) return MOONMOD_NATIVE_FAILED_V1;
+        if (!self->HasPermission("native.extension")) return MOONMOD_NATIVE_PERMISSION_DENIED_V1;
+        std::string_view parsed_level, parsed_message;
+        if (!ReadCString(level, 16, parsed_level) || !ReadCString(message, kNativeStringLimit, parsed_message) ||
+            parsed_message.empty()) return MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+        if (parsed_level != "debug" && parsed_level != "info" && parsed_level != "warning" && parsed_level != "error") {
+            return MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+        }
+        if (self->config.log) self->config.log(parsed_level, self->config.plugin_id, parsed_message);
+        return MOONMOD_NATIVE_OK_V1;
+    }
+
+    const ApiCapability *Capability(std::string_view path) const {
+        const auto found = std::ranges::find(config.api_capabilities, path, &ApiCapability::path);
+        return found == config.api_capabilities.end() ? nullptr : &*found;
+    }
+
+    bool OperationPermissionGranted(const ApiOperationSpec &operation) const {
+        return operation.permission.empty() || HasPermission(operation.permission);
+    }
+
+    static MoonModNativeStatusV1 HostApiSupports(void *context, const char *path, int32_t *supported,
+                                                  MoonModNativeBufferV1 *reason) {
+        Impl *self = From(context);
+        if (self == nullptr || !self->OnGameThread()) return MOONMOD_NATIVE_FAILED_V1;
+        std::string_view parsed_path;
+        if (!ReadCString(path, 256, parsed_path) || parsed_path.empty() || supported == nullptr || reason == nullptr) {
+            return MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+        }
+        const ApiOperationSpec *operation = FindApiOperation(parsed_path);
+        if (operation == nullptr) return MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+        if (!self->OperationPermissionGranted(*operation)) {
+            *supported = 0;
+            WriteBuffer(reason, "native extension did not declare the operation permission");
+            return MOONMOD_NATIVE_PERMISSION_DENIED_V1;
+        }
+        const ApiCapability *capability = self->Capability(parsed_path);
+        if (capability == nullptr) {
+            *supported = 0;
+            return WriteBuffer(reason, "this game adapter does not advertise the operation");
+        }
+        *supported = capability->supported ? 1 : 0;
+        return WriteBuffer(reason, capability->reason);
+    }
+
+    static MoonModNativeStatusV1 HostApiCall(void *context, const char *path, const char *arguments_json,
+                                             MoonModNativeBufferV1 *result_json,
+                                             MoonModNativeBufferV1 *error_json) {
+        Impl *self = From(context);
+        if (self == nullptr || !self->OnGameThread()) return MOONMOD_NATIVE_FAILED_V1;
+        std::string_view parsed_path, parsed_arguments;
+        if (!ReadCString(path, 256, parsed_path) || parsed_path.empty() ||
+            !ReadCString(arguments_json, kNativeJsonLimit, parsed_arguments) || result_json == nullptr ||
+            error_json == nullptr || !self->config.api_handler) return MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+        const ApiOperationSpec *operation = FindApiOperation(parsed_path);
+        if (operation == nullptr) return MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+        if (!self->OperationPermissionGranted(*operation)) {
+            WriteBuffer(error_json, Json{{"code", "permission_denied"},
+                                        {"message", "native extension did not declare the operation permission"}}.dump());
+            return MOONMOD_NATIVE_PERMISSION_DENIED_V1;
+        }
+        const ApiCapability *capability = self->Capability(parsed_path);
+        if (capability == nullptr || !capability->supported) {
+            const std::string reason = capability == nullptr ? "this game adapter does not advertise the operation"
+                                                              : capability->reason;
+            WriteBuffer(error_json, Json{{"code", "unsupported"}, {"message", reason}}.dump());
+            return MOONMOD_NATIVE_UNSUPPORTED_V1;
+        }
+        try {
+            const Json arguments = Json::parse(parsed_arguments);
+            if (!arguments.is_array()) return MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+            const ApiCallResult result = self->config.api_handler(self->config.plugin_id, *operation, arguments);
+            if (result.status == ApiCallStatus::Ok) {
+                const std::string serialized = result.value.dump();
+                const MoonModNativeStatusV1 written = WriteBuffer(result_json, serialized);
+                WriteBuffer(error_json, "");
+                return written;
+            }
+            WriteBuffer(result_json, "");
+            const std::string failure = Json{{"code", ApiCallStatusName(result.status)},
+                                             {"message", result.message}}.dump();
+            const MoonModNativeStatusV1 error_written = WriteBuffer(error_json, failure);
+            if (error_written != MOONMOD_NATIVE_OK_V1) return error_written;
+            return ToNativeStatus(result.status);
+        } catch (const std::exception &) {
+            WriteBuffer(error_json, Json{{"code", "invalid_argument"}, {"message", "arguments are not valid JSON"}}.dump());
+            return MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+        }
+    }
+
+    static MoonModNativeStatusV1 HostSubscribe(void *context, const char *event_name,
+                                               MoonModNativeEventCallbackV1 callback, void *user_data,
+                                               uint64_t *subscription_id) {
+        Impl *self = From(context);
+        if (self == nullptr || !self->OnGameThread()) return MOONMOD_NATIVE_FAILED_V1;
+        std::string_view parsed_name;
+        if (!ReadCString(event_name, 128, parsed_name) || parsed_name.empty() || callback == nullptr ||
+            subscription_id == nullptr) return MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+        if (!self->HasPermission("game.read")) return MOONMOD_NATIVE_PERMISSION_DENIED_V1;
+        if (self->subscriptions.size() >= kNativeEventLimit || self->next_subscription == 0) {
+            return MOONMOD_NATIVE_FAILED_V1;
+        }
+        const std::uint64_t id = self->next_subscription++;
+        self->subscriptions.emplace(id, Subscription{std::string(parsed_name), callback, user_data});
+        *subscription_id = id;
+        return MOONMOD_NATIVE_OK_V1;
+    }
+
+    static MoonModNativeStatusV1 HostUnsubscribe(void *context, uint64_t subscription_id) {
+        Impl *self = From(context);
+        if (self == nullptr || !self->OnGameThread()) return MOONMOD_NATIVE_FAILED_V1;
+        return self->subscriptions.erase(subscription_id) == 1 ? MOONMOD_NATIVE_OK_V1
+                                                                : MOONMOD_NATIVE_INVALID_ARGUMENT_V1;
+    }
+
+    void Publish(std::string_view event_name, const Json &payload, std::uint64_t frame) {
+        if (!loaded || !OnGameThread()) return;
+        const std::string name(event_name);
+        const std::string serialized = payload.dump();
+        if (serialized.size() > kNativeJsonLimit) return;
+        std::vector<std::pair<std::uint64_t, Subscription>> snapshot;
+        for (const auto &[id, subscription] : subscriptions) {
+            if (subscription.event_name == event_name) snapshot.emplace_back(id, subscription);
+        }
+        for (const auto &[id, subscription] : snapshot) {
+            if (!subscriptions.contains(id)) continue;
+            try {
+                subscription.callback(name.c_str(), serialized.c_str(), frame, subscription.user_data);
+            } catch (...) {
+                if (config.log) config.log("error", config.plugin_id, "native event callback threw across the ABI boundary");
+            }
+        }
+    }
+
+    void CloseLibrary() {
+        if (library == nullptr) return;
+#if defined(_WIN32)
+        FreeLibrary(library);
+#else
+        dlclose(library);
+#endif
+        library = nullptr;
+    }
+};
+
+NativePluginInstance::NativePluginInstance() : impl_(std::make_unique<Impl>()) {}
+NativePluginInstance::~NativePluginInstance() { Unload(); }
+
+bool NativePluginInstance::Load(NativePluginLoadConfig config, std::string &error) {
+    Unload();
+    error.clear();
+    impl_->config = std::move(config);
+    impl_->game_thread = std::this_thread::get_id();
+    impl_->granted_permissions.clear();
+    impl_->subscriptions.clear();
+    impl_->next_subscription = 1;
+    if (impl_->config.platform.empty()) impl_->config.platform = PlatformName();
+
+#if defined(_WIN32)
+    impl_->library = LoadLibraryExW(impl_->config.library.c_str(), nullptr,
+                                    LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+    if (impl_->library == nullptr) {
+        error = "native extension library could not be loaded by Windows";
+        return false;
+    }
+    const auto entry = reinterpret_cast<MoonModGetNativePluginV1>(
+        GetProcAddress(impl_->library, MOONMOD_NATIVE_PLUGIN_ENTRY_NAME_V1));
+#else
+    impl_->library = dlopen(impl_->config.library.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (impl_->library == nullptr) {
+        const char *reason = dlerror();
+        error = reason == nullptr ? "native extension library could not be loaded" : reason;
+        return false;
+    }
+    const auto entry = reinterpret_cast<MoonModGetNativePluginV1>(
+        dlsym(impl_->library, MOONMOD_NATIVE_PLUGIN_ENTRY_NAME_V1));
+#endif
+    if (entry == nullptr) {
+        error = "native extension does not export MoonMod_GetNativePluginV1";
+        impl_->CloseLibrary();
+        return false;
+    }
+    try {
+        impl_->plugin = entry();
+    } catch (...) {
+        error = "native extension entry point threw across the ABI boundary";
+        impl_->plugin = nullptr;
+        impl_->CloseLibrary();
+        return false;
+    }
+    std::vector<std::string_view> declared;
+    declared.reserve(impl_->config.manifest_permissions.size());
+    for (const auto &permission : impl_->config.manifest_permissions) declared.push_back(permission);
+    const NativePluginValidation validation = ValidateNativePluginV1(impl_->plugin, impl_->config.plugin_id, 1, 0, declared);
+    if (validation != NativePluginValidation::Valid) {
+        error = std::string(NativePluginValidationMessage(validation));
+        impl_->plugin = nullptr;
+        impl_->CloseLibrary();
+        return false;
+    }
+    for (std::uint32_t i = 0; i < impl_->plugin->required_permission_count; ++i) {
+        impl_->granted_permissions.emplace_back(impl_->plugin->required_permissions[i]);
+    }
+    impl_->host.struct_size = sizeof(MoonModNativeHostV1);
+    impl_->host.abi_major = MOONMOD_NATIVE_ABI_MAJOR_V1;
+    impl_->host.abi_minor = MOONMOD_NATIVE_ABI_MINOR_V1;
+    impl_->host.context = impl_.get();
+    impl_->host.game_id = impl_->config.game_id.c_str();
+    impl_->host.build_id = impl_->config.build_id.c_str();
+    impl_->host.platform = impl_->config.platform.c_str();
+    impl_->host.log = Impl::HostLog;
+    impl_->host.api_supports = Impl::HostApiSupports;
+    impl_->host.api_call_json = Impl::HostApiCall;
+    impl_->host.subscribe = Impl::HostSubscribe;
+    impl_->host.unsubscribe = Impl::HostUnsubscribe;
+    std::array<char, 512> error_buffer{};
+    MoonModNativeBufferV1 message{error_buffer.data(), static_cast<std::uint32_t>(error_buffer.size()), 0};
+    impl_->load_attempted = true;
+    MoonModNativeStatusV1 status = MOONMOD_NATIVE_FAILED_V1;
+    try {
+        status = impl_->plugin->load(&impl_->host, &impl_->plugin_state, &message);
+    } catch (...) {
+        error = "native extension load callback threw across the ABI boundary";
+    }
+    impl_->load_attempted = false;
+    if (status != MOONMOD_NATIVE_OK_V1 || !error.empty()) {
+        if (message.data != nullptr && message.length > 0) {
+            error.assign(message.data, std::min<std::size_t>(message.length, error_buffer.size() - 1));
+        }
+        if (error.empty()) error = "native extension load callback failed with status " + std::to_string(status);
+        impl_->plugin = nullptr;
+        impl_->plugin_state = nullptr;
+        impl_->subscriptions.clear();
+        impl_->CloseLibrary();
+        return false;
+    }
+    impl_->loaded = true;
+    return true;
+}
+
+void NativePluginInstance::Publish(std::string_view event_name, const Json &payload, std::uint64_t frame) {
+    impl_->Publish(event_name, payload, frame);
+}
+
+void NativePluginInstance::Unload() {
+    if (!impl_) return;
+    if (impl_->loaded && impl_->plugin != nullptr && impl_->library != nullptr) {
+        try { impl_->plugin->unload(&impl_->host, impl_->plugin_state); } catch (...) {}
+    }
+    impl_->loaded = false;
+    impl_->load_attempted = false;
+    impl_->subscriptions.clear();
+    impl_->plugin = nullptr;
+    impl_->plugin_state = nullptr;
+    impl_->granted_permissions.clear();
+    impl_->CloseLibrary();
+}
+
+bool NativePluginInstance::Loaded() const { return impl_ && impl_->loaded; }
+std::string_view NativePluginInstance::PluginId() const {
+    return impl_ ? std::string_view(impl_->config.plugin_id) : std::string_view{};
+}
+
+} // namespace moonmod
diff --git a/port/src/moonmod/native_resource_overrides.cpp b/port/src/moonmod/native_resource_overrides.cpp
new file mode 100644
index 00000000..7623d8cb
--- /dev/null
+++ b/port/src/moonmod/native_resource_overrides.cpp
@@ -0,0 +1,358 @@
+#include "moonmod/native_resource_overrides.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <initializer_list>
+#include <limits>
+#include <map>
+#include <mutex>
+#include <ranges>
+#include <string>
+#include <system_error>
+
+namespace moonmod {
+namespace {
+
+constexpr std::size_t kPerModOverrideLimit = 64;
+constexpr std::size_t kGlobalOverrideLimit = 512;
+constexpr std::uintmax_t kOverrideFileSizeLimit = 128ull * 1024ull * 1024ull;
+constexpr std::uintmax_t kMapAliasOverrideSizeLimit = 8ull * 1024ull * 1024ull;
+
+struct OverrideRecord {
+    std::string owner;
+    std::string resource_path;
+    std::filesystem::path file;
+    std::uintmax_t size = 0;
+    bool persistent = false;
+    bool pinned_by_alias = false;
+    std::filesystem::file_time_type written{};
+};
+
+struct ResourcePathAlias {
+    std::string owner;
+    std::string target_prefix;
+    std::string source_prefix;
+};
+
+std::mutex g_override_mutex;
+std::map<std::string, OverrideRecord, std::less<>> g_overrides;
+std::map<std::string, ResourcePathAlias, std::less<>> g_path_aliases;
+
+bool IsPathBelowPrefix(std::string_view path, std::string_view prefix) {
+    return path.size() > prefix.size() && path.starts_with(prefix) && path[prefix.size()] == '/';
+}
+
+bool IsChronicleMapDirectory(std::string_view path, bool target) {
+    if (path.size() != 9 || !path.starts_with("gedit/s") || path[7] < '0' || path[7] > '9' ||
+        path[8] < '0' || path[8] > '9') {
+        return false;
+    }
+    const int directory_id = (path[7] - '0') * 10 + (path[8] - '0');
+    return target ? directory_id >= 60 && directory_id <= 69 : directory_id < 70;
+}
+
+bool HasOnlyFields(const Json &object, std::initializer_list<std::string_view> fields) {
+    for (auto field = object.begin(); field != object.end(); ++field) {
+        if (std::ranges::find(fields, field.key()) == fields.end()) return false;
+    }
+    return true;
+}
+
+bool NormalizeGamePath(std::string_view input, std::string &normalized) {
+    if (input.empty() || input.size() > 240) return false;
+    normalized.clear();
+    normalized.reserve(input.size());
+    std::string component;
+    for (unsigned char character : input) {
+        if (character < 0x21 || character > 0x7e || character == ':' || character == '*' || character == '?' ||
+            character == '"' || character == '<' || character == '>' || character == '|') {
+            return false;
+        }
+        if (character == '/' || character == '\\') {
+            if (component.empty() || component == "." || component == "..") return false;
+            normalized.push_back('/');
+            component.clear();
+            continue;
+        }
+        const char folded = character >= 'A' && character <= 'Z'
+                                ? static_cast<char>(character + ('a' - 'A'))
+                                : static_cast<char>(character);
+        normalized.push_back(folded);
+        component.push_back(folded);
+    }
+    return !component.empty() && component != "." && component != ".." && normalized.front() != '/' &&
+           normalized.back() != '/';
+}
+
+bool ValidResourcePath(std::string_view input, std::filesystem::path &relative) {
+    if (input.size() < 11 || input.size() > 240 || !input.starts_with("resources/") ||
+        std::ranges::any_of(input, [](unsigned char character) {
+            return character < 0x20 || character == '\\' || character == ':' || character == '*' ||
+                   character == '?' || character == '"' || character == '<' || character == '>' ||
+                   character == '|';
+        })) {
+        return false;
+    }
+    relative = std::filesystem::path(input);
+    return !relative.is_absolute() && !relative.has_root_name() && !relative.has_root_directory() &&
+           !std::ranges::any_of(relative, [](const std::filesystem::path &part) {
+               return part.empty() || part == "." || part == "..";
+           });
+}
+
+bool ContainsSymlink(const std::filesystem::path &path) {
+    std::filesystem::path current = path.root_path();
+    for (const auto &part : path.relative_path()) {
+        if (part.empty() || part == ".") continue;
+        current /= part;
+        std::error_code error;
+        const auto status = std::filesystem::symlink_status(current, error);
+        if (error && error != std::errc::no_such_file_or_directory) return true;
+        if (!error && std::filesystem::is_symlink(status)) return true;
+    }
+    return false;
+}
+
+} // namespace
+
+ApiCallResult RegisterNativeResourceOverride(std::string_view owner, const std::filesystem::path &package_root,
+                                             const Json &arguments) {
+    if (owner.empty() || !arguments.is_array() || arguments.size() != 1 || !arguments[0].is_object() ||
+        arguments[0].size() != 2 || !HasOnlyFields(arguments[0], {"path", "game_path"})) {
+        return {ApiCallStatus::InvalidArgument, nullptr,
+                "expected {path = package resource path, game_path = native asset path}"};
+    }
+    const Json &definition = arguments[0];
+    const auto path_field = definition.find("path");
+    const auto game_path_field = definition.find("game_path");
+    if (path_field == definition.end() || !path_field->is_string() || game_path_field == definition.end() ||
+        !game_path_field->is_string()) {
+        return {ApiCallStatus::InvalidArgument, nullptr,
+                "path and game_path must be strings"};
+    }
+    const std::string &resource_path = path_field->get_ref<const std::string &>();
+    const std::string &raw_game_path = game_path_field->get_ref<const std::string &>();
+    std::filesystem::path relative_path;
+    std::string game_path;
+    if (!ValidResourcePath(resource_path, relative_path)) {
+        return {ApiCallStatus::InvalidArgument, nullptr,
+                "path must be a safe package-relative file below resources/"};
+    }
+    if (!NormalizeGamePath(raw_game_path, game_path)) {
+        return {ApiCallStatus::InvalidArgument, nullptr,
+                "game_path must be a normalized relative native asset path without traversal segments"};
+    }
+
+    std::error_code error;
+    const std::filesystem::path canonical_root = std::filesystem::canonical(package_root, error);
+    if (error || ContainsSymlink(package_root)) {
+        return {ApiCallStatus::Failed, nullptr, "mod package path is missing or contains a symbolic link"};
+    }
+    const std::filesystem::path candidate = package_root / relative_path;
+    if (ContainsSymlink(candidate)) {
+        return {ApiCallStatus::Failed, nullptr, "resource path contains a symbolic link"};
+    }
+    const std::filesystem::path resolved = std::filesystem::canonical(candidate, error);
+    if (error) return {ApiCallStatus::Failed, nullptr, "resource file could not be resolved"};
+    const std::filesystem::path within_package = resolved.lexically_relative(canonical_root);
+    if (within_package.empty() || within_package.is_absolute() ||
+        (!within_package.empty() && *within_package.begin() == "..")) {
+        return {ApiCallStatus::Failed, nullptr, "resource resolves outside this mod package"};
+    }
+    if (!std::filesystem::is_regular_file(resolved, error) || error) {
+        return {ApiCallStatus::Failed, nullptr, "resource path is not a regular file"};
+    }
+    const std::uintmax_t size = std::filesystem::file_size(resolved, error);
+    if (error) return {ApiCallStatus::Failed, nullptr, "resource size could not be read"};
+    if (size == 0 || size > kOverrideFileSizeLimit ||
+        size > static_cast<std::uintmax_t>(std::numeric_limits<std::int32_t>::max())) {
+        return {ApiCallStatus::InvalidArgument, nullptr,
+                "native replacement resources must contain 1 byte through 128 MiB"};
+    }
+
+    std::lock_guard lock(g_override_mutex);
+    const auto path_alias = std::ranges::find_if(g_path_aliases, [&game_path](const auto &entry) {
+        return IsPathBelowPrefix(game_path, entry.first);
+    });
+    if (path_alias != g_path_aliases.end()) {
+        if (path_alias->second.owner != owner) {
+            return {ApiCallStatus::PermissionDenied, nullptr, "registered map assets belong to another mod"};
+        }
+        if (size > kMapAliasOverrideSizeLimit) {
+            return {ApiCallStatus::InvalidArgument, nullptr, "map assets cannot exceed 8 MiB"};
+        }
+    }
+    const auto existing = g_overrides.find(game_path);
+    if (existing != g_overrides.end() && existing->second.owner != owner) {
+        return {ApiCallStatus::PermissionDenied, nullptr,
+                "another mod already owns an override for this native asset path"};
+    }
+    if (existing == g_overrides.end()) {
+        const std::size_t owned = std::ranges::count_if(g_overrides, [owner](const auto &entry) {
+            return entry.second.owner == owner;
+        });
+        if (owned >= kPerModOverrideLimit || g_overrides.size() >= kGlobalOverrideLimit) {
+            return {ApiCallStatus::InvalidArgument, nullptr, "native resource override limit reached"};
+        }
+    }
+    const bool pinned_by_alias = path_alias != g_path_aliases.end() ||
+                                 (existing != g_overrides.end() && existing->second.pinned_by_alias);
+    const bool persistent = existing != g_overrides.end() && existing->second.persistent;
+    std::error_code time_error;
+    const std::filesystem::file_time_type written = std::filesystem::last_write_time(resolved, time_error);
+    g_overrides.insert_or_assign(
+        game_path, OverrideRecord{std::string(owner), within_package.generic_string(), resolved, size,
+                                  persistent, pinned_by_alias, written});
+    return {ApiCallStatus::Ok,
+            {{"game_path", game_path}, {"path", within_package.generic_string()}, {"size", size},
+             {"status", "registered"}},
+            {}};
+}
+
+ApiCallResult RemoveNativeResourceOverride(std::string_view owner, const Json &arguments) {
+    if (owner.empty() || !arguments.is_array() || arguments.size() != 1 || !arguments[0].is_object() ||
+        arguments[0].size() != 1 || !HasOnlyFields(arguments[0], {"game_path"}) ||
+        !arguments[0].contains("game_path") || !arguments[0]["game_path"].is_string()) {
+        return {ApiCallStatus::InvalidArgument, nullptr, "expected {game_path = native asset path}"};
+    }
+    std::string game_path;
+    if (!NormalizeGamePath(arguments[0]["game_path"].get_ref<const std::string &>(), game_path)) {
+        return {ApiCallStatus::InvalidArgument, nullptr, "game_path is not a valid relative native asset path"};
+    }
+    std::lock_guard lock(g_override_mutex);
+    const auto found = g_overrides.find(game_path);
+    if (found == g_overrides.end()) {
+        return {ApiCallStatus::Failed, nullptr, "no mod resource override exists for this path"};
+    }
+    if (found->second.owner != owner) {
+        return {ApiCallStatus::PermissionDenied, nullptr, "native resource override belongs to another mod"};
+    }
+    if (found->second.pinned_by_alias) {
+        return {ApiCallStatus::Failed, nullptr, "native resource override is pinned by a registered map"};
+    }
+    if (found->second.persistent) {
+        return {ApiCallStatus::PermissionDenied, nullptr,
+                "native resource override is required by a registered native content definition"};
+    }
+    g_overrides.erase(found);
+    return {ApiCallStatus::Ok, {{"game_path", game_path}, {"removed", true}}, {}};
+}
+
+std::optional<std::filesystem::path> FindNativeResourceOverride(std::string_view game_path) {
+    std::string normalized;
+    if (!NormalizeGamePath(game_path, normalized)) return std::nullopt;
+    std::lock_guard lock(g_override_mutex);
+    const auto found = g_overrides.find(normalized);
+    if (found == g_overrides.end()) return std::nullopt;
+    return found->second.file;
+}
+
+bool NativeResourceOverrideOwnedBy(std::string_view owner, std::string_view game_path) {
+    if (owner.empty()) return false;
+    std::string normalized;
+    if (!NormalizeGamePath(game_path, normalized)) return false;
+    std::lock_guard lock(g_override_mutex);
+    const auto found = g_overrides.find(normalized);
+    return found != g_overrides.end() && found->second.owner == owner;
+}
+
+std::vector<std::string> RefreshChangedNativeResourceOverrides() {
+    std::vector<std::string> changed;
+    std::lock_guard lock(g_override_mutex);
+    for (auto &[game_path, record] : g_overrides) {
+        std::error_code error;
+        const auto written = std::filesystem::last_write_time(record.file, error);
+        if (error || written == record.written) continue;
+        const std::uintmax_t size = std::filesystem::file_size(record.file, error);
+        if (error || size == 0 || size > kOverrideFileSizeLimit) continue;
+        record.written = written;
+        record.size = size;
+        changed.push_back(game_path);
+    }
+    return changed;
+}
+
+std::optional<std::uintmax_t> NativeResourceOverrideSize(std::string_view game_path) {
+    std::string normalized;
+    if (!NormalizeGamePath(game_path, normalized)) return std::nullopt;
+    std::lock_guard lock(g_override_mutex);
+    const auto found = g_overrides.find(normalized);
+    if (found == g_overrides.end()) return std::nullopt;
+    return found->second.size;
+}
+
+bool SetNativeResourceOverridePersistent(std::string_view owner, std::string_view game_path, bool persistent) {
+    std::string normalized;
+    if (!NormalizeGamePath(game_path, normalized)) return false;
+    std::lock_guard lock(g_override_mutex);
+    const auto found = g_overrides.find(normalized);
+    if (found == g_overrides.end() || found->second.owner != owner) return false;
+    found->second.persistent = persistent;
+    return true;
+}
+
+bool RegisterNativeResourcePathAlias(std::string_view owner, std::string_view target_prefix,
+                                     std::string_view source_prefix, std::uintmax_t max_override_size,
+                                     std::string &error) {
+    error.clear();
+    std::string target;
+    std::string source;
+    if (owner.empty() || !NormalizeGamePath(target_prefix, target) || !NormalizeGamePath(source_prefix, source) ||
+        !IsChronicleMapDirectory(target, true) || !IsChronicleMapDirectory(source, false) || target == source) {
+        error = "map resource aliases require distinct gedit map directories";
+        return false;
+    }
+
+    std::lock_guard lock(g_override_mutex);
+    const auto existing = g_path_aliases.find(target);
+    if (existing != g_path_aliases.end() &&
+        (existing->second.owner != owner || existing->second.source_prefix != source)) {
+        error = "another map registration already owns this map directory";
+        return false;
+    }
+    for (const auto &[path, override_record] : g_overrides) {
+        if (!IsPathBelowPrefix(path, target)) continue;
+        if (override_record.owner != owner) {
+            error = "a map asset path is overridden by another mod: " + path;
+            return false;
+        }
+        if (override_record.size > max_override_size) {
+            error = "map asset exceeds the per-file size limit: " + path;
+            return false;
+        }
+    }
+    for (auto &[path, override_record] : g_overrides) {
+        if (IsPathBelowPrefix(path, target)) override_record.pinned_by_alias = true;
+    }
+    g_path_aliases.insert_or_assign(target, ResourcePathAlias{std::string(owner), target, source});
+    return true;
+}
+
+std::optional<std::string> FindNativeResourcePathAlias(std::string_view game_path) {
+    std::string normalized;
+    if (!NormalizeGamePath(game_path, normalized)) return std::nullopt;
+    std::lock_guard lock(g_override_mutex);
+    const ResourcePathAlias *best = nullptr;
+    for (const auto &[prefix, alias] : g_path_aliases) {
+        if (IsPathBelowPrefix(normalized, prefix) && (best == nullptr || prefix.size() > best->target_prefix.size())) {
+            best = &alias;
+        }
+    }
+    if (best == nullptr) return std::nullopt;
+    return best->source_prefix + normalized.substr(best->target_prefix.size());
+}
+
+void RemoveNativeResourceOverridesByOwner(std::string_view owner) {
+    std::lock_guard lock(g_override_mutex);
+    std::erase_if(g_overrides, [owner](const auto &entry) {
+        return entry.second.owner == owner && !entry.second.persistent && !entry.second.pinned_by_alias;
+    });
+}
+
+void ResetNativeResourceOverridesForTests() {
+    std::lock_guard lock(g_override_mutex);
+    g_overrides.clear();
+    g_path_aliases.clear();
+}
+
+} // namespace moonmod
