+#include "moonmod/manifest.hpp"
+
+#include "moonmod/api.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <format>
+#include <fstream>
+#include <initializer_list>
+#include <limits>
+#include <regex>
