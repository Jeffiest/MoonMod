+    EXPECT_EQ(config.api_handler("test.moonmod.georama-element", *set,
+                                 moonmod::Json::array({absent})).status,
+              moonmod::ApiCallStatus::InvalidArgument);
+
+    NowEditMap = 3;
+    EXPECT_EQ(config.api_handler("test.moonmod.georama-element", *set,
+                                 moonmod::Json::array({enable})).status,
+              moonmod::ApiCallStatus::Failed);
+}
