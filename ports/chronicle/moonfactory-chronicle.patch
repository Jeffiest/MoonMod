@@ -0,0 +1,120 @@
+#pragma once
+
+#include <filesystem>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "moonmod/manifest.hpp"
+#include "moonmod/api.hpp"
+
+namespace moonmod {
+
+enum class ModState {
+    Ready,
+    Disabled,
+    Loaded,
+    Invalid,
+    Incompatible,
+    MissingDependency,
+    DependencyCycle,
+    LoadError,
+};
+
+std::string ModStateText(ModState state);
+
+struct ModRecord {
+    ModManifest            manifest;
+    std::filesystem::path  package_root;
+    std::string            id;
+    std::string            display_name;
+    std::string            status_message;
