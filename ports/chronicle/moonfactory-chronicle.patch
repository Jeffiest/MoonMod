+    return {ApiCallStatus::Ok,
+            {{"scene_id", scene_id}, {"native_mode", mode},
+             {"native_map_id", has_map ? Json(MapNo) : Json(nullptr)}, {"native_floor_id", floor_id}},
+            {}};
