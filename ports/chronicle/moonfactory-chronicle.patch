+                    {"weapon_id", weapon_stable_id}, {"native_weapon_id", weapon_id},
+                    {"damage", damage}, {"element", element}, {"frame", SharedRuntime().Frame()}};
+    if (monster.base_model >= 0 && monster.base_model < static_cast<int>(g_loaded_monster_model_ids.size())) {
