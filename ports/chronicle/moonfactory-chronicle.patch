+std::map<int, GameText> g_text;
+struct ManagerBounds { float left, top, sx, sy; };
+ManagerBounds Bounds() {
+    const auto visible = gfx::VisibleLogicalRect(gfx::kMainTarget);
+    return {visible.x + 18.0f, visible.y + 18.0f,
+            std::max(1.0f, visible.w - 36.0f) / 568.0f,
+            std::max(1.0f, visible.h - 36.0f) / 396.0f};
+}
+int X(int x) { const auto b = Bounds(); return std::lround(b.left + (x - 36) * b.sx); }
+int Y(int y) { const auto b = Bounds(); return std::lround(b.top + (y - 66) * b.sy); }
+int W(int width) { return std::max(1, int(std::floor(width * Bounds().sx))); }
+int MeasureText(const std::string &value);
+std::string Ellipsize(std::string value, int width) {
+    if (MeasureText(value) <= width) return value;
+    while (!value.empty() && MeasureText(value + "...") > width) {
+        value.pop_back();
+        // Remove a complete UTF-8 codepoint, never leave a partial sequence.
+        while (!value.empty() && (static_cast<unsigned char>(value.back()) & 0xc0) == 0x80) value.pop_back();
+        if (!value.empty() && static_cast<unsigned char>(value.back()) >= 0xc0) value.pop_back();
+    }
+    return value.empty() && MeasureText("...") > width ? "" : value + "...";
+}
+
+void Fill(int x, int y, int width, int height, int red, int green, int blue, int alpha) {
+    MGFillBox(CRect_i_(X(x) * 16, Y(y) * 8, (X(x + width) - X(x)) * 16, (Y(y + height) - Y(y)) * 8), red, green, blue,
+              static_cast<unsigned char>(std::clamp(alpha, 0, 0x80)));
+}
+
+void Text(int slot, std::string value, int x, int y, int width, bool selected, int alpha, int size = 16) {
+    (void)size; // Keep the native font glyphs at readable size; never squeeze character spacing.
+    GameText &text = g_text.try_emplace(slot).first->second;
+    text.KeepGameRandom(true);
+    text.SetColour(selected ? FONT_COLOR_YELLOW : FONT_COLOR_WHITE);
+    text.Set(Ellipsize(std::move(value), W(width)));
+    text.RefreshGlyphs();
+    text.Draw(X(x), Y(y), alpha);
+}
+
+// Natural width of a string in the manager font, before any fitting.
+int MeasureText(const std::string &value) {
+    static GameText measure;
+    measure.KeepGameRandom(true);
+    measure.Set(value);
+    measure.RefreshGlyphs();
+    return measure.Width();
+}
+
+// Word-wraps value into at most max_lines lines of width, so long descriptions
+// stay readable instead of being squeezed onto one line. Text that does not fit
+// in max_lines ends the last line with "...". Returns the number of lines drawn.
+int WrappedText(int first_slot, const std::string &value, int x, int y, int width, int line_step, int max_lines,
+                int alpha) {
+    std::vector<std::string> words;
+    std::size_t start = 0;
+    while (start < value.size()) {
+        const std::size_t end = value.find(' ', start);
+        const std::size_t stop = end == std::string::npos ? value.size() : end;
+        if (stop > start) words.push_back(value.substr(start, stop - start));
+        start = stop + 1;
+    }
+    std::vector<std::string> lines;
+    std::string line;
+    std::size_t next = 0;
+    for (; next < words.size(); ++next) {
+        const std::string candidate = line.empty() ? words[next] : line + " " + words[next];
+        if (line.empty() || MeasureText(candidate) <= W(width)) {
+            line = candidate;
+            continue;
+        }
+        lines.push_back(std::move(line));
+        line = words[next];
+        if (static_cast<int>(lines.size()) == max_lines) break;
+    }
+    if (static_cast<int>(lines.size()) < max_lines) {
+        if (!line.empty() || lines.empty()) lines.push_back(std::move(line));
+        next = words.size();
+    }
+    if (next < words.size() && !lines.empty()) {
+        // Out of lines: shorten the last one until it fits with an ellipsis.
+        std::string &last = lines.back();
+        while (!last.empty() && MeasureText(last + "...") > W(width)) {
+            const std::size_t space = last.rfind(' ');
+            last.erase(space == std::string::npos ? 0 : space);
+        }
+        last += "...";
+    }
+    for (std::size_t index = 0; index < lines.size(); ++index) {
+        Text(first_slot + static_cast<int>(index), lines[index], x, y + static_cast<int>(index) * line_step, width,
+             false, alpha);
+    }
+    return static_cast<int>(lines.size());
+}
+
+std::string ModTitle(const moonmod::ModRecord &record) {
+    return std::format("{}  {}", record.display_name, record.manifest.version);
+}
+
+std::string JournalStatus(std::string status) {
+    if (status == "completed") return "DONE";
+    if (status == "registered") return "NEW";
+    if (status == "failed") return "FAILED";
+    return status == "active" ? "ACTIVE" : status;
+}
+
+std::vector<std::string> NativePermissionLines(const moonmod::ModRecord *record) {
+    std::vector<std::string> lines;
+    std::string line = "Permissions:";
+    if (record == nullptr || record->manifest.permissions.empty()) {
+        lines.push_back("Permissions: none");
+        return lines;
+    }
+    std::vector<std::string> sorted = record->manifest.permissions;
+    std::ranges::sort(sorted);
+    for (const std::string &permission : sorted) {
+        const std::string separator = line == "Permissions:" ? " " : ", ";
+        if (line.size() + separator.size() + permission.size() > 46 && line != "Permissions:") {
+            lines.push_back(std::move(line));
+            line = "  " + permission;
+        } else {
+            line += separator + permission;
+        }
+    }
+    lines.push_back(std::move(line));
+    return lines;
+}
