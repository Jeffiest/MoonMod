+fs::path NativeAssetSource(std::string_view game_path, const fs::path &base_file, const void *buffer) {
+    const std::string folded = dcdata::FoldPath(StripDevice(game_path));
+    const std::optional<fs::path> replacement = moonmod::FindNativeResourceOverride(folded);
+    if (!replacement) return base_file;
+    std::error_code error;
+    const std::uintmax_t original_size = fs::file_size(base_file, error);
+    if (error) return base_file;
+    const std::uintmax_t replacement_size = fs::file_size(*replacement, error);
+    if (error || replacement_size == 0 ||
+        replacement_size > static_cast<std::uintmax_t>(std::numeric_limits<int>::max())) {
+        std::fprintf(stderr, "moonmod: ignored empty or unreadable native resource override for %s\n", folded.c_str());
+        return base_file;
+    }
+    if (replacement_size <= original_size) return *replacement;
+    const GrowthLimit limit = OverrideGrowthLimit(folded);
+    const std::uintmax_t padded = dcdata::SectorsFor(replacement_size) * dcdata::kSector;
+    const std::uintmax_t room = ArenaRoomAt(buffer);
+    if (limit.bytes == 0 || replacement_size > limit.bytes) {
+        std::fprintf(stderr,
+                     "moonmod: refused override for %s: %ju bytes, retail %ju, limit %ju (%s)\n",
+                     folded.c_str(), replacement_size, original_size,
+                     limit.bytes == 0 ? original_size : limit.bytes, limit.why);
+        NoticeRefusedOverride(folded, "too big");
+        return base_file;
+    }
+    if (padded > room) {
+        std::fprintf(stderr,
+                     "moonmod: refused override for %s: %ju bytes (%ju with sector padding), retail %ju, "
+                     "destination buffer has %ju bytes\n",
+                     folded.c_str(), replacement_size, padded, original_size, room);
+        NoticeRefusedOverride(folded, "does not fit its buffer");
+        return base_file;
+    }
+    std::fprintf(stderr, "moonmod: override for %s grows %ju -> %ju bytes (limit %ju, buffer room %ju)\n",
+                 folded.c_str(), original_size, replacement_size, limit.bytes, room);
+    return *replacement;
+}
+
+// A registered weapon's own model (weapons.register model = "<stem>"): commenu/weapon/<stem>.chr.
+bool IsVirtualWeaponModelPath(std::string_view path) {
+    constexpr std::string_view prefix = "commenu/weapon/";
+    if (!path.starts_with(prefix)) return false;
+    path.remove_prefix(prefix.size());
+    return path.size() > 4 && path.size() <= 19 && path.find('/') == std::string_view::npos && path.ends_with(".chr");
+}
+
+// A mod villager's own model (characters.register kind = "npc"): gedit/<town>/chara/<stem>.chr.
+bool IsVirtualVillagerModelPath(std::string_view path) {
+    constexpr std::string_view prefix = "gedit/";
+    if (!path.starts_with(prefix)) return false;
+    path.remove_prefix(prefix.size());
+    const std::size_t town_end = path.find('/');
+    if (town_end == std::string_view::npos || town_end == 0 || town_end > 8) return false;
+    path.remove_prefix(town_end + 1);
+    if (!path.starts_with("chara/")) return false;
+    path.remove_prefix(6);
+    return path.size() > 4 && path.size() <= 35 && path.find('/') == std::string_view::npos && path.ends_with(".chr");
+}
+
+bool IsVirtualMonsterAssetPath(std::string_view path) {
+    constexpr std::string_view prefix = "dun/monstor/";
+    if (!path.starts_with(prefix)) return false;
+    path.remove_prefix(prefix.size());
+    if (path.find('/') != std::string_view::npos) return false;
+    const std::size_t extension = path.rfind('.');
+    if (extension == std::string_view::npos ||
+        (path.substr(extension) != ".chr" && path.substr(extension) != ".stb")) return false;
+    const std::string_view stem = path.substr(0, extension);
+    return !stem.empty() && stem.size() <= 15 &&
+           std::all_of(stem.begin(), stem.end(), [](unsigned char character) {
+               return (character >= 'a' && character <= 'z') || (character >= '0' && character <= '9') ||
+                      character == '_' || character == '-' || character == '.';
+           });
+}
+
+// dun/<map>.cfg or dun/mpd_pack/<map>.mpd with a 1-15 character [a-z0-9_] map name.
+bool IsVirtualFloorPackPath(std::string_view path) {
+    std::string_view extension;
+    if (path.starts_with("dun/mpd_pack/")) {
+        path.remove_prefix(13);
+        extension = ".mpd";
+    } else if (path.starts_with("dun/")) {
+        path.remove_prefix(4);
+        extension = ".cfg";
+    } else {
+        return false;
+    }
+    if (!path.ends_with(extension)) return false;
+    path.remove_suffix(4);
+    return !path.empty() && path.size() <= 15 && std::all_of(path.begin(), path.end(), [](unsigned char c) {
+        return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_';
+    });
+}
+
+// gedit/mod/<name>.scn: a Georama variant's own scene file (see ChronicleLoadModPartModel).
+bool IsVirtualGeoramaScenePath(std::string_view path) {
+    if (!path.starts_with("gedit/mod/") || !path.ends_with(".scn")) return false;
+    path.remove_prefix(10);
+    path.remove_suffix(4);
+    return !path.empty() && path.size() <= 15 && std::all_of(path.begin(), path.end(), [](unsigned char c) {
+        return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_';
+    });
+}
