+    if (index < 0 || index >= CHRONICLE_MOD_VILLAGER_COUNT || name == NULL || std::strlen(name) >= 32) {
+        return false;
+    }
+    ChronicleModVillager &villager = g_mod_villagers[index];
+    std::memset(&villager, 0, sizeof(villager));
+    villager.slot = -1;
+    if (name[0] == '\0') {
