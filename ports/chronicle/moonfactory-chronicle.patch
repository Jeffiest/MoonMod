+bool ValidId(std::string_view value) {
+    return !value.empty() && value.size() <= 64 &&
+           std::ranges::all_of(value, [](unsigned char c) {
+               return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') ||
+                      c == '_' || c == '-' || c == '.';
+           });
+}
