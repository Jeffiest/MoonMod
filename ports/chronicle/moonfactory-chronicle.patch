+      }
+      vmcase(OP_SETFIELD) {
+        StkId ra = RA(i);
+        int hres;
+        TValue *rb = KB(i);
+        TValue *rc = RKC(i);
+        TString *key = tsvalue(rb);  /* key must be a short string */
