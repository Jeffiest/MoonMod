+unsigned LuaSeed(std::string_view mod_id) {
+    std::uint32_t seed = 2166136261u;
+    for (const char character : mod_id) {
+        seed = (seed ^ static_cast<unsigned char>(character)) * 16777619u;
+    }
+    return seed;
