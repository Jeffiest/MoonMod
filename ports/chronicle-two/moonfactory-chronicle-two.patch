+    EXPECT_EQ(registered_get.value.at("floors")[0].at("native_floor_id"), 2);
+    GLID_INFO *next = manager.GetNextRoom(1, GLID_DIR_RIGHT, nullptr, -1, nullptr);
+    ASSERT_NE(next, nullptr);
