+#include "common.h"
+
+#include <cstring>
+
+#include "savedatadungeon.hpp"
+
+// Floors registered by mods resolve to the save extension records; native floors keep retail's layout.
+PORT_OVERRIDE DNG_FLOOR_SAVE *CSaveDataDungeon::GetFloorInfoPtr(int dungeon, int floor) {
+    if (DNG_FLOOR_SAVE *mod_floor = GetMoonModDungeonSaveRecord(this, dungeon, floor)) {
+        return mod_floor;
+    }
+    if (!HasSavedDungeonFloorRecord(dungeon, floor)) {
+        return NULL;
+    }
+
+    int index = 0;
+
+    for (int i = 0; i < dungeon; i++) {
+        index += GetSavedDungeonFloorCount(i);
+    }
+
+    index += floor;
+
+    return &floor_info[index];
+}
+
+PORT_OVERRIDE void CSaveDataDungeon::Initialize() {
+    ResetMoonModDungeonSaveExtension(this);
+    memset(floor_info, 0, sizeof(floor_info));
+
+    for (int i = 0; i < 7; i++) {
+        DNG_FLOOR_SAVE *info = GetFloorInfoPtr(i, 0);
+
+        if (info) {
+            info->visit_count = 1;
+            info->flag = 3;
+        }
+
+        info = GetFloorInfoPtr(i, 1);
+
+        if (info) {
+            info->flag = 1;
+        }
+    }
+
+    for (int i = 0; i < 7; i++) {
+        prev_floor_id[i] = -1;
+    }
+
+    for (int i = 0; i < 7; i++) {
+        floor_id[i] = 1;
+    }
+
+    stage_id = 0;
+}
