+    EXPECT_NE(manager.GetDngMapFloorInfo(2)->flag & DNGMAP_ROOM_FLAG_EXIT, 0);
+    EXPECT_EQ(manager.GetDngMapFloorInfo(2)->seal, DNGMAP_SEAL_MAX);
