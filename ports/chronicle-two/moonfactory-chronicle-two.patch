+    {"moonmod.ascension", "sturdy_durability_refund", 80, 0},
+    {"moonmod.ascension", "sturdy_water_refund", 60, 0},
+    {"moonmod.dungeon-plus", "mutator_chance", 20, 55},
+    {"moonmod.dungeon-plus", "tier_hp_percent", 25, 50},
