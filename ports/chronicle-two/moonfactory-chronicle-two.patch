+    if (target == "max") character_id = USER_CHARA_MAX;
+    else if (target == "monica") character_id = USER_CHARA_MONICA;
+    else if (target == "ridepod") character_id = USER_CHARA_ROBO;
+    else return false;
+    hp = user_data.GetCharaHpGage(character_id);
+    return hp != nullptr;
