+        Text(13, "plus a Lua entry script.", 62, 233, 164, false, alpha, 14);
+        Text(14, "See the MoonFactory example.", 62, 255, 164, false, alpha, 14);
+        Text(15, "The package can target either game.", 268, 160, 300, false, alpha, 14);
