+static const char *getMode (lua_State *L, int idx) {
+  const char *mode = luaL_optstring(L, idx, NULL);
+  if (mode != NULL && strchr(mode, 'B') != NULL) {
+    /* Lua code cannot use fixed buffers */
+    luaL_argerror(L, idx, "invalid mode");
+  }
+  return mode;
+}
