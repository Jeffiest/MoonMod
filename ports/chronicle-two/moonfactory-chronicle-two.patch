+    Json hardcore;
+};
+
+const PresetSetting kGameplayPresetSettings[] = {
+    {"moonmod.ascension", "champion_chance_percent", 4, 15},
+    {"moonmod.ascension", "champion_hp_multiplier_percent", 250, 400},
+    {"moonmod.ascension", "enemy_hp_per_floor_half_percent", 4, 10},
