+bool Runtime::StepSetting(std::string_view mod_id, std::string_view setting_id, int direction, std::string &error) {
+    error.clear();
+    if (direction == 0) return true;
+    const ModRecord *record = impl_->Find(mod_id);
+    if (record == nullptr || !record->valid_manifest) {
+        error = "package is unavailable";
+        return false;
+    }
+    const SettingDefinition *setting = impl_->FindSetting(*record, setting_id);
+    if (setting == nullptr) {
+        error = "setting is unavailable";
+        return false;
+    }
+    Json value = impl_->SettingValue(*record, *setting);
+    switch (setting->type) {
+        case SettingType::Boolean:
+            value = !value.get<bool>();
+            break;
+        case SettingType::Integer: {
+            const long double next = static_cast<long double>(value.get<std::int64_t>()) +
+                                     (direction > 0 ? setting->step : -setting->step);
+            const long double rounded = std::round(next);
+            value = static_cast<std::int64_t>(std::clamp(rounded, static_cast<long double>(setting->minimum),
+                                                         static_cast<long double>(setting->maximum)));
+            break;
+        }
+        case SettingType::Number: {
+            const long double next = static_cast<long double>(value.get<double>()) +
+                                     (direction > 0 ? setting->step : -setting->step);
+            const long double clamped = std::clamp(next, static_cast<long double>(setting->minimum),
+                                                   static_cast<long double>(setting->maximum));
+            const long double rounded = std::round(clamped / setting->step) * setting->step;
+            const long double bounded = std::clamp(rounded, static_cast<long double>(setting->minimum),
+                                                   static_cast<long double>(setting->maximum));
+            value = static_cast<double>(bounded);
+            break;
+        }
+        case SettingType::Choice: {
+            const auto found = std::ranges::find(setting->choices, value.get<std::string>());
+            const auto index = found == setting->choices.end() ? 0 : static_cast<int>(found - setting->choices.begin());
+            const int count = static_cast<int>(setting->choices.size());
+            value = setting->choices[static_cast<std::size_t>((index + (direction > 0 ? 1 : count - 1)) % count)];
+            break;
+        }
+        case SettingType::String:
+            error = "text settings are read-only in this manager; edit the mod profile to change them";
+            return false;
+    }
+    return impl_->PersistSetting(*record, *setting, std::move(value), error);
+}
+
+bool Runtime::SetSettings(std::span<const SettingUpdate> updates, std::string &error) {
+    error.clear();
+    if (updates.empty()) return true;
+    struct ValidatedUpdate {
+        const ModRecord *record;
+        const SettingDefinition *setting;
+        const Json *value;
+    };
+    std::vector<ValidatedUpdate> validated;
+    std::set<std::pair<std::string, std::string>> unique;
+    validated.reserve(updates.size());
+    for (const SettingUpdate &update : updates) {
+        const ModRecord *record = impl_->Find(update.mod_id);
+        if (record == nullptr || !record->valid_manifest) {
+            error = "a preset package is unavailable";
+            return false;
+        }
+        const SettingDefinition *setting = impl_->FindSetting(*record, update.setting_id);
+        if (setting == nullptr) {
+            error = "a preset setting is unavailable: " + update.mod_id + ":" + update.setting_id;
+            return false;
+        }
+        const Json &value = update.value;
+        bool valid = false;
+        switch (setting->type) {
+            case SettingType::Boolean:
+                valid = value.is_boolean();
+                break;
+            case SettingType::Integer:
+                valid = value.is_number_integer() && value.get<double>() >= setting->minimum &&
+                        value.get<double>() <= setting->maximum;
+                break;
+            case SettingType::Number:
+                valid = value.is_number() && std::isfinite(value.get<double>()) &&
+                        value.get<double>() >= setting->minimum && value.get<double>() <= setting->maximum;
+                break;
+            case SettingType::String:
+                valid = value.is_string() && value.get_ref<const std::string &>().size() <= 256;
+                break;
+            case SettingType::Choice:
+                valid = value.is_string() &&
+                        std::ranges::find(setting->choices, value.get<std::string>()) != setting->choices.end();
+                break;
+        }
+        if (!valid) {
+            error = "a preset value is invalid for " + update.mod_id + ":" + update.setting_id;
+            return false;
+        }
+        if (!unique.emplace(update.mod_id, update.setting_id).second) {
+            error = "a preset contains a duplicate setting";
+            return false;
+        }
+        validated.push_back({record, setting, &update.value});
+    }
+
+    Json previous = impl_->profile;
+    for (const ValidatedUpdate &update : validated) {
+        impl_->profile["settings"][update.record->id][update.setting->id] = *update.value;
+    }
+    if (!impl_->SaveProfile(error)) {
+        impl_->profile = std::move(previous);
+        return false;
+    }
+    for (const ValidatedUpdate &update : validated) {
+        const auto loaded = std::ranges::find_if(impl_->modules, [&](const auto &entry) {
+            return entry.first == update.record->id;
+        });
+        if (loaded != impl_->modules.end()) {
+            loaded->second->Emit("settings.changed",
+                                 {{"id", update.setting->id}, {"value", impl_->SettingValue(*update.record, *update.setting)}});
+        }
+    }
+    return true;
+}
+
+Runtime &SharedRuntime() {
+    static Runtime runtime;
+    return runtime;
+}
+
+} // namespace moonmod
