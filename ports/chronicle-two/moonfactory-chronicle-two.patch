+Json DungeonLayoutJson() {
+    return {{"rooms", DngLayoutRooms > 0 ? Json(DngLayoutRooms) : Json("native")},
+            {"area", DNG_BUILD_AREA}, {"room_min", DNG_BUILD_ROOM_MIN},
