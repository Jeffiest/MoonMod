+void Write(const fs::path &path, std::string_view content) {
+    fs::create_directories(path.parent_path());
+    std::ofstream output(path, std::ios::binary | std::ios::trunc);
+    output << content;
+    ASSERT_TRUE(output.good()) << path.string();
+}
