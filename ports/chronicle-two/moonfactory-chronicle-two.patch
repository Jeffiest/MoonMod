+    if (name == "leg") {
+        slot = ROBO_PART_LEG;
+        item_type = ITEM_DATA_ROBO_LEG;
+        return true;
+    }
+    if (name == "battery" || name == "pack") {
+        slot = ROBO_PART_PACK;
+        item_type = ITEM_DATA_ROBO_ENERGY_PACK;
+        return true;
+    }
+    return false;
