+    camera.pos[0] = 11.0f;
+    camera.pos[1] = 22.0f;
+    camera.pos[2] = 33.0f;
+    camera.ref[0] = -4.0f;
+    camera.ref[1] = 5.0f;
+    camera.ref[2] = 6.0f;
+    camera.angle_h = 0.25f;
+    camera.angle_v = -0.5f;
+    camera.roll = 0.125f;
