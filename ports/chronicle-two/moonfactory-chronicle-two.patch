+
+// MoonMod's monster additions for the ChronicleTwo port: data-only monster variants, per-slot generations that
+// let mods hold stale-safe handles, a despawn path for mod-spawned monsters, and the active-monster limit.
+
+int MonsterActiveLimit = 5;
+
+struct MOONMOD_MONSTER_VARIANT {
+    int used;
+    BASE_MONSTER_TBL definition;
+};
+
+static MOONMOD_MONSTER_VARIANT moonmod_variants[32];
+static unsigned int moonmod_monster_slot_generation[MONSTER_ACTIVE_MAX];
+
+static void BumpSlotGeneration(int slot) {
+    moonmod_monster_slot_generation[slot]++;
+    if (moonmod_monster_slot_generation[slot] == 0) {
+        moonmod_monster_slot_generation[slot]++;
+    }
+}
+
+unsigned int GetMoonModMonsterSlotGeneration(int slot) {
+    if (slot < 0 || slot >= MONSTER_ACTIVE_MAX) {
+        return 0;
+    }
+    return moonmod_monster_slot_generation[slot];
+}
+
+unsigned int EnsureMoonModMonsterSlotGeneration(int slot) {
+    if (slot < 0 || slot >= MONSTER_ACTIVE_MAX) {
+        return 0;
+    }
+    if (moonmod_monster_slot_generation[slot] == 0) {
+        moonmod_monster_slot_generation[slot] = 1;
+    }
+    return moonmod_monster_slot_generation[slot];
+}
+
+PORT_OVERRIDE BASE_MONSTER_TBL *GetMonsterTable(int monster_id) {
+    for (int variant = 0; variant < 32; variant++) {
+        if (moonmod_variants[variant].used && moonmod_variants[variant].definition.id == monster_id) {
+            return &moonmod_variants[variant].definition;
+        }
+    }
+
+    return PortRetailGetMonsterTable(monster_id);
+}
+
+// Retail searches base_monster_define alone; the variants must resolve here too.
+PORT_OVERRIDE BASE_MONSTER_TBL *CMonsterMan::GetReferPtr2(int monster_id) {
+    return GetMonsterTable(monster_id);
+}
+
+bool RegisterMoonModMonsterVariant(int template_id, const char *display_name, int hp, int attack,
+                                   int defense, int reward_exp, int reward_money,
+                                   const char *model, const char *script, int *out_id) {
+    BASE_MONSTER_TBL *template_definition = GetMonsterTable(template_id);
+    if (template_definition == NULL || display_name == NULL || display_name[0] == '\0' ||
+        model == NULL || model[0] == '\0' || strlen(model) >= sizeof(BASE_MONSTER_TBL::model) ||
+        script == NULL || script[0] == '\0' || strlen(script) >= sizeof(BASE_MONSTER_TBL::script) || out_id == NULL) {
+        return false;
+    }
+
+    int slot = -1;
+    for (int variant = 0; variant < 32; variant++) {
+        if (!moonmod_variants[variant].used) {
+            slot = variant;
+            break;
+        }
+    }
+    if (slot < 0) {
+        return false;
+    }
+
+    int native_id = 0x400 + slot;
+    while (GetMonsterTable(native_id) != NULL) {
+        native_id++;
+    }
+    memcpy(&moonmod_variants[slot].definition, template_definition, sizeof(BASE_MONSTER_TBL));
+    moonmod_variants[slot].definition.id = native_id;
+    memset(moonmod_variants[slot].definition.name, 0, sizeof(moonmod_variants[slot].definition.name));
+    strncpy(moonmod_variants[slot].definition.name, display_name,
+            sizeof(moonmod_variants[slot].definition.name) - 1);
+    memset(moonmod_variants[slot].definition.model, 0, sizeof(moonmod_variants[slot].definition.model));
+    memcpy(moonmod_variants[slot].definition.model, model, strlen(model));
+    memset(moonmod_variants[slot].definition.script, 0, sizeof(moonmod_variants[slot].definition.script));
+    memcpy(moonmod_variants[slot].definition.script, script, strlen(script));
+    moonmod_variants[slot].definition.life = hp;
+    moonmod_variants[slot].definition.attack = attack;
+    moonmod_variants[slot].definition.defense = defense;
+    moonmod_variants[slot].definition.reward_exp = reward_exp;
+    moonmod_variants[slot].definition.reward_money = reward_money;
+    moonmod_variants[slot].used = 1;
+    *out_id = native_id;
+    return true;
+}
+
+void ResetMoonModMonsterVariants() {
+    memset(moonmod_variants, 0, sizeof(moonmod_variants));
+}
+
+PORT_OVERRIDE void CMonsterLocateInfo::SetPutFlag(int slot, int put) {
+    if (slot < 0 || slot >= MONSTER_ACTIVE_MAX) {
+        return;
+    }
+
+    // CMonsterMan::SetActiveMonster calls this once per spawn, right after claiming the slot: a new generation
+    // invalidates every handle mods hold for the slot's previous monster.
+    if (put != 0) {
+        BumpSlotGeneration(slot);
+    }
+
+    const u32 mask = 1u << slot;
+    const bool was_put = (put_flag & mask) != 0;
+    if (put != 0) {
+        if (!was_put && put_num < num) {
+            put_flag |= mask;
+            put_num += 1;
+        }
+    } else if (was_put) {
+        put_flag &= ~mask;
+        put_num -= 1;
+    }
+}
+
+// Retail with priority_limit read from MonsterActiveLimit (retail 5) instead of the literal.
+PORT_OVERRIDE void CMonsterMan::Initialize(CScene *scene) {
+    mgCTextureManager *textures;
+    int                i;
+    DNG_BATTLE_AREA   *area = &scene->battle_area;
+    int                texb;
+    int                j;
+    int                k;
+    int                m;
+
+    SetMonsterExtendTable();
+    textures = &mgTexManager;
+    this->scene = scene;
+    effect_man = FxScriptMan;
+    priority_limit = MonsterActiveLimit;
+
+    for (i = 0; i < MONSTER_ACTIVE_MAX; i++) {
+        active[i] = (CActiveMonster *) scene->GetCharacter(i + MONSTER_ACTIVE_MAX);
+        active[i]->Initialize();
+    }
+
+    for (j = 0; j < MONSTER_REFER_MAX; j++) {
+        textures->DeleteBlock(j + MONSTER_TEXB_REFER);
+        refer[j].id = -1;
+    }
+
+    for (k = 0; k < MONSTER_SHARE_MAX; k++) {
+        shared_script_vars[k].i = 0;
+    }
+
+    FxScriptMan->ClearBaseFromLevel(3, NULL, -1);
+
+    for (texb = area->free_texb; texb < MONSTER_TEXB_FREE_END; texb++) {
+        textures->DeleteBlock(texb);
+    }
+
+    boss_life_gage.Initialize(0);
+    boss_max_life = 0;
+    locate.num = 0;
+    locate.put_num = 0;
+    locate.put_flag = 0;
+
+    for (m = 0; m < MONSTER_LOCATE_MAX; m++) {
+        s16 *param = locate.param;
+        s16 *id = locate.monster_id;
+        param[m] = -1;
+        id[m] = -1;
+    }
+}
+
+bool CMonsterMan::DespawnMoonModMonster(int slot, unsigned int generation) {
+    if (slot < 0 || slot >= MONSTER_ACTIVE_MAX || generation == 0 ||
+        GetMoonModMonsterSlotGeneration(slot) != generation || active[slot] == NULL || scene == NULL) {
+        return false;
+    }
+
+    CActiveMonster *monster = active[slot];
+    if (monster->state == ACTIVE_MONSTER_NONE || monster->catch_state == ACTION_CATCH_HELD) {
+        return false;
+    }
+
+    const int chara_id = slot + MONSTER_ACTIVE_MAX;
+    CActionChara *player = static_cast<CActionChara *>(scene->GetCharacter(scene->player_chara));
+    if (player != NULL && player->target_no == chara_id) {
+        player->target_no = -1;
+        player->lock_on = false;
+    }
+
+    for (int other_slot = 0; other_slot < MONSTER_ACTIVE_MAX; ++other_slot) {
+        CActiveMonster *other = active[other_slot];
+        if (other != NULL && other_slot != slot && other->target_no == chara_id) {
+            other->target_no = -1;
+        }
+    }
+
+    if (effect_man != NULL) {
+        effect_man->ClearEffectFromChrid(chara_id);
+    }
+    ColPrimMan.Delete(chara_id);
+
+    if (monster->tbl != NULL && monster->tbl->boss != 0) {
+        boss_max_life -= monster->max_life;
+        if (boss_max_life < 0) {
+            boss_max_life = 0;
+        }
+    }
+
+    locate.SetPutFlag(slot, false);
+    monster->Initialize();
+    monster->target_no = -1;
+    monster->tbl = NULL;
+    monster->base_tbl = NULL;
+    monster->refer_no = -1;
+    memory[slot].stReset();
+
+    BumpSlotGeneration(slot);
+    return true;
+}
diff --git a/port/src/moonmod/native_plugin_contract.cpp b/port/src/moonmod/native_plugin_contract.cpp
new file mode 100644
index 000000000..78a4d7503
--- /dev/null
+++ b/port/src/moonmod/native_plugin_contract.cpp
@@ -0,0 +1,94 @@
+#include "moonmod/native_plugin_contract.hpp"
+
+#include <algorithm>
+#include <cstddef>
+#include <ranges>
+#include <string_view>
+
+#include "moonmod/api.hpp"
+
+namespace moonmod {
+namespace {
+
+constexpr std::size_t kMaximumNativePermissions = 32;
+
+bool ValidPluginId(std::string_view value) {
+    return !value.empty() && value.size() <= 64 &&
+           std::ranges::all_of(value, [](unsigned char character) {
+               return (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') ||
+                      (character >= '0' && character <= '9') || character == '.' || character == '_' ||
+                      character == '-';
+           });
+}
+
+constexpr std::size_t kRequiredPluginV1Size =
+    offsetof(MoonModNativePluginV1, unload) + sizeof(MoonModNativeUnloadV1);
+
+} // namespace
+
+NativePluginValidation ValidateNativePluginV1(const MoonModNativePluginV1 *plugin,
+                                               std::string_view expected_plugin_id,
+                                               std::uint32_t host_abi_major,
+                                               std::uint32_t host_abi_minor,
+                                               std::span<const std::string_view> manifest_permissions) {
+    if (plugin == nullptr) return NativePluginValidation::NullDescriptor;
+    if (plugin->struct_size < kRequiredPluginV1Size) return NativePluginValidation::IncompleteDescriptor;
+    if (plugin->abi_major != MOONMOD_NATIVE_ABI_MAJOR_V1) return NativePluginValidation::UnsupportedPluginAbi;
+    if (plugin->minimum_host_abi_major != host_abi_major ||
+        plugin->minimum_host_abi_minor > host_abi_minor) {
+        return NativePluginValidation::UnsupportedHostAbi;
+    }
+    if (plugin->plugin_id == nullptr || !ValidPluginId(plugin->plugin_id)) {
+        return NativePluginValidation::InvalidPluginId;
+    }
+    if (!ValidPluginId(expected_plugin_id) || std::string_view(plugin->plugin_id) != expected_plugin_id) {
+        return NativePluginValidation::PluginIdMismatch;
+    }
+    if (plugin->required_permission_count > kMaximumNativePermissions ||
+        (plugin->required_permission_count != 0 && plugin->required_permissions == nullptr)) {
+        return NativePluginValidation::InvalidPermissionList;
+    }
+    if (std::ranges::find(manifest_permissions, "native.extension") == manifest_permissions.end()) {
+        return NativePluginValidation::InvalidPermissionList;
+    }
+    for (std::uint32_t index = 0; index < plugin->required_permission_count; ++index) {
+        const char *permission = plugin->required_permissions[index];
+        if (permission == nullptr || !IsKnownPermission(permission)) {
+            return NativePluginValidation::UnknownPermission;
+        }
+        const std::string_view name(permission);
+        bool duplicate = false;
+        for (std::uint32_t previous = 0; previous < index; ++previous) {
+            if (plugin->required_permissions[previous] != nullptr &&
+                std::string_view(plugin->required_permissions[previous]) == name) {
+                duplicate = true;
+                break;
+            }
+        }
+        if (std::ranges::find(manifest_permissions, name) == manifest_permissions.end() || duplicate) {
+            return NativePluginValidation::InvalidPermissionList;
+        }
+    }
+    if (plugin->load == nullptr) return NativePluginValidation::MissingLoadCallback;
+    if (plugin->unload == nullptr) return NativePluginValidation::MissingUnloadCallback;
+    return NativePluginValidation::Valid;
+}
+
+std::string_view NativePluginValidationMessage(NativePluginValidation validation) {
+    switch (validation) {
+        case NativePluginValidation::Valid: return "native plugin descriptor is compatible";
+        case NativePluginValidation::NullDescriptor: return "native plugin entry returned a null descriptor";
+        case NativePluginValidation::IncompleteDescriptor: return "native plugin descriptor is smaller than ABI v1";
+        case NativePluginValidation::UnsupportedPluginAbi: return "native plugin ABI major is not supported";
+        case NativePluginValidation::UnsupportedHostAbi: return "native plugin requires a newer or different host ABI";
+        case NativePluginValidation::PluginIdMismatch: return "native plugin id does not match its package declaration";
+        case NativePluginValidation::InvalidPluginId: return "native plugin id is invalid";
+        case NativePluginValidation::InvalidPermissionList: return "native plugin permissions are invalid or undeclared";
+        case NativePluginValidation::UnknownPermission: return "native plugin requests an unknown permission";
+        case NativePluginValidation::MissingLoadCallback: return "native plugin does not export a load callback";
+        case NativePluginValidation::MissingUnloadCallback: return "native plugin does not export an unload callback";
+    }
+    return "native plugin descriptor validation failed";
+}
+
+} // namespace moonmod
diff --git a/port/src/moonmod/native_plugin_hash.cpp b/port/src/moonmod/native_plugin_hash.cpp
new file mode 100644
index 000000000..5f91b7ae4
--- /dev/null
+++ b/port/src/moonmod/native_plugin_hash.cpp
@@ -0,0 +1,116 @@
+#include "moonmod/native_plugin_hash.hpp"
+
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <fstream>
+
+namespace moonmod {
+namespace {
+
+class Sha256 {
+public:
+    void Update(const char *data, std::size_t size) {
+        total_bits_ += static_cast<std::uint64_t>(size) * 8;
+        for (std::size_t index = 0; index < size; ++index) {
+            block_[block_size_++] = static_cast<unsigned char>(data[index]);
+            if (block_size_ == block_.size()) {
+                Transform();
+                block_size_ = 0;
+            }
+        }
+    }
+
+    std::string Finish() {
+        const std::uint64_t message_bits = total_bits_;
+        block_[block_size_++] = 0x80;
+        if (block_size_ > 56) {
+            while (block_size_ < block_.size()) block_[block_size_++] = 0;
+            Transform();
+            block_size_ = 0;
+        }
+        while (block_size_ < 56) block_[block_size_++] = 0;
+        for (int index = 7; index >= 0; --index) {
+            block_[56 + static_cast<std::size_t>(7 - index)] =
+                static_cast<unsigned char>((message_bits >> (index * 8)) & 0xff);
+        }
+        Transform();
+
+        constexpr char digits[] = "0123456789abcdef";
+        std::string result;
+        result.reserve(64);
+        for (const std::uint32_t value : state_) {
+            for (int shift = 28; shift >= 0; shift -= 4) result.push_back(digits[(value >> shift) & 0xf]);
+        }
+        return result;
+    }
+
+private:
+    static constexpr std::array<std::uint32_t, 64> kRound = {
+        0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
+        0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
+        0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu, 0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
+        0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
+        0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
+        0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
+        0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
+        0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u};
+
+    void Transform() {
+        std::array<std::uint32_t, 64> words{};
+        for (std::size_t index = 0; index < 16; ++index) {
+            words[index] = (static_cast<std::uint32_t>(block_[index * 4]) << 24) |
+                           (static_cast<std::uint32_t>(block_[index * 4 + 1]) << 16) |
+                           (static_cast<std::uint32_t>(block_[index * 4 + 2]) << 8) |
+                           static_cast<std::uint32_t>(block_[index * 4 + 3]);
+        }
+        for (std::size_t index = 16; index < words.size(); ++index) {
+            const std::uint32_t x = words[index - 15], y = words[index - 2];
+            const std::uint32_t s0 = std::rotr(x, 7) ^ std::rotr(x, 18) ^ (x >> 3);
+            const std::uint32_t s1 = std::rotr(y, 17) ^ std::rotr(y, 19) ^ (y >> 10);
+            words[index] = words[index - 16] + s0 + words[index - 7] + s1;
+        }
+        std::uint32_t a = state_[0], b = state_[1], c = state_[2], d = state_[3];
+        std::uint32_t e = state_[4], f = state_[5], g = state_[6], h = state_[7];
+        for (std::size_t index = 0; index < words.size(); ++index) {
+            const std::uint32_t sum1 = std::rotr(e, 6) ^ std::rotr(e, 11) ^ std::rotr(e, 25);
+            const std::uint32_t choice = (e & f) ^ (~e & g);
+            const std::uint32_t temporary1 = h + sum1 + choice + kRound[index] + words[index];
+            const std::uint32_t sum0 = std::rotr(a, 2) ^ std::rotr(a, 13) ^ std::rotr(a, 22);
+            const std::uint32_t majority = (a & b) ^ (a & c) ^ (b & c);
+            const std::uint32_t temporary2 = sum0 + majority;
+            h = g; g = f; f = e; e = d + temporary1;
+            d = c; c = b; b = a; a = temporary1 + temporary2;
+        }
+        state_[0] += a; state_[1] += b; state_[2] += c; state_[3] += d;
+        state_[4] += e; state_[5] += f; state_[6] += g; state_[7] += h;
+    }
+
+    std::array<std::uint32_t, 8> state_ = {0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au,
+                                           0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u};
+    std::array<unsigned char, 64> block_{};
+    std::size_t block_size_ = 0;
+    std::uint64_t total_bits_ = 0;
+};
+
+} // namespace
+
+std::string NativePluginFileSha256(const std::filesystem::path &path) {
+    constexpr std::uintmax_t kMaximumTrustedLibrarySize = 256 * 1024 * 1024;
+    std::error_code ec;
+    const auto size = std::filesystem::file_size(path, ec);
+    if (ec || size == 0 || size > kMaximumTrustedLibrarySize) return {};
+    std::ifstream input(path, std::ios::binary);
+    if (!input) return {};
+    Sha256 hash;
+    std::array<char, 64 * 1024> buffer{};
+    while (input) {
+        input.read(buffer.data(), static_cast<std::streamsize>(buffer.size()));
+        const auto count = input.gcount();
+        if (count > 0) hash.Update(buffer.data(), static_cast<std::size_t>(count));
+    }
+    if (!input.eof()) return {};
+    return hash.Finish();
+}
+
+} // namespace moonmod
