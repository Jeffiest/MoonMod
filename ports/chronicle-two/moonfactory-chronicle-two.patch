+ApiCallResult SetGeoramaCondition(const Json &args) {
+    if (args.size() != 1 || !args[0].is_object() || args[0].size() != 3 ||
+        !args[0].contains("town_id") || !args[0].contains("condition_id") || !args[0].contains("met") ||
+        !args[0]["met"].is_boolean()) {
