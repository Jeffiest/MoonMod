+
+void ShowManagerNotice(std::string message, int duration_frames) {
+    const int frames = std::clamp(duration_frames, 1, 3600);
+    std::erase_if(g_game_toasts, [&message](const GameToast &toast) { return toast.text == message; });
+    g_game_toasts.push_back({message, std::max(frames, 180)});
+    if (g_game_toasts.size() > 4) g_game_toasts.erase(g_game_toasts.begin());
+    g_state.notice = std::move(message);
+    g_state.notice_frames = frames;
+}
+
+std::vector<std::string> GameToastLines() {
+    std::vector<std::string> lines;
+    for (const GameToast &toast : g_game_toasts) lines.push_back(toast.text);
+    return lines;
+}
+
+void AdvanceManagerUi() {
+    if (g_state.notice_frames > 0 && --g_state.notice_frames == 0) g_state.notice.clear();
+    for (GameToast &toast : g_game_toasts) --toast.frames;
+    std::erase_if(g_game_toasts, [](const GameToast &toast) { return toast.frames <= 0; });
+}
+
+const ModRecord *ManagerSelectedMod() {
+    const auto mods = SharedRuntime().Mods();
+    if (mods.empty() || g_state.selected_mod < 0 || g_state.selected_mod >= static_cast<int>(mods.size())) return nullptr;
+    return &mods[g_state.selected_mod];
+}
+
+bool RegisterManagerAction(std::string_view owner_id, std::string_view local_id, std::string label,
+                           std::string description, std::string &error) {
+    if (owner_id.empty() || owner_id.size() > 128 || !ValidActionId(local_id)) {
+        error = "action id must contain 1-64 ASCII letters, digits, '.', '_' or '-'";
+        return false;
+    }
+    if (!SafeActionText(label, 48, false) || !SafeActionText(description, 120, true)) {
+        error = "action label must contain 1-48 bytes and description at most 120 bytes without control characters";
+        return false;
+    }
+    const std::size_t owner_count = static_cast<std::size_t>(std::ranges::count_if(
+        g_actions, [owner_id](const auto &entry) { return entry.second.owner_id == owner_id; }));
+    if (owner_count >= 12 || g_actions.size() >= 256) {
+        error = owner_count >= 12 ? "a mod may register at most 12 manager actions"
+                                  : "the manager supports at most 256 registered actions";
+        return false;
+    }
+    std::string qualified_id(owner_id);
+    qualified_id.push_back(':');
+    qualified_id.append(local_id);
+    if (g_actions.contains(qualified_id)) {
+        error = "action id is already registered by this mod";
+        return false;
+    }
+    g_actions.emplace(qualified_id, ManagerUiAction{qualified_id, std::string(owner_id),
+                                                    std::move(label), std::move(description)});
+    error.clear();
+    Reconcile();
+    return true;
+}
+
+bool RemoveManagerAction(std::string_view owner_id, std::string_view local_id) {
+    if (owner_id.empty() || local_id.empty()) return false;
+    std::string qualified_id(owner_id);
+    qualified_id.push_back(':');
+    qualified_id.append(local_id);
+    const bool removed = g_actions.erase(qualified_id) != 0;
+    if (removed) Reconcile();
+    return removed;
+}
+
+void RemoveManagerActions(std::string_view owner_id) {
+    if (owner_id.empty()) return;
+    std::erase_if(g_actions, [owner_id](const auto &entry) { return entry.second.owner_id == owner_id; });
+    Reconcile();
+}
+
+std::vector<ManagerUiAction> ManagerActions(std::string_view owner_id) {
+    std::vector<ManagerUiAction> actions;
+    for (const auto &[id, action] : g_actions) {
+        (void)id;
+        if (action.owner_id == owner_id) actions.push_back(action);
+    }
+    return actions;
+}
+
+std::vector<ManagerUiAction> ManagerDisplayActions(std::string_view owner_id) {
+    std::vector<ManagerUiAction> actions = ManagerActions(owner_id);
+    if (owner_id != "moonmod.dungeon-plus") return actions;
+    const std::array<ManagerUiAction, 3> presets = {{
+        {"moonmod.presets:relaxed", "moonmod.dungeon-plus", "Preset: Relaxed", "Apply the legacy Relaxed gameplay preset across Ascension and Dungeon+"},
+        {"moonmod.presets:normal", "moonmod.dungeon-plus", "Preset: Normal", "Restore preset-controlled settings to their package defaults"},
+        {"moonmod.presets:hardcore", "moonmod.dungeon-plus", "Preset: Hardcore", "Apply the legacy Hardcore gameplay preset across Ascension and Dungeon+"},
+    }};
+    actions.insert(actions.begin(), presets.begin(), presets.end());
+    return actions;
+}
+
+ApiCallResult ManagerQuests(std::string_view owner_id) {
+    return SharedRuntime().Quests(owner_id);
+}
+
+std::vector<ManagerJournalQuest> ManagerJournalQuests() {
+    std::vector<ManagerJournalQuest> entries;
+    for (const ModRecord &mod : SharedRuntime().Mods()) {
+        const ApiCallResult result = ManagerQuests(mod.id);
+        if (result.status != ApiCallStatus::Ok || !result.value.is_object()) continue;
+        const Json quests = result.value.value("quests", Json::array());
+        if (!quests.is_array()) continue;
+        for (const Json &quest : quests) {
+            if (quest.is_object()) entries.push_back({mod.id, mod.display_name, quest});
+        }
+    }
+    return entries;
+}
+
+std::string ManagerQuestRewardSummary(const Json &quest) {
+    const Json rewards = quest.is_object() ? quest.value("rewards", Json::array()) : Json::array();
+    if (!rewards.is_array() || rewards.empty()) return "Rewards: none";
+    std::vector<std::string> summaries;
+    const std::size_t visible = std::min<std::size_t>(rewards.size(), 2);
+    for (std::size_t index = 0; index < visible; ++index) {
+        const Json &reward = rewards[index];
+        if (!reward.is_object()) continue;
+        const std::string kind = reward.value("kind", std::string());
+        if (kind == "currency" && reward.contains("amount") && reward["amount"].is_number_integer()) {
+            summaries.push_back("+" + std::to_string(reward["amount"].get<std::int64_t>()) + " Gilda");
+        } else if (kind == "item" && reward.contains("id") && reward["id"].is_string()) {
+            std::string id = reward["id"].get<std::string>();
+            const std::size_t separator = id.rfind(':');
+            if (separator != std::string::npos) id.erase(0, separator + 1);
+            if (id.size() > 24) id = id.substr(0, 21) + "...";
+            summaries.push_back(std::to_string(reward.value("count", std::int64_t{1})) + "x " + id);
+        } else if (kind == "weapon" && reward.contains("id") && reward["id"].is_string()) {
+            std::string id = reward["id"].get<std::string>();
+            const std::size_t separator = id.rfind(':');
+            if (separator != std::string::npos) id.erase(0, separator + 1);
+            if (id.size() > 20) id = id.substr(0, 17) + "...";
+            summaries.push_back("Weapon: " + id);
+        } else {
+            summaries.push_back("Reward " + std::to_string(index + 1));
+        }
+    }
+    if (summaries.empty()) return "Rewards: " + std::to_string(rewards.size()) + " entries";
+    std::string summary = summaries.size() == 1 ? "Reward: " : "Rewards: ";
+    for (std::size_t index = 0; index < summaries.size(); ++index) {
+        if (index > 0) summary += " + ";
+        summary += summaries[index];
+    }
+    if (rewards.size() > visible) summary += " + " + std::to_string(rewards.size() - visible) + " more";
+    return summary;
+}
+
+ApiCallResult ManagerSkills(std::string_view owner_id) {
+    return SharedRuntime().Skills(owner_id);
+}
+
+bool ActivateManagerAction(std::string_view owner_id, std::string_view local_id) {
+    std::string qualified_id(owner_id);
+    qualified_id.push_back(':');
+    qualified_id.append(local_id);
+    const auto found = g_actions.find(qualified_id);
+    if (found == g_actions.end() || found->second.owner_id != owner_id) return false;
+    const ManagerUiAction action = found->second;
+    const bool delivered = SharedRuntime().PublishToMod(
+        action.owner_id, "ui.action",
+        {{"id", local_id}, {"qualified_id", action.id}, {"label", action.label},
+         {"description", action.description}});
+    if (delivered) ShowManagerNotice(action.label, 180);
+    return delivered;
+}
+
+bool HandleManagerInput(const ManagerInput &input) {
+    if (!g_state.open) return false;
+
+    if (g_state.native_trust_confirmation) {
+        // The modal's two buttons are stacked and centred; the drawing reports where they are.
+        const auto on_button = [&](int top) {
+            return input.mouse_left && input.mouse_x >= 270 && input.mouse_x < 370 && input.mouse_y >= top &&
+                   input.mouse_y < top + 26;
+        };
+        if (input.cancel || input.mouse_right || on_button(g_trust_cancel_y)) {
+            g_state.native_trust_confirmation = false;
+        } else if (input.confirm || on_button(g_trust_confirm_y)) {
+            ConfirmNativeTrustChange();
+        }
+        return true;
+    }
+
+    const auto mods = SharedRuntime().Mods();
+    const ModRecord *record = ManagerSelectedMod();
+    const int setting_count = record == nullptr ? 0 : static_cast<int>(record->manifest.settings.size());
+    const auto actions = record == nullptr ? std::vector<ManagerUiAction>{} : ManagerDisplayActions(record->id);
+    const int action_count = static_cast<int>(actions.size());
+    const ApiCallResult quest_result = record == nullptr ? ApiCallResult{} : ManagerQuests(record->id);
+    const Json quest_list = quest_result.status == ApiCallStatus::Ok && quest_result.value.is_object()
+                                ? quest_result.value.value("quests", Json::array())
+                                : Json::array();
+    const ApiCallResult skill_result = record == nullptr ? ApiCallResult{} : ManagerSkills(record->id);
+    const Json skill_list = skill_result.status == ApiCallStatus::Ok && skill_result.value.is_object()
+                                ? skill_result.value.value("skills", Json::array())
+                                : Json::array();
+    const bool has_quests = quest_list.is_array() && !quest_list.empty();
+    const bool has_skills = skill_list.is_array() && !skill_list.empty();
+    const auto journal_quests = ManagerJournalQuests();
+    const bool has_journal = !journal_quests.empty();
+    const int skill_count = has_skills ? static_cast<int>(skill_list.size()) : 0;
+    if (g_state.detail_tab == 1 && action_count == 0) g_state.detail_tab = has_quests ? 2 : has_skills ? 3 : 0;
+    if (g_state.detail_tab == 2 && !has_quests) g_state.detail_tab = has_skills ? 3 : action_count > 0 ? 1 : 0;
+    if (g_state.detail_tab == 3 && !has_skills) g_state.detail_tab = has_quests ? 2 : action_count > 0 ? 1 : 0;
+    const bool has_settings = setting_count > 0;
+    const bool has_actions = action_count > 0;
+    if (g_state.detail_tab == 4 && !has_journal) {
+        g_state.detail_tab = FirstDetailTab(has_settings, has_actions, has_quests, has_skills, false);
+    }
+    const bool action_tab = g_state.detail_tab == 1 && has_actions;
+    const bool quest_tab = g_state.detail_tab == 2 && has_quests;
+    const bool skill_tab = g_state.detail_tab == 3 && has_skills;
+    const bool journal_tab = g_state.detail_tab == 4 && has_journal;
+    if (input.cancel || input.mouse_right ||
+        (input.mouse_left && input.mouse_x >= 44 && input.mouse_x < 140 && input.mouse_y >= 422 && input.mouse_y < 449) ||
+        (input.mouse_left && input.mouse_x >= 558 && input.mouse_x < 596 && input.mouse_y >= 76 && input.mouse_y < 111)) {
+        if (g_opened_in_play) {
+            g_opened_in_play = false;
+            g_host_close_request = true;
+            CloseManager();
+        } else if (g_state.settings_focus || g_state.native_trust_focus) {
+            g_state.settings_focus = false;
+            g_state.native_trust_focus = false;
+            g_state.detail_tab = 0;
+            Reconcile();
+        } else {
+            CloseManager();
+        }
+        return true;
+    }
+
+    if (g_state.settings_focus && skill_tab && input.mouse_left) {
+        if(input.mouse_x>=56 && input.mouse_x<592 && input.mouse_y>=128 && input.mouse_y<278) {
+            std::vector<std::string> branches;
+            for(const auto &skill:skill_list) {
+                auto tree=skill.value("tree_title",std::string{});
+                if(std::find(branches.begin(),branches.end(),tree)==branches.end()) branches.push_back(tree);
+            }
+            const int col=std::clamp(int((input.mouse_x-56)/(536/int(branches.size()))),0,int(branches.size())-1);
+            int row=0,target=int((input.mouse_y-128)/50);
+            for(int i=0;i<int(skill_list.size());++i) if(skill_list[i].value("tree_title",std::string{})==branches[col] && row++==target) {g_state.selected_skill=i;break;}
+            Reconcile();
+        }
+        return true;
+    }
+    if (input.mouse_left) {
+        const int journal_row = journal_tab
+                                    ? RowAt(input.mouse_y, 141.0f, 29.0f, kManagerVisibleMods, g_state.first_journal_quest,
+                                            static_cast<int>(journal_quests.size()))
+                                    : -1;
+        if (journal_tab && input.mouse_x >= 48 && input.mouse_x < 246 && journal_row >= 0) {
+            g_state.selected_journal_quest = journal_row;
+            g_state.first_quest_objective = 0;
+            g_state.settings_focus = false;
+            Reconcile();
+            return true;
+        }
+        const int mod_row = journal_tab ? -1 : RowAt(input.mouse_y, 141.0f, 29.0f, kManagerVisibleMods, g_state.first_mod,
+                                                    static_cast<int>(mods.size()));
+        if (!journal_tab && input.mouse_x >= 48 && input.mouse_x < 246 && mod_row >= 0) {
+            g_state.selected_mod = mod_row;
+            g_state.selected_setting = 0;
+            g_state.first_setting = 0;
+            g_state.selected_action = 0;
+            g_state.first_action = 0;
+            g_state.selected_skill = 0;
+            g_state.first_skill = 0;
+            g_state.detail_tab = 0;
+            g_state.settings_focus = false;
+            if (input.mouse_x >= 216 && !mods[static_cast<std::size_t>(mod_row)].manifest.native_library.empty()) {
+                g_state.native_trust_focus = true;
+                RequestNativeTrustConfirmation();
+            } else if (input.mouse_x >= 184) {
+                g_state.native_trust_focus = false;
+                ToggleSelectedMod();
+            }
+            Reconcile();
+            return true;
+        }
+        if (input.mouse_x >= 258 && input.mouse_x < 592) {
+            const float tab_top = journal_tab ? 139.0f : 230.0f;
+            if (input.mouse_y >= tab_top && input.mouse_y < tab_top + 24.0f) {
+                SelectDetailTab(std::clamp(static_cast<int>((input.mouse_x - 263.0f) / 64.0f), 0, 4));
+                return true;
+            }
+            if (journal_tab) {
+                g_state.settings_focus = true;
+                return true;
+            }
+            if (action_tab) {
+                const int action_row = RowAt(input.mouse_y, 260.0f, 24.0f, kManagerVisibleSettings,
+                                             g_state.first_action, action_count);
+                if (action_row >= 0) {
+                    g_state.selected_action = action_row;
+                    g_state.settings_focus = true;
+                    ActivateSelectedAction();
+                    Reconcile();
+                    return true;
+                }
+            } else if (skill_tab) {
+                const int skill_row = RowAt(input.mouse_y, 278.0f, 24.0f, kManagerVisibleSkills,
+                                            g_state.first_skill, skill_count);
+                if (skill_row >= 0) {
+                    g_state.selected_skill = skill_row;
+                    g_state.settings_focus = true;
+                    Reconcile();
+                    return true;
+                }
+            } else if (!quest_tab) {
+                const int setting_row = RowAt(input.mouse_y, 260.0f, 24.0f, kManagerVisibleSettings,
+                                              g_state.first_setting, setting_count);
+                if (setting_row >= 0) {
+                    g_state.selected_setting = setting_row;
+                    g_state.settings_focus = true;
+                    if (input.mouse_x >= 506) StepSelectedSetting(input.mouse_x < 544 ? -1 : 1);
+                    Reconcile();
+                    return true;
+                }
+            }
+        }
+    }
+
+    if (input.wheel != 0.0f) {
+        if (input.mouse_x < 250) {
+            if (journal_tab) MoveJournalQuest(input.wheel > 0.0f ? -1 : 1);
+            else MoveMod(input.wheel > 0.0f ? -1 : 1);
+        } else if (journal_tab) {
+            MoveJournalObjective(input.wheel > 0.0f ? -1 : 1);
+        } else if (action_tab && has_actions) {
+            MoveAction(input.wheel > 0.0f ? -1 : 1);
+        } else if (quest_tab) {
+            MoveQuestObjective(input.wheel > 0.0f ? -1 : 1);
+        } else if (skill_tab) {
+            MoveSkill(input.wheel > 0.0f ? -1 : 1);
+        } else if (has_settings) {
+            g_state.settings_focus = true;
+            MoveSetting(input.wheel > 0.0f ? -1 : 1);
+        }
+        return true;
+    }
+
+    const bool has_native_extension = record != nullptr && !record->manifest.native_library.empty();
+    if (g_state.native_trust_focus && (input.next_focus || input.right)) {
+        g_state.native_trust_focus = false;
+        g_state.settings_focus = has_settings || has_actions || has_quests || has_skills || has_journal;
+        if (g_state.settings_focus) g_state.detail_tab = FirstDetailTab(has_settings, has_actions, has_quests, has_skills, has_journal);
+        return true;
+    }
+    if (input.next_focus || (input.right && !g_state.settings_focus && !g_state.native_trust_focus)) {
+        if (!g_state.settings_focus && has_native_extension && !journal_tab) {
+            g_state.native_trust_focus = true;
+        } else if (!g_state.settings_focus && (has_settings || has_actions || has_quests || has_skills || has_journal)) {
+            g_state.settings_focus = true;
+            if (!journal_tab) g_state.detail_tab = FirstDetailTab(has_settings, has_actions, has_quests, has_skills, has_journal);
+        } else if (g_state.settings_focus) {
+            g_state.detail_tab = AdjacentDetailTab(g_state.detail_tab, 1, has_settings, has_actions, has_quests, has_skills, has_journal);
+        }
+        return true;
+    }
+    if (input.previous_focus || (input.left && g_state.native_trust_focus)) {
+        if (g_state.native_trust_focus) {
+            g_state.native_trust_focus = false;
+        } else if (g_state.settings_focus) {
+            g_state.detail_tab = AdjacentDetailTab(g_state.detail_tab, -1, has_settings, has_actions, has_quests, has_skills, has_journal);
+        }
+        return true;
+    }
+    if (input.up) {
+        if (journal_tab) {
+            if (g_state.settings_focus) MoveJournalObjective(-1);
+            else MoveJournalQuest(-1);
+        } else if (g_state.settings_focus && quest_tab) MoveQuestObjective(-1);
+        else if (g_state.settings_focus && action_tab) MoveAction(-1);
+        else if (g_state.settings_focus && skill_tab) MoveSkill(-1);
+        else if (g_state.settings_focus) MoveSetting(-1);
+        else MoveMod(-1);
+        return true;
+    }
+    if (input.down) {
+        if (journal_tab) {
+            if (g_state.settings_focus) MoveJournalObjective(1);
+            else MoveJournalQuest(1);
+        } else if (g_state.settings_focus && quest_tab) MoveQuestObjective(1);
+        else if (g_state.settings_focus && action_tab) MoveAction(1);
+        else if (g_state.settings_focus && skill_tab) MoveSkill(1);
+        else if (g_state.settings_focus) MoveSetting(1);
+        else MoveMod(1);
+        return true;
+    }
+    if (g_state.settings_focus && skill_tab && (input.left || input.right)) {
+        const int step=input.left?-1:1;
+        const auto current=skill_list[g_state.selected_skill].value("tree_title",std::string{});
+        for(int next=g_state.selected_skill+step;next>=0 && next<int(skill_list.size());next+=step)
+            if(skill_list[next].value("tree_title",std::string{})!=current){g_state.selected_skill=next;break;}
+        Reconcile();return true;
+    }
+    if (input.left || input.right) {
+        if (journal_tab) MoveJournalQuest(input.left ? -1 : 1);
+        else if (g_state.settings_focus && quest_tab) MoveQuest(input.left ? -1 : 1);
+        else if (g_state.settings_focus && !action_tab && !skill_tab) StepSelectedSetting(input.left ? -1 : 1);
+        return true;
+    }
+    if (input.confirm) {
+        if (g_state.native_trust_focus) RequestNativeTrustConfirmation();
+        else if (g_state.settings_focus && action_tab) ActivateSelectedAction();
+        else if (g_state.settings_focus && skill_tab) {
+            const Json &skill = skill_list[static_cast<std::size_t>(g_state.selected_skill)];
+            const std::string id = skill.value("id", "");
+            if (id.empty() || !SharedRuntime().PublishToMod(record->id, "skills.train_requested", {{"id", id}})) {
+                Notice("This skill tree is not active");
+            }
+            Reconcile();
+        }
+        else if (journal_tab) return true;
+        else if (g_state.settings_focus && !skill_tab) StepSelectedSetting(1);
+        else ToggleSelectedMod();
+        return true;
+    }
+    return true;
+}
+
+} // namespace moonmod
diff --git a/port/src/moonmod/manifest.cpp b/port/src/moonmod/manifest.cpp
new file mode 100644
index 000000000..0d0d56e40
--- /dev/null
+++ b/port/src/moonmod/manifest.cpp
@@ -0,0 +1,434 @@
+#include "moonmod/manifest.hpp"
+
+#include "moonmod/api.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <format>
+#include <fstream>
+#include <initializer_list>
+#include <limits>
+#include <regex>
+#include <set>
+#include <string_view>
+
+namespace moonmod {
+namespace {
+
+constexpr std::size_t kManifestLimit = 256 * 1024;
+
+bool IsString(const Json &value, std::size_t limit) {
+    return value.is_string() && value.get_ref<const std::string &>().size() <= limit;
+}
+
+bool ReadString(const Json &object, const char *key, std::string &out, std::size_t limit, bool required,
+                std::string &error) {
+    const auto found = object.find(key);
+    if (found == object.end()) {
+        if (!required) {
+            return true;
+        }
+        error = std::string("missing required field '") + key + "'";
+        return false;
+    }
+    if (!IsString(*found, limit)) {
+        error = std::string("field '") + key + "' must be a string no longer than " + std::to_string(limit) + " bytes";
+        return false;
+    }
+    out = found->get<std::string>();
+    if (required && out.empty()) {
+        error = std::string("field '") + key + "' cannot be empty";
+        return false;
+    }
+    return true;
+}
+
+bool ReadStringList(const Json &object, const char *key, std::vector<std::string> &out, std::size_t max_count,
+                    bool required, std::string &error) {
+    const auto found = object.find(key);
+    if (found == object.end()) {
+        if (!required) {
+            return true;
+        }
+        error = std::string("missing required field '") + key + "'";
+        return false;
+    }
+    if (!found->is_array() || found->size() > max_count) {
+        error = std::string("field '") + key + "' must be an array with at most " + std::to_string(max_count) + " entries";
+        return false;
+    }
+    std::set<std::string> unique;
+    for (const Json &entry : *found) {
+        if (!IsString(entry, 96)) {
+            error = std::string("field '") + key + "' contains a non-string or oversized value";
+            return false;
+        }
+        const std::string value = entry.get<std::string>();
+        if (value.empty() || !unique.insert(value).second) {
+            error = std::string("field '") + key + "' contains an empty or duplicate value";
+            return false;
+        }
+        out.push_back(value);
+    }
+    return true;
+}
+
+bool RejectUnknownFields(const Json &object, std::initializer_list<std::string_view> allowed, std::string &error) {
+    for (auto item = object.begin(); item != object.end(); ++item) {
+        if (std::ranges::find(allowed, item.key()) == allowed.end()) {
+            error = "unknown field '" + item.key() + "'";
+            return false;
+        }
+    }
+    return true;
+}
+
+std::optional<SettingType> ParseSettingType(std::string_view value) {
+    if (value == "boolean") return SettingType::Boolean;
+    if (value == "integer") return SettingType::Integer;
+    if (value == "number") return SettingType::Number;
+    if (value == "string") return SettingType::String;
+    if (value == "choice") return SettingType::Choice;
+    return std::nullopt;
+}
+
+bool ValidSettingDefault(const SettingDefinition &setting) {
+    switch (setting.type) {
+        case SettingType::Boolean:
+            return setting.default_value.is_boolean();
+        case SettingType::Integer:
+            return setting.default_value.is_number_integer() && setting.minimum <= setting.maximum && setting.step > 0.0;
+        case SettingType::Number:
+            return setting.default_value.is_number() && std::isfinite(setting.default_value.get<double>()) &&
+                   setting.minimum <= setting.maximum && setting.step > 0.0;
+        case SettingType::String:
+            return setting.default_value.is_string() && setting.default_value.get_ref<const std::string &>().size() <= 256;
+        case SettingType::Choice:
+            return setting.default_value.is_string() &&
+                   std::ranges::find(setting.choices, setting.default_value.get<std::string>()) != setting.choices.end();
+    }
+    return false;
+}
+
+bool ReadSettings(const Json &object, std::vector<SettingDefinition> &settings, std::string &error) {
+    const auto found = object.find("settings");
+    if (found == object.end()) {
+        return true;
+    }
+    if (!found->is_array() || found->size() > 128) {
+        error = "field 'settings' must be an array with at most 128 entries";
+        return false;
+    }
+    std::set<std::string> ids;
+    for (const Json &value : *found) {
+        if (!value.is_object()) {
+            error = "each settings entry must be an object";
+            return false;
+        }
+        if (!RejectUnknownFields(value, {"id", "name", "description", "type", "default", "min", "max", "step", "choices"}, error)) {
+            return false;
+        }
+        SettingDefinition setting;
+        if (!ReadString(value, "id", setting.id, 64, true, error) ||
+            !ReadString(value, "name", setting.name, 96, true, error) ||
+            !ReadString(value, "description", setting.description, 512, false, error)) {
+            return false;
+        }
+        static const std::regex kSettingIdPattern("[a-z][a-z0-9._-]{0,63}");
+        if (!std::regex_match(setting.id, kSettingIdPattern) || !ids.insert(setting.id).second) {
+            error = "setting ids must be unique lowercase ids beginning with a letter";
+            return false;
+        }
+        std::string type;
+        if (!ReadString(value, "type", type, 16, true, error)) {
+            return false;
+        }
+        const auto parsed = ParseSettingType(type);
+        if (!parsed) {
+            error = "setting '" + setting.id + "' has an unknown type";
+            return false;
+        }
+        setting.type = *parsed;
+        const auto default_value = value.find("default");
+        if (default_value == value.end()) {
+            error = "setting '" + setting.id + "' is missing its default";
+            return false;
+        }
+        setting.default_value = *default_value;
+        const bool integer = setting.type == SettingType::Integer;
+        const double low_default = integer ? static_cast<double>(std::numeric_limits<std::int64_t>::min())
+                                           : std::numeric_limits<double>::lowest();
+        const double high_default = integer
+                                        ? std::nextafter(static_cast<double>(std::numeric_limits<std::int64_t>::max()), 0.0)
+                                        : std::numeric_limits<double>::max();
+        auto read_number = [&](const char *key, double &out, double fallback) {
+            const auto number = value.find(key);
+            out = fallback;
+            if (number == value.end()) return true;
+            if (!number->is_number() || !std::isfinite(number->get<double>())) return false;
+            out = number->get<double>();
+            return true;
+        };
+        if (!read_number("min", setting.minimum, low_default) || !read_number("max", setting.maximum, high_default) ||
+            !read_number("step", setting.step, 1.0)) {
+            error = "setting '" + setting.id + "' has a non-finite numeric bound";
+            return false;
+        }
+        if (integer && (std::trunc(setting.minimum) != setting.minimum ||
+                        std::trunc(setting.maximum) != setting.maximum ||
+                        static_cast<long double>(setting.minimum) <
+                            static_cast<long double>(std::numeric_limits<std::int64_t>::min()) ||
+                        static_cast<long double>(setting.maximum) >
+                            static_cast<long double>(std::numeric_limits<std::int64_t>::max()))) {
+            error = "integer setting '" + setting.id + "' bounds must be integral and fit a signed 64-bit value";
+            return false;
+        }
+        if (setting.type == SettingType::Choice) {
+            if (!ReadStringList(value, "choices", setting.choices, 32, true, error) || setting.choices.empty()) {
+                if (error.empty()) error = "choice setting '" + setting.id + "' must have at least one choice";
+                return false;
+            }
+        }
+        if (!ValidSettingDefault(setting)) {
+            error = "setting '" + setting.id + "' has a default that does not match its type or bounds";
+            return false;
+        }
+        if ((setting.type == SettingType::Integer || setting.type == SettingType::Number) &&
+            (setting.default_value.get<double>() < setting.minimum || setting.default_value.get<double>() > setting.maximum)) {
+            error = "setting '" + setting.id + "' default is outside its range";
+            return false;
+        }
+        settings.push_back(std::move(setting));
+    }
+    return true;
+}
+
+bool SafeRelativeEntry(std::string_view entry) {
+    if (entry.empty() || entry.size() > 128 || entry.find(':') != std::string_view::npos ||
+        entry.find('\\') != std::string_view::npos || entry.front() == '/' || entry.front() == '.') {
+        return false;
+    }
+    const std::filesystem::path path(entry);
+    if (path.is_absolute()) return false;
+    for (const auto &part : path) {
+        if (part == "." || part == "..") return false;
+    }
+    return path.extension() == ".lua";
+}
+
+bool SafeRelativeNativeLibrary(std::string_view entry) {
+    if (entry.empty() || entry.size() > 192 || entry.find(':') != std::string_view::npos ||
+        entry.find('\\') != std::string_view::npos || entry.front() == '/' || entry.front() == '.') {
+        return false;
+    }
+    const std::filesystem::path path(entry);
+    if (path.is_absolute()) return false;
+    for (const auto &part : path) {
+        if (part == "." || part == "..") return false;
+    }
+    const auto extension = path.extension().string();
+    return extension == ".dll" || extension == ".so" || extension == ".dylib";
+}
+
+bool IsWithin(const std::filesystem::path &root, const std::filesystem::path &path) {
+    const auto relative = path.lexically_relative(root);
+    if (relative.empty() || relative.is_absolute()) return false;
+    const auto first = relative.begin();
+    return first != relative.end() && *first != "..";
+}
+
+} // namespace
+
+bool IsValidModId(std::string_view id) {
+    if (id.size() < 3 || id.size() > 64) return false;
+    if (!(id.front() >= 'a' && id.front() <= 'z') && !(id.front() >= '0' && id.front() <= '9')) return false;
+    return std::ranges::all_of(id, [](char c) {
+        return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
+    });
+}
+
+std::optional<ModManifest> ReadManifest(const std::filesystem::path &package_root, std::string &error) {
+    error.clear();
+    std::error_code ec;
+    const auto canonical_root = std::filesystem::canonical(package_root, ec);
+    if (ec || !std::filesystem::is_directory(canonical_root, ec) || ec) {
+        error = "package directory is missing or unreadable";
+        return std::nullopt;
+    }
+    const auto manifest_file = std::filesystem::canonical(canonical_root / "mod.json", ec);
+    if (ec || !IsWithin(canonical_root, manifest_file) || !std::filesystem::is_regular_file(manifest_file, ec) || ec) {
+        error = "mod.json is missing";
+        return std::nullopt;
+    }
+    const auto size = std::filesystem::file_size(manifest_file, ec);
+    if (ec || size == 0 || size > kManifestLimit) {
+        error = "mod.json is empty, unreadable, or larger than 256 KiB";
+        return std::nullopt;
+    }
+    Json document;
+    try {
+        std::ifstream input(manifest_file, std::ios::binary);
+        if (!input) {
+            error = "mod.json could not be opened";
+            return std::nullopt;
+        }
+        input >> document;
+    } catch (const std::exception &exception) {
+        error = std::string("mod.json could not be parsed: ") + exception.what();
+        return std::nullopt;
+    }
+    if (!document.is_object()) {
+        error = "mod.json must contain one JSON object";
+        return std::nullopt;
+    }
+    if (!RejectUnknownFields(document, {"schema_version", "id", "name", "version", "author", "description",
+                                        "framework_api", "games", "entry", "dependencies", "optional_dependencies", "load_after",
+                                        "load_before", "permissions", "settings", "native_extension"}, error)) {
+        return std::nullopt;
+    }
+
+    ModManifest manifest;
+    manifest.package_root = canonical_root;
+    const auto schema = document.find("schema_version");
+    if (schema == document.end() || !schema->is_number_integer() || schema->get<int>() != 1) {
+        error = "schema_version must be 1";
+        return std::nullopt;
+    }
+    if (!ReadString(document, "id", manifest.id, 64, true, error) ||
+        !ReadString(document, "name", manifest.name, 96, true, error) ||
+        !ReadString(document, "version", manifest.version, 64, true, error) ||
+        !ReadString(document, "author", manifest.author, 96, false, error) ||
+        !ReadString(document, "description", manifest.description, 1024, false, error) ||
+        !ReadString(document, "entry", manifest.entry, 128, true, error)) {
+        return std::nullopt;
+    }
+    if (!IsValidModId(manifest.id)) {
+        error = "id must be 3-64 lowercase letters, digits, dots, underscores, or hyphens";
+        return std::nullopt;
+    }
+    static const std::regex kSemverPattern("[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?");
+    if (!std::regex_match(manifest.version, kSemverPattern)) {
+        error = "version must use semantic version form MAJOR.MINOR.PATCH";
+        return std::nullopt;
+    }
+    if (!SafeRelativeEntry(manifest.entry)) {
+        error = "entry must be a relative .lua file inside the package";
+        return std::nullopt;
+    }
+    const auto api = document.find("framework_api");
+    if (api == document.end() || !api->is_number_integer() || api->get<int>() < 1) {
+        error = "framework_api must be a positive integer";
+        return std::nullopt;
+    }
+    manifest.framework_api = api->get<int>();
+    if (!ReadStringList(document, "games", manifest.games, 2, true, error) ||
+        !ReadStringList(document, "dependencies", manifest.dependencies, 64, false, error) ||
+        !ReadStringList(document, "optional_dependencies", manifest.optional_dependencies, 64, false, error) ||
+        !ReadStringList(document, "load_after", manifest.load_after, 64, false, error) ||
+        !ReadStringList(document, "load_before", manifest.load_before, 64, false, error) ||
+        !ReadStringList(document, "permissions", manifest.permissions, 64, false, error) ||
+        !ReadSettings(document, manifest.settings, error)) {
+        return std::nullopt;
+    }
+    if (const auto native = document.find("native_extension"); native != document.end()) {
+        if (!native->is_object() || !RejectUnknownFields(*native, {"library"}, error)) {
+            if (error.empty()) error = "native_extension must be an object containing a library path";
+            return std::nullopt;
+        }
+        std::string library;
+        if (!ReadString(*native, "library", library, 192, true, error) || !SafeRelativeNativeLibrary(library)) {
+            if (error.empty()) error = "native_extension.library must be a safe relative .dll, .so, or .dylib path";
+            return std::nullopt;
+        }
+        if (std::ranges::find(manifest.permissions, "native.extension") == manifest.permissions.end()) {
+            error = "native_extension requires the native.extension manifest permission";
+            return std::nullopt;
+        }
+        std::error_code native_error;
+        manifest.native_library = std::filesystem::canonical(canonical_root / std::filesystem::path(library), native_error);
+        if (native_error || !IsWithin(canonical_root, manifest.native_library) ||
+            !std::filesystem::is_regular_file(manifest.native_library, native_error) || native_error) {
+            error = "native extension library is missing or escapes the package";
+            return std::nullopt;
+        }
+        const auto native_size = std::filesystem::file_size(manifest.native_library, native_error);
+        if (native_error || native_size == 0 || native_size > 256 * 1024 * 1024) {
+            error = "native extension library is empty, unreadable, or larger than 256 MiB";
+            return std::nullopt;
+        }
+    } else if (std::ranges::find(manifest.permissions, "native.extension") != manifest.permissions.end()) {
+        error = "native.extension permission requires a native_extension library declaration";
+        return std::nullopt;
+    }
+    for (const std::string &permission : manifest.permissions) {
+        if (!IsKnownPermission(permission)) {
+            error = "unsupported permission '" + permission + "' for framework API major 1";
+            return std::nullopt;
+        }
+    }
+    if (manifest.games.empty()) {
+        error = "games must contain at least one supported game id";
+        return std::nullopt;
+    }
+    for (const std::string &game : manifest.games) {
+        if (game != "chronicle" && game != "chronicle-two") {
+            error = "games may contain only 'chronicle' and 'chronicle-two'";
+            return std::nullopt;
+        }
+    }
+    for (const std::string &dependency : manifest.optional_dependencies) {
+        if (std::ranges::find(manifest.dependencies, dependency) != manifest.dependencies.end()) {
+            error = "optional dependency '" + dependency + "' is also declared as a required dependency";
+            return std::nullopt;
+        }
+    }
+    for (const auto *ids : {&manifest.dependencies, &manifest.optional_dependencies, &manifest.load_after, &manifest.load_before}) {
+        for (const std::string &id : *ids) {
+            if (!IsValidModId(id)) {
+                error = "dependency and load-order references must use valid mod ids";
+                return std::nullopt;
+            }
+        }
+    }
+    manifest.entry_file = std::filesystem::canonical(canonical_root / std::filesystem::path(manifest.entry), ec);
+    if (ec || !IsWithin(canonical_root, manifest.entry_file) || !std::filesystem::is_regular_file(manifest.entry_file, ec) || ec) {
+        error = "entry script is missing";
+        return std::nullopt;
+    }
+    const auto entry_size = std::filesystem::file_size(manifest.entry_file, ec);
+    if (ec || entry_size == 0 || entry_size > 1024 * 1024) {
+        error = "entry script is empty, unreadable, or larger than 1 MiB";
+        return std::nullopt;
+    }
+    return manifest;
+}
+
+std::string SettingTypeName(SettingType type) {
+    switch (type) {
+        case SettingType::Boolean: return "boolean";
+        case SettingType::Integer: return "integer";
+        case SettingType::Number: return "number";
+        case SettingType::String: return "string";
+        case SettingType::Choice: return "choice";
+    }
+    return "unknown";
+}
+
+std::string SettingValueText(const SettingDefinition &setting, const Json &value) {
+    switch (setting.type) {
+        case SettingType::Boolean:
+            return value.is_boolean() && value.get<bool>() ? "On" : "Off";
+        case SettingType::Integer:
+            return value.is_number_integer() ? std::to_string(value.get<std::int64_t>()) : setting.default_value.dump();
+        case SettingType::Number:
+            return value.is_number() ? std::format("{:.6g}", value.get<double>()) : setting.default_value.dump();
+        case SettingType::String:
+            return value.is_string() ? value.get<std::string>() : setting.default_value.get<std::string>();
+        case SettingType::Choice:
+            return value.is_string() ? value.get<std::string>() : setting.default_value.get<std::string>();
+    }
+    return {};
+}
+
+} // namespace moonmod
diff --git a/port/src/moonmod/mapselect_moonmod.cpp b/port/src/moonmod/mapselect_moonmod.cpp
new file mode 100644
index 000000000..1b006218c
--- /dev/null
+++ b/port/src/moonmod/mapselect_moonmod.cpp
@@ -0,0 +1,79 @@
+// Mod map identities appended after the native map catalog (moved out of ps2/src/mapselect.cpp).
+
+#include "common.h"
+
+#include <cstring>
+
+#include "mapselect.hpp"
+
+extern int            PortMapNameNum asm("MapSelect_MapNameNum");
+extern MAP_NAME_INFO *PortMapName asm("MapSelect_MapName");
+
+namespace {
+constexpr int MOONMOD_MAP_NAME_MAX = 64;
+struct MoonModMapNameInfo {
+    MAP_NAME_INFO info;
+    char name[16];
+    char title[128];
+};
+MoonModMapNameInfo MoonModMapNames[MOONMOD_MAP_NAME_MAX];
+int MoonModMapNameNum;
+} // namespace
+
+MAP_NAME_INFO *GetMoonModMapNameInfo(int index) {
+    if (index < 0 || index >= MoonModMapNameNum) {
+        return NULL;
+    }
+    return &MoonModMapNames[index].info;
+}
+
+int GetMapNameCount() {
+    const int maximum = MAP_NAME_BUFF_SIZE * 16 / static_cast<int>(sizeof(MAP_NAME_INFO)) - 1;
+    if (PortMapNameNum < 0 || PortMapNameNum > maximum) return 0;
+    if (PortMapNameNum + MoonModMapNameNum > maximum + MOONMOD_MAP_NAME_MAX) return 0;
+    return PortMapNameNum + MoonModMapNameNum;
+}
+
+int RegisterMoonModMapName(const char *name, const char *title) {
+    if (name == NULL || title == NULL) return -1;
+    const int name_length = strlen(name);
+    const int title_length = strlen(title);
+    if (name_length < 3 || name_length > 15 || title_length < 1 || title_length >= 128) return -1;
+    for (int index = 0; index < name_length; ++index) {
+        const unsigned char character = static_cast<unsigned char>(name[index]);
+        const bool alpha_numeric = (character >= 'a' && character <= 'z') ||
+                                  (character >= '0' && character <= '9');
+        if (!alpha_numeric && character != '_' && character != '-') return -1;
+    }
+    for (int index = 0; index < MoonModMapNameNum; ++index) {
+        MoonModMapNameInfo &entry = MoonModMapNames[index];
+        if (strcmp(entry.name, name) != 0) continue;
+        return strcmp(entry.title, title) == 0 ? PortMapNameNum + index : -1;
+    }
+    for (int index = 0; index < PortMapNameNum; ++index) {
+        if (PortMapName[index].name != NULL && strcmp(PortMapName[index].name, name) == 0) return -1;
+    }
+    if (MoonModMapNameNum >= MOONMOD_MAP_NAME_MAX || GetMapNameCount() <= 0) return -1;
+
+    MoonModMapNameInfo &entry = MoonModMapNames[MoonModMapNameNum];
+    memset(&entry, 0, sizeof(entry));
+    strcpy(entry.name, name);
+    strcpy(entry.title, title);
+    entry.info.name = entry.name;
+    entry.info.title = entry.title;
+    entry.info.add_path = NULL;
+    entry.info.type = MAP_TYPE_INTERIOR;
+    entry.info.sel_type = MAP_SEL_SPECIAL;
+    entry.info.snd_data_id = -1;
+    entry.info.area_no = -1;
+    return PortMapNameNum + MoonModMapNameNum++;
+}
+
+int IsMoonModMapName(int map_no) {
+    return map_no >= PortMapNameNum && map_no - PortMapNameNum >= 0 && map_no - PortMapNameNum < MoonModMapNameNum;
+}
+
+void ResetMoonModMapNamesForTests() {
+    memset(MoonModMapNames, 0, sizeof(MoonModMapNames));
+    MoonModMapNameNum = 0;
+}
