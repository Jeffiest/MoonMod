diff --git a/port/src/texture_source.cpp b/port/src/texture_source.cpp
index 747321e29..8548f94b9 100644
--- a/port/src/texture_source.cpp
+++ b/port/src/texture_source.cpp
@@ -1,6 +1,8 @@
 #include "texture_source.hpp"
 
 #include <cstdint>
+#include <algorithm>
+#include <string_view>
 #include <unordered_map>
 
 namespace {
@@ -9,14 +11,56 @@ struct SourceRange {
     std::size_t size = 0;
 };
 std::unordered_map<const void *, SourceRange> sources;
+std::unordered_map<std::string, std::string> source_aliases;
+
+std::string Normalize(std::string value) {
+    std::replace(value.begin(), value.end(), '\\', '/');
+    std::transform(value.begin(), value.end(), value.begin(), [](unsigned char character) {
+        return static_cast<char>(character >= 'A' && character <= 'Z' ? character + ('a' - 'A') : character);
+    });
+    while (!value.empty() && value.front() == '/') value.erase(value.begin());
+    return value;
+}
+
+std::string ResolveAlias(std::string source) {
+    const std::string normalized = Normalize(source);
+    const std::string *best_source = nullptr;
+    const std::string *best_target = nullptr;
+    for (const auto &[alias, target] : source_aliases) {
+        if (normalized != alias &&
+            !(normalized.size() > alias.size() && normalized.starts_with(alias) && normalized[alias.size()] == '/')) {
+            continue;
+        }
+        if (best_source == nullptr || alias.size() > best_source->size()) {
+            best_source = &alias;
+            best_target = &target;
+        }
+    }
+    if (best_source == nullptr) return source;
+    return *best_target + normalized.substr(best_source->size());
+}
 }
 
 void TextureSourceRegister(const void *buffer, std::string source, std::size_t size) {
     if (buffer != nullptr) {
-        sources.insert_or_assign(buffer, SourceRange{std::move(source), size});
+        sources.insert_or_assign(buffer, SourceRange{ResolveAlias(std::move(source)), size});
     }
 }
 
+bool TextureSourceAliasRegister(std::string source, std::string catalog_source) {
+    source = Normalize(std::move(source));
+    catalog_source = Normalize(std::move(catalog_source));
+    if (source.empty() || catalog_source.empty() || source == catalog_source) return false;
+    const auto existing = source_aliases.find(source);
+    if (existing != source_aliases.end()) return existing->second == catalog_source;
+    source_aliases.emplace(std::move(source), std::move(catalog_source));
+    return true;
+}
+
+std::string TextureSourceResolveAlias(std::string source) { return ResolveAlias(std::move(source)); }
+
+void TextureSourceAliasesClear() { source_aliases.clear(); }
+
 void TextureSourceForget(const void *buffer) { sources.erase(buffer); }
 
 void TextureSourceClear() { sources.clear(); }
