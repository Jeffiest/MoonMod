+              moonmod::ApiCallStatus::InvalidArgument);
+    EXPECT_EQ(config.api_handler("test.moonmod.dungeon-probe", *layout_operation,
+                                 moonmod::Json::array({moonmod::Json{{"rooms", 12}, {"room_min", 5}, {"room_max", 3}}})).status,
