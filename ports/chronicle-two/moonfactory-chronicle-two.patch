+    ASSERT_EQ(quests.status, moonmod::ApiCallStatus::Ok) << quests.message;
+    ASSERT_EQ(quests.value.at("quests").size(), 3u);
+    EXPECT_TRUE(std::ranges::all_of(quests.value.at("quests"), [](const moonmod::Json &quest) {
