+static PROGRESSIVE: std::sync::Mutex<Option<std::sync::Arc<core::progressive::Session>>> =
+    std::sync::Mutex::new(None);
+
+fn progressive_session() -> Result<std::sync::Arc<core::progressive::Session>, core::CoreError> {
+    PROGRESSIVE
